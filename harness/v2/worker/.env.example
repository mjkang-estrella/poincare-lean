# Pi is the primary Job executor. These settings are only for endpoint health,
# deterministic snapshots, and an explicitly selected one-shot fallback.
# Service identity is accepted only through the environment. Never commit a
# live private endpoint or token.
LEANSTRAL_BASE_URL=http://LEANSTRAL_PRIVATE_ENDPOINT:8000/v1
LEANSTRAL_MODEL=leanstral-1.5
# Required by bound snapshot/run. Pin the exact revision recorded in the Job.
LEANSTRAL_MODEL_REVISION=PINNED_WEIGHT_OR_SERVING_REVISION

# Optional. The worker sends it as Bearer auth and records only <redacted>.
# LEANSTRAL_API_KEY=

# One run deadline is also capped by the Task budget and live lease expiry.
# Sampling always comes from the immutable Job, not this environment or CLI.
LEANSTRAL_TIMEOUT_SECONDS=300
