{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poincare.local/schemas/task.schema.json",
  "title": "Poincare Harness Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "status",
    "base_commit",
    "objective",
    "scope",
    "context",
    "acceptance",
    "stop_conditions",
    "budget"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["proposed", "ready", "active", "accepted", "blocked", "superseded"]
    },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "statement", "deliverables"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "frozen_lean_type": { "type": "string" },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "symbols", "depends_on"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "forbidden_added_tokens"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "required_declarations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_added_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "wall_clock_minutes", "max_output_tokens", "disk_mb"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "wall_clock_minutes": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "disk_mb": { "type": "integer", "minimum": 1 }
      }
    },
    "supersedes": { "type": "string" },
    "accepted_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "accepted" } },
        "required": ["status"]
      },
      "then": { "required": ["accepted_commit"] }
    }
  ]
}
