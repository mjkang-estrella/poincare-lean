# Copy this file to .env on mj-zima, then replace every placeholder.
# Keep API keys out of this file. The current private vLLM endpoint does not
# require one; if that changes, add secret-file support before deployment.

POINCARE_REPO_ROOT=/srv/projects/poincare
POINCARE_WORKTREE_ROOT=/srv/projects/poincare-worktrees
POINCARE_CODEX_BIN=/home/your-user/.local/bin/codex
# Deployment authority never resolves Git or tmux through PATH. Pin canonical,
# non-symlinked system executables; preflight records and rechecks their bytes.
POINCARE_GIT_BIN=/usr/bin/git
POINCARE_TMUX_BIN=/usr/bin/tmux
POINCARE_PI_INSTALL_MANIFEST=/srv/data/poincare-harness/pi-attestation/pi-install.json
POINCARE_PI_DEPENDENCY_GRAPH=/srv/data/poincare-harness/pi-attestation/npm-ls.json
POINCARE_PI_LAKE_CACHE_ROOT=/srv/data/poincare-harness/lean-cache
POINCARE_PI_TOOLCHAIN_ROOT=/home/your-user/.elan/toolchains/leanprover--lean4---v4.30.0-rc2
POINCARE_EXTRA_PATH=/home/your-user/.elan/bin:/home/your-user/.local/bin:/usr/local/bin:/usr/bin:/bin
POINCARE_INTEGRATION_BRANCH=main

# Runtime endpoint metadata belongs only in the uncommitted .env.
POINCARE_LEANSTRAL_BASE_URL=http://private-host.example.invalid:8600/v1
POINCARE_LEANSTRAL_SERVED_MODEL=replace-with-served-model-id
POINCARE_LEANSTRAL_ARTIFACT=mistralai/Leanstral-1.5-119B-A6B
POINCARE_LEANSTRAL_REVISION=replace-with-40-character-git-revision

# The orchestrator may use fewer workers when leases, CPU, disk, or the model
# endpoint are constrained. The launcher rejects values above four.
POINCARE_MAX_LEANSTRAL_JOBS=1

# A failed Codex cycle is preserved and retried after this cooldown. The
# mj-zima's evidence-producer interval is fixed at exactly 10,800 seconds by
# heartbeat-loop.sh. This Mac thread reports deployment once and ends; it can
# inspect the durable host evidence later when the user asks.
POINCARE_CYCLE_COOLDOWN_SECONDS=300
POINCARE_CODEX_CYCLE_TIMEOUT_SECONDS=14400
POINCARE_COMPLETION_GATE_TIMEOUT_SECONDS=21600
POINCARE_EXACT_PROBE_TIMEOUT_SECONDS=300

# Leave empty to use the authenticated Codex default model. The reasoning
# effort is still pinned explicitly for reproducibility.
POINCARE_CODEX_MODEL=
POINCARE_CODEX_REASONING_EFFORT=xhigh

# Fail launch if less than this much space remains on the repository volume.
POINCARE_MIN_FREE_GIB=20
