        noLocalCollapsingContradictionSetupPayload}
    {hamiltonCompactnessPayload :
      HamiltonCompactnessPayload collapsedBallBlowupPayload}
    {limitExtractionPayload :
      AncientKappaSolutionLimitExtractionPayload
        hamiltonCompactnessPayload}
