/--
Concrete Hamilton compactness data for the collapsed-ball blowup sequence.

The payload is tied to the accepted collapsed-ball blowup payload. It records a
subsequence of rescaled pointed flows, the limit model, convergence-error
control on test data, and uniform compactness bounds absorbing the blowup
envelope.
-/
structure HamiltonCompactnessPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {reducedVolumeNonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    {kappaNoncollapsingFromReducedVolumePayload :
      PerelmanKappaNoncollapsingFromReducedVolumePayload
        reducedVolumeNonincreasingPayload}
    {noLocalCollapsingContradictionSetupPayload :
      PerelmanNoLocalCollapsingContradictionSetupPayload
        kappaNoncollapsingFromReducedVolumePayload}
    (collapsedBallBlowupPayload :
      PerelmanCollapsedBallBlowupPayload
        noLocalCollapsingContradictionSetupPayload) : Type (u + 1) where
  /-- Index domain for the compactness subsequence. -/
  compactnessSubsequenceDomain : Type u
  /-- Distinguished subsequence index. -/
  baseCompactnessIndex : compactnessSubsequenceDomain
  /-- Map from compactness subsequence indices to blowup indices. -/
  subsequenceToBlowupIndex :
    compactnessSubsequenceDomain →
      collapsedBallBlowupPayload.blowupIndexDomain
  /-- Rescaled pointed flow along the compactness subsequence. -/
  compactnessFlowAtIndex :
    compactnessSubsequenceDomain →
      collapsedBallBlowupPayload.rescaledFlowModel
  /-- The compactness subsequence agrees with the collapsed-ball rescaled flows. -/
  compactnessFlowAtIndex_eq_rescaledFlowAtIndex :
    ∀ index,
      compactnessFlowAtIndex index =
        collapsedBallBlowupPayload.rescaledFlowAtIndex
          (subsequenceToBlowupIndex index)
  /-- Limit pointed flow model produced by Hamilton compactness. -/
  compactnessLimitFlowModel : collapsedBallBlowupPayload.rescaledFlowModel
  /-- The compactness limit agrees with the collapsed-ball pointed limit model. -/
  compactnessLimitFlowModel_eq_pointedLimit :
    compactnessLimitFlowModel =
      collapsedBallBlowupPayload.pointedLimitFlowModel
  /-- Test domain used to state subsequential pointed convergence. -/
  compactnessTestDomain : Type u
  /-- Map from compactness tests to the collapsed-ball pointed-convergence tests. -/
  compactnessTestToPointedConvergenceTest :
    compactnessTestDomain →
      collapsedBallBlowupPayload.pointedConvergenceTestDomain
  /-- Convergence error along the compactness subsequence. -/
  compactnessConvergenceError :
    compactnessSubsequenceDomain → compactnessTestDomain → ℝ
  /-- Compactness convergence errors agree with the blowup convergence errors. -/
  compactnessConvergenceError_eq_pointedConvergenceError :
    ∀ index test,
      compactnessConvergenceError index test =
        collapsedBallBlowupPayload.pointedConvergenceError
          (subsequenceToBlowupIndex index)
          (compactnessTestToPointedConvergenceTest test)
  /-- Envelope controlling Hamilton compactness convergence errors. -/
  compactnessConvergenceEnvelope : ℝ
  /-- The compactness convergence envelope is nonnegative. -/
  compactnessConvergenceEnvelopeNonnegative :
    0 ≤ compactnessConvergenceEnvelope
  /-- Compactness convergence errors are controlled by the envelope. -/
  compactnessConvergenceError_le_envelope :
    ∀ index test,
      compactnessConvergenceError index test ≤
        compactnessConvergenceEnvelope
  /-- Uniform curvature bound used in the Hamilton compactness extraction. -/
  compactnessCurvatureBound : ℝ
  /-- The compactness curvature bound is nonnegative. -/
  compactnessCurvatureBoundNonnegative :
    0 ≤ compactnessCurvatureBound
  /-- Rescaled curvature scales are controlled on the compactness subsequence. -/
  rescaledCurvatureScale_le_compactnessCurvatureBound :
    ∀ index,
      collapsedBallBlowupPayload.rescaledCurvatureScale
          (subsequenceToBlowupIndex index) ≤
        compactnessCurvatureBound
  /-- Radius scale on which the compactness theorem is recorded. -/
  compactnessRadiusScale : ℝ
  /-- The compactness radius scale is positive. -/
  compactnessRadiusScalePositive :
    0 < compactnessRadiusScale
  /-- Blowup radii are controlled on the compactness subsequence. -/
  blowupRadius_le_compactnessRadiusScale :
    ∀ index,
      collapsedBallBlowupPayload.blowupRadius
          (subsequenceToBlowupIndex index) ≤
        compactnessRadiusScale
  /-- Aggregate envelope for Hamilton compactness data. -/
  hamiltonCompactnessEnvelope : ℝ
  /-- The aggregate Hamilton compactness envelope is nonnegative. -/
  hamiltonCompactnessEnvelopeNonnegative :
    0 ≤ hamiltonCompactnessEnvelope
  /-- Collapsed-ball blowup data are absorbed by the compactness envelope. -/
  collapsedBallBlowupEnvelope_le_hamiltonEnvelope :
    collapsedBallBlowupPayload.collapsedBallBlowupEnvelope ≤
      hamiltonCompactnessEnvelope
  /-- Convergence data are absorbed by the compactness envelope. -/
  compactnessConvergenceEnvelope_le_hamiltonEnvelope :
    compactnessConvergenceEnvelope ≤ hamiltonCompactnessEnvelope
  /-- Curvature bounds are absorbed by the compactness envelope. -/
  compactnessCurvatureBound_le_hamiltonEnvelope :
    compactnessCurvatureBound ≤ hamiltonCompactnessEnvelope

/-- Compactness convergence errors inherit nonnegativity from blowup convergence. -/
theorem HamiltonCompactnessPayload.compactnessConvergenceError_nonnegative
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {reducedVolumeNonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    {kappaNoncollapsingFromReducedVolumePayload :
      PerelmanKappaNoncollapsingFromReducedVolumePayload
        reducedVolumeNonincreasingPayload}
    {noLocalCollapsingContradictionSetupPayload :
      PerelmanNoLocalCollapsingContradictionSetupPayload
        kappaNoncollapsingFromReducedVolumePayload}
    {collapsedBallBlowupPayload :
      PerelmanCollapsedBallBlowupPayload
        noLocalCollapsingContradictionSetupPayload}
    (payload : HamiltonCompactnessPayload collapsedBallBlowupPayload)
    (index : payload.compactnessSubsequenceDomain)
    (test : payload.compactnessTestDomain) :
    0 ≤ payload.compactnessConvergenceError index test := by
  rw [payload.compactnessConvergenceError_eq_pointedConvergenceError index test]
  exact
    collapsedBallBlowupPayload.pointedConvergenceErrorNonnegative
      (payload.subsequenceToBlowupIndex index)
      (payload.compactnessTestToPointedConvergenceTest test)

