/--
Concrete differential-inequality data for Perelman's reduced distance.

The payload is tied to reduced-distance minimizer existence. It records smooth
and barrier/distributional test domains for reduced distance, residuals for the
Hamilton-Jacobi differential inequality, and a common nonnegative defect bound.
-/
structure PerelmanReducedDistanceDifferentialInequalityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    (reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload) : Type (u + 1) where
  /-- Scale on which the reduced-distance differential inequality is controlled. -/
  reducedDistanceDifferentialInequalityScale : ℝ
  /-- The differential-inequality scale is positive. -/
  reducedDistanceDifferentialInequalityScalePositive :
    0 < reducedDistanceDifferentialInequalityScale
  /-- Reduced-distance existence control lies within the differential-inequality scale. -/
  reducedDistanceExistenceScale_le_differentialInequalityScale :
    reducedDistanceExistencePayload.reducedDistanceExistenceScale ≤
      reducedDistanceDifferentialInequalityScale
  /-- Smooth test domain away from the reduced-distance cut locus. -/
  smoothReducedDistanceTestDomain : Type u
  /-- Minimizer associated to each smooth test point. -/
  smoothTestToMinimizer :
    smoothReducedDistanceTestDomain →
      reducedDistanceExistencePayload.reducedDistanceMinimizerSpace
  /-- Reduced-distance value at smooth test points. -/
  smoothReducedDistanceValue : smoothReducedDistanceTestDomain → ℝ
  /-- Smooth test values agree with the reduced-distance existence payload. -/
  smoothReducedDistanceValue_eq :
    ∀ test,
      smoothReducedDistanceValue test =
        reducedDistanceExistencePayload.reducedDistanceValue
          (smoothTestToMinimizer test)
  /-- Time derivative term in the smooth differential inequality. -/
  smoothTimeDerivative : smoothReducedDistanceTestDomain → ℝ
  /-- Squared-gradient term in the smooth differential inequality. -/
  smoothGradientNormSquared : smoothReducedDistanceTestDomain → ℝ
  /-- Smooth squared-gradient terms are nonnegative. -/
  smoothGradientNormSquaredNonnegative :
    ∀ test, 0 ≤ smoothGradientNormSquared test
  /-- Curvature term in the smooth differential inequality. -/
  smoothCurvatureTerm : smoothReducedDistanceTestDomain → ℝ
  /-- Smooth Hamilton-Jacobi residual. -/
  smoothHamiltonJacobiResidual : smoothReducedDistanceTestDomain → ℝ
  /-- The smooth residual is the recorded Hamilton-Jacobi expression. -/
  smoothHamiltonJacobiResidual_eq :
    ∀ test,
      smoothHamiltonJacobiResidual test =
        smoothTimeDerivative test +
          smoothGradientNormSquared test +
          smoothCurvatureTerm test
  /-- Barrier/distributional test domain for reduced distance. -/
  barrierReducedDistanceTestDomain : Type u
  /-- Smooth test supporting each barrier/distributional test. -/
  barrierTestToSmoothTest :
    barrierReducedDistanceTestDomain → smoothReducedDistanceTestDomain
  /-- Barrier residual for the distributional differential inequality. -/
  barrierHamiltonJacobiResidual :
    barrierReducedDistanceTestDomain → ℝ
  /-- Barrier residuals are controlled by the corresponding smooth residuals. -/
  barrierHamiltonJacobiResidual_le_smoothResidual :
    ∀ test,
      barrierHamiltonJacobiResidual test ≤
        smoothHamiltonJacobiResidual (barrierTestToSmoothTest test)
  /-- Defect bound in the differential inequality. -/
  reducedDistanceDifferentialInequalityDefectBound : ℝ
  /-- The differential-inequality defect bound is nonnegative. -/
  reducedDistanceDifferentialInequalityDefectBoundNonnegative :
    0 ≤ reducedDistanceDifferentialInequalityDefectBound
  /-- Smooth residuals are bounded by the differential-inequality defect. -/
  smoothHamiltonJacobiResidual_le_defectBound :
    ∀ test,
      smoothHamiltonJacobiResidual test ≤
        reducedDistanceDifferentialInequalityDefectBound

/--
Barrier/distributional residuals inherit the reduced-distance differential
inequality defect bound.
-/
theorem PerelmanReducedDistanceDifferentialInequalityPayload.barrierHamiltonJacobiResidual_le_defectBound
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    (payload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload)
    (test : payload.barrierReducedDistanceTestDomain) :
    payload.barrierHamiltonJacobiResidual test ≤
      payload.reducedDistanceDifferentialInequalityDefectBound :=
  le_trans
    (payload.barrierHamiltonJacobiResidual_le_smoothResidual test)
    (payload.smoothHamiltonJacobiResidual_le_defectBound
      (payload.barrierTestToSmoothTest test))

