  /-- Labels used to classify canonical-neighborhood model regions. -/
  canonicalNeighborhoodClassLabel : Type u
  /-- Distinguished class label used by downstream package data. -/
  baseCanonicalNeighborhoodClassLabel :
    canonicalNeighborhoodClassLabel
  /-- Assigned classification label for each neck/cap model region. -/
  classificationLabelOfModel :
    neckCapPayload.neckCapModelFamily →
      canonicalNeighborhoodClassLabel
  /-- Predicate selecting labels classified as epsilon-necks. -/
  isEpsilonNeckClass : canonicalNeighborhoodClassLabel → Prop
  /-- Predicate selecting labels classified as epsilon-caps. -/
  isEpsilonCapClass : canonicalNeighborhoodClassLabel → Prop
  /-- Every model is classified as a neck class or a cap class. -/
  classificationLabel_neck_or_cap :
    ∀ model,
      isEpsilonNeckClass (classificationLabelOfModel model) ∨
        isEpsilonCapClass (classificationLabelOfModel model)
  /-- Neck classification scale retained from the dichotomy payload. -/
  classificationNeckScale :
    neckCapPayload.neckCapModelFamily → ℝ
  /-- Neck classification scales agree with dichotomy neck scales. -/
  classificationNeckScale_eq_epsilonNeckScale :
    ∀ model,
      classificationNeckScale model =
        neckCapPayload.epsilonNeckScale model
  /-- Cap classification scale retained from the dichotomy payload. -/
  classificationCapScale :
    neckCapPayload.neckCapModelFamily → ℝ
  /-- Cap classification scales agree with dichotomy cap scales. -/
  classificationCapScale_eq_epsilonCapScale :
    ∀ model,
      classificationCapScale model =
        neckCapPayload.epsilonCapScale model
  /-- Defect measuring the model-classification comparison. -/
  classificationDefect :
    neckCapPayload.neckCapModelFamily → ℝ
  /-- Classification defects are nonnegative. -/
  classificationDefectNonnegative :
    ∀ model, 0 ≤ classificationDefect model
  /-- Envelope controlling classification data. -/
  classificationEnvelope : ℝ
  /-- The classification envelope is nonnegative. -/
  classificationEnvelopeNonnegative : 0 ≤ classificationEnvelope
  /-- Neck/cap dichotomy control is absorbed by the classification envelope. -/
  neckCapDichotomyEnvelope_le_classificationEnvelope :
    neckCapPayload.neckCapDichotomyEnvelope ≤ classificationEnvelope
  /-- Classification defects are bounded by the envelope. -/
  classificationDefect_le_envelope :
    ∀ model, classificationDefect model ≤ classificationEnvelope

