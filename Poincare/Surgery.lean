        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    (entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload) : Type (u + 1) where
  /-- Scale on which entropy lower-bound propagation is controlled. -/
  entropyLowerBoundPropagationScale : ℝ
  /-- The lower-bound propagation scale is positive. -/
  entropyLowerBoundPropagationScalePositive :
    0 < entropyLowerBoundPropagationScale
  /-- Entropy-monotonicity control lies within the lower-bound scale. -/
  entropyMonotonicityScale_le_lowerBoundPropagationScale :
    entropyMonotonicityPayload.entropyMonotonicityScale ≤
      entropyLowerBoundPropagationScale
  /-- Lower bound initialized at the monotonicity base time. -/
  entropyLowerBound : ℝ
  /-- The initialized lower bound holds at the monotonicity base time. -/
  entropyLowerBoundAtBase :
    entropyLowerBound ≤
      entropyMonotonicityPayload.entropyValueAlongFlow
        entropyMonotonicityPayload.entropyMonotonicityBaseTime
  /-- Interval on which the lower bound is propagated. -/
  entropyLowerBoundPropagationInterval : Set ℝ
  /-- The monotonicity base time belongs to the lower-bound interval. -/
  entropyLowerBoundBaseTime_mem :
    entropyMonotonicityPayload.entropyMonotonicityBaseTime ∈
      entropyLowerBoundPropagationInterval
  /-- The lower-bound interval lies inside the monotonicity interval. -/
  entropyLowerBoundPropagationInterval_subset_monotonicityInterval :
    ∀ t, t ∈ entropyLowerBoundPropagationInterval →
      t ∈ entropyMonotonicityPayload.entropyMonotonicityTimeInterval
  /-- The lower-bound interval is forward from the monotonicity base time. -/
  entropyLowerBoundPropagationInterval_future_of_base :
    ∀ t, t ∈ entropyLowerBoundPropagationInterval →
      entropyMonotonicityPayload.entropyMonotonicityBaseTime ≤ t

/--
The lower bound recorded by a propagation payload holds throughout its
controlled interval.
-/
theorem PerelmanEntropyLowerBoundPropagationPayload.entropyLowerBound_le_value
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    (payload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload)
    {t : ℝ} (ht : t ∈ payload.entropyLowerBoundPropagationInterval) :
    payload.entropyLowerBound ≤
      entropyMonotonicityPayload.entropyValueAlongFlow t := by
  have hmonotone :
      entropyMonotonicityPayload.entropyValueAlongFlow
          entropyMonotonicityPayload.entropyMonotonicityBaseTime ≤
        entropyMonotonicityPayload.entropyValueAlongFlow t :=
    entropyMonotonicityPayload.entropyValue_monotone_on_interval
      entropyMonotonicityPayload.entropyMonotonicityBaseTime t
      entropyMonotonicityPayload.entropyMonotonicityBaseTime_mem
      (payload.entropyLowerBoundPropagationInterval_subset_monotonicityInterval
        t ht)
      (payload.entropyLowerBoundPropagationInterval_future_of_base t ht)
  exact le_trans payload.entropyLowerBoundAtBase hmonotone

