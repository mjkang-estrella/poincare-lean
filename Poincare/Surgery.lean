/--
Concrete payload for the statement that discarded components do not carry the
target sweepout width.

The payload is attached to a concrete surgery-discard-control payload, records
that the abstract discard-control witness is produced from it, names the
selected discarded component and retained target slice, and stores the zero
discarded-width contribution used by the width-neutrality step.
-/
structure FiniteExtinctionDiscardedComponentWidthNeutralityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory)
    (discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution) :
    Type (u + 1) where
  /-- Concrete surgery-discard-control payload being neutralized. -/
  surgeryDiscardControlPayload :
    FiniteExtinctionSurgeryDiscardControlPayload
      flow surgery control widthTheory widthEvolution
  /-- The abstract discard-control witness is built from the concrete payload. -/
  discardControlEq :
    discardControl =
      HasFiniteExtinctionSurgeryDiscardControl.of_surgery_discard_control_payload
        surgeryDiscardControlPayload
  /-- Selected discarded component whose width contribution is neutralized. -/
  neutralizedComponent :
    surgeryDiscardControlPayload.discardedComponentIndex
  /-- The neutralized component is the selected component in discard control. -/
  neutralizedComponentEqSelected :
    neutralizedComponent =
      surgeryDiscardControlPayload.selectedDiscardedComponent
  /-- Discarded component set used in the neutrality statement. -/
  discardedComponentSet : Set M
  /-- The discarded set agrees with the discard-control payload. -/
  discardedComponentSetEqControl :
    discardedComponentSet =
      surgeryDiscardControlPayload.discardedComponentSet
  /-- Retained target slice carrying the compared sweepout width. -/
  retainedTargetSlice : Set M
  /-- The retained target slice agrees with the discard-control payload. -/
  retainedTargetSliceEqControl :
    retainedTargetSlice =
      surgeryDiscardControlPayload.retainedComponentSet
  /-- Witness point showing the retained target slice remains nonempty. -/
  retainedWitnessPoint : M
  /-- The retained witness lies in the retained target slice. -/
  retainedWitnessMem : retainedWitnessPoint ∈ retainedTargetSlice
  /-- The discarded component has zero stored width contribution. -/
  discardedWidthNeutralized :
    surgeryDiscardControlPayload.discardedWidthContribution = 0
  /-- The neutralized discarded width remains bounded by the surgery drop. -/
  discardedWidthLeDrop :
    surgeryDiscardControlPayload.discardedWidthContribution ≤
      surgeryDiscardControlPayload.surgeryWidthDropPayload.widthDropAmount
  /-- The retained width remains controlled by the post-surgery width. -/
  retainedWidthLePostSurgeryWidth :
    surgeryDiscardControlPayload.retainedWidthContribution ≤
      surgeryDiscardControlPayload.surgeryWidthDropPayload.postSurgeryWidth

/-- Bundle the concrete retained/discarded-component facts used by width neutrality. -/
theorem FiniteExtinctionDiscardedComponentWidthNeutralityPayload.neutrality_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    {discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution}
    (payload :
      FiniteExtinctionDiscardedComponentWidthNeutralityPayload
        flow surgery control widthTheory widthEvolution discardControl) :
    payload.neutralizedComponent =
        payload.surgeryDiscardControlPayload.selectedDiscardedComponent ∧
      payload.discardedComponentSet =
        payload.surgeryDiscardControlPayload.discardedComponentSet ∧
      payload.retainedTargetSlice =
        payload.surgeryDiscardControlPayload.retainedComponentSet ∧
      payload.retainedWitnessPoint ∈ payload.retainedTargetSlice ∧
      payload.surgeryDiscardControlPayload.discardedWidthContribution = 0 ∧
      payload.surgeryDiscardControlPayload.discardedWidthContribution ≤
        payload.surgeryDiscardControlPayload.surgeryWidthDropPayload.widthDropAmount ∧
      payload.surgeryDiscardControlPayload.retainedWidthContribution ≤
        payload.surgeryDiscardControlPayload.surgeryWidthDropPayload.postSurgeryWidth := by
  exact
    ⟨payload.neutralizedComponentEqSelected,
      payload.discardedComponentSetEqControl,
      payload.retainedTargetSliceEqControl,
      payload.retainedWitnessMem,
      payload.discardedWidthNeutralized,
      payload.discardedWidthLeDrop,
      payload.retainedWidthLePostSurgeryWidth⟩

