/--
Concrete payload for the area functional used on a finite-extinction sweepout.

The payload ties the sweepout's abstract area values to an explicit real-valued
functional on the parameter space and records the metric regularity and
post-surgery metric-control inputs needed to interpret the functional along the
flow with surgery.
-/
structure FiniteExtinctionAreaFunctionalPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (_surgery : HasRicciFlowWithSurgery n M)
    (_control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (fundamentalGroup : HasFiniteExtinctionFundamentalGroupInput M)
    (sweepoutPayload :
      FiniteExtinctionSweepoutPayload M fundamentalGroup) : Type (u + 1) where
  /-- Real-valued area functional on the sweepout parameter space. -/
  areaFunctional : sweepoutPayload.parameterSpace → ℝ
  /-- The area functional agrees with the sweepout payload's slice areas. -/
  agreesWithSweepoutArea :
    ∀ p : sweepoutPayload.parameterSpace,
      areaFunctional p = sweepoutPayload.areaValue p
  /-- The area functional inherits the sweepout payload's uniform area bound. -/
  areaFunctionalLeSweepoutBound :
    ∀ p : sweepoutPayload.parameterSpace,
      areaFunctional p ≤ sweepoutPayload.areaBound
  /-- Metric regularity needed to evaluate areas along the flow. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Post-surgery metric control needed to compare areas across surgery times. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow

