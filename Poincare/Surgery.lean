      CanonicalNeighborhoodScaleControlPayload
        ancientCompactnessPayload}
    {stabilityPayload :
      CanonicalNeighborhoodStabilityPayload scaleControlPayload}
    (persistencePayload :
      CanonicalNeighborhoodPersistenceAcrossScalesPayload
        stabilityPayload) :
    Type (u + 1) where
  /-- Family of model regions where the neck/cap alternative is asserted. -/
  neckCapModelFamily : Type u
  /-- Distinguished model region used by downstream package data. -/
  baseNeckCapModel : neckCapModelFamily
  /-- Link from a neck/cap model to the controlling persistence transition. -/
  neckCapModelToPersistenceTransition :
    neckCapModelFamily →
      persistencePayload.persistenceScaleTransitionSpace
  /-- Canonical-neighborhood region being decomposed into neck/cap alternatives. -/
  canonicalNeighborhoodRegion : neckCapModelFamily → Set M
  /-- The epsilon-neck alternative region for a model. -/
  epsilonNeckRegion : neckCapModelFamily → Set M
  /-- The epsilon-cap alternative region for a model. -/
  epsilonCapRegion : neckCapModelFamily → Set M
  /-- Epsilon-neck regions lie inside the canonical-neighborhood region. -/
  epsilonNeckRegion_subset_canonicalNeighborhoodRegion :
    ∀ model x,
      x ∈ epsilonNeckRegion model →
        x ∈ canonicalNeighborhoodRegion model
  /-- Epsilon-cap regions lie inside the canonical-neighborhood region. -/
  epsilonCapRegion_subset_canonicalNeighborhoodRegion :
    ∀ model x,
      x ∈ epsilonCapRegion model →
        x ∈ canonicalNeighborhoodRegion model
  /-- Every controlled canonical-neighborhood point is in a neck or cap. -/
  canonicalNeighborhoodRegion_subset_neck_or_cap :
    ∀ model x,
      x ∈ canonicalNeighborhoodRegion model →
        x ∈ epsilonNeckRegion model ∨ x ∈ epsilonCapRegion model
  /-- Scale of the epsilon-neck alternative. -/
  epsilonNeckScale : neckCapModelFamily → ℝ
  /-- Neck scales agree with the persistence source scale. -/
  epsilonNeckScale_eq_persistenceSourceScale :
    ∀ model,
      epsilonNeckScale model =
        persistencePayload.persistenceSourceScale
          (neckCapModelToPersistenceTransition model)
  /-- Scale of the epsilon-cap alternative. -/
  epsilonCapScale : neckCapModelFamily → ℝ
  /-- Cap scales agree with the persistence target scale. -/
  epsilonCapScale_eq_persistenceTargetScale :
    ∀ model,
      epsilonCapScale model =
        persistencePayload.persistenceTargetScale
          (neckCapModelToPersistenceTransition model)
  /-- Defect in the dichotomy comparison for a model region. -/
  neckCapDichotomyDefect : neckCapModelFamily → ℝ
  /-- Dichotomy defects are nonnegative. -/
  neckCapDichotomyDefectNonnegative :
    ∀ model, 0 ≤ neckCapDichotomyDefect model
  /-- Envelope controlling the neck/cap dichotomy data. -/
  neckCapDichotomyEnvelope : ℝ
  /-- The dichotomy envelope is nonnegative. -/
  neckCapDichotomyEnvelopeNonnegative :
    0 ≤ neckCapDichotomyEnvelope
  /-- Persistence control is absorbed by the dichotomy envelope. -/
  persistenceEnvelope_le_neckCapDichotomyEnvelope :
    persistencePayload.persistenceEnvelope ≤ neckCapDichotomyEnvelope
  /-- Dichotomy defects are bounded by the envelope. -/
  neckCapDichotomyDefect_le_envelope :
    ∀ model,
      neckCapDichotomyDefect model ≤ neckCapDichotomyEnvelope

