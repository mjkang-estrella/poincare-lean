/--
Concrete reduced-volume derivative-formula data for the Perelman package.

The payload is tied to the reduced-volume definition data. It records the test
domain for differentiating reduced volume, the time-derivative term, a
nonnegative dissipation term, and the residual identity whose nonpositivity
gives the derivative inequality used by downstream monotonicity arguments.
-/
structure PerelmanReducedVolumeDerivativeFormulaPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    (reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload) : Type (u + 1) where
  /-- Scale on which the reduced-volume derivative formula is asserted. -/
  reducedVolumeDerivativeFormulaScale : ℝ
  /-- The reduced-volume derivative-formula scale is positive. -/
  reducedVolumeDerivativeFormulaScalePositive :
    0 < reducedVolumeDerivativeFormulaScale
  /-- Reduced-volume definition lies within the derivative-formula scale. -/
  reducedVolumeDefinitionScale_le_derivativeFormulaScale :
    reducedVolumeDefinitionPayload.reducedVolumeDefinitionScale ≤
      reducedVolumeDerivativeFormulaScale
  /-- Domain of tests on which the reduced-volume derivative formula is recorded. -/
  reducedVolumeDerivativeTestDomain : Type u
  /-- Integration-domain point sampled by each derivative test. -/
  derivativeTestToIntegrationPoint :
    reducedVolumeDerivativeTestDomain →
      reducedVolumeDefinitionPayload.reducedVolumeIntegrationDomain
  /-- Time coordinate at each derivative test. -/
  reducedVolumeDerivativeTime :
    reducedVolumeDerivativeTestDomain → ℝ
  /-- Reduced-volume value along the derivative test family. -/
  reducedVolumeValueAtDerivativeTest :
    reducedVolumeDerivativeTestDomain → ℝ
  /-- The derivative-test value agrees with the reduced-volume definition. -/
  reducedVolumeValueAtDerivativeTest_eq_definitionValue :
    ∀ test,
      reducedVolumeValueAtDerivativeTest test =
        reducedVolumeDefinitionPayload.reducedVolumeValue
  /-- Time derivative of reduced volume at each derivative test. -/
  reducedVolumeTimeDerivative :
    reducedVolumeDerivativeTestDomain → ℝ
  /-- Nonnegative dissipation term in Perelman's reduced-volume formula. -/
  reducedVolumeDissipation :
    reducedVolumeDerivativeTestDomain → ℝ
  /-- Dissipation is nonnegative. -/
  reducedVolumeDissipationNonnegative :
    ∀ test, 0 ≤ reducedVolumeDissipation test
  /-- Residual in the reduced-volume derivative formula. -/
  reducedVolumeDerivativeFormulaResidual :
    reducedVolumeDerivativeTestDomain → ℝ
  /-- The derivative plus dissipation equals the recorded residual. -/
  reducedVolumeDerivativeFormula_eq :
    ∀ test,
      reducedVolumeTimeDerivative test +
          reducedVolumeDissipation test =
        reducedVolumeDerivativeFormulaResidual test
  /-- The derivative-formula residual is nonpositive. -/
  reducedVolumeDerivativeFormulaResidual_nonpositive :
    ∀ test, reducedVolumeDerivativeFormulaResidual test ≤ 0
  /-- Envelope controlling derivative-formula terms. -/
  reducedVolumeDerivativeFormulaEnvelope : ℝ
  /-- The derivative-formula envelope is nonnegative. -/
  reducedVolumeDerivativeFormulaEnvelopeNonnegative :
    0 ≤ reducedVolumeDerivativeFormulaEnvelope
  /-- Reduced-volume definition data are absorbed by the derivative envelope. -/
  reducedVolumeDefinitionEnvelope_le_derivativeFormulaEnvelope :
    reducedVolumeDefinitionPayload.reducedVolumeDefinitionEnvelope ≤
      reducedVolumeDerivativeFormulaEnvelope
  /-- Dissipation is bounded by the derivative-formula envelope. -/
  reducedVolumeDissipation_le_derivativeFormulaEnvelope :
    ∀ test,
      reducedVolumeDissipation test ≤
        reducedVolumeDerivativeFormulaEnvelope

/--
The reduced-volume derivative formula gives a nonpositive time derivative.
-/
theorem PerelmanReducedVolumeDerivativeFormulaPayload.reducedVolumeTimeDerivative_nonpositive
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    (payload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload)
    (test : payload.reducedVolumeDerivativeTestDomain) :
    payload.reducedVolumeTimeDerivative test ≤ 0 := by
  calc
    payload.reducedVolumeTimeDerivative test ≤
        payload.reducedVolumeTimeDerivative test +
          payload.reducedVolumeDissipation test :=
      le_add_of_nonneg_right
        (payload.reducedVolumeDissipationNonnegative test)
    _ = payload.reducedVolumeDerivativeFormulaResidual test :=
      payload.reducedVolumeDerivativeFormula_eq test
    _ ≤ 0 :=
      payload.reducedVolumeDerivativeFormulaResidual_nonpositive test

/--
Reduced-volume derivative-test values are controlled by the definition
envelope.
