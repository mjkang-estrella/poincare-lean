/--
Concrete cut-locus and barrier-control data for reduced distance.

The payload is tied to reduced-distance estimates. It records a cut-locus
region, the complementary smooth region sampled by smooth tests, barrier tests
covering cut-locus points, and a residual bound compatible with the estimates
payload.
-/
structure PerelmanReducedDistanceCutLocusControlPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    (reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload) : Type (u + 1) where
  /-- Scale on which cut-locus and barrier control is asserted. -/
  reducedDistanceCutLocusControlScale : ℝ
  /-- The cut-locus control scale is positive. -/
  reducedDistanceCutLocusControlScalePositive :
    0 < reducedDistanceCutLocusControlScale
  /-- Reduced-distance estimates lie within the cut-locus control scale. -/
  estimatesScale_le_cutLocusControlScale :
    reducedDistanceEstimatesPayload.reducedDistanceEstimatesScale ≤
      reducedDistanceCutLocusControlScale
  /-- Region where reduced distance may fail to be represented by a smooth minimizer. -/
  reducedDistanceCutLocusRegion : Set M
  /-- Region where reduced distance is represented by smooth tests. -/
  smoothReducedDistanceRegion : Set M
  /-- Smooth test points are assigned to the smooth reduced-distance region. -/
  smoothTestPoint :
    reducedDistanceDifferentialInequalityPayload.smoothReducedDistanceTestDomain →
      M
  /-- Smooth test points lie in the smooth reduced-distance region. -/
  smoothTestPoint_mem_smoothRegion :
    ∀ test, smoothTestPoint test ∈ smoothReducedDistanceRegion
  /-- Smooth test points avoid the cut-locus region. -/
  smoothTestPoint_not_mem_cutLocusRegion :
    ∀ test, smoothTestPoint test ∉ reducedDistanceCutLocusRegion
  /-- Barrier test points assigned to distributional tests. -/
  barrierTestPoint :
    reducedDistanceDifferentialInequalityPayload.barrierReducedDistanceTestDomain →
      M
  /-- Barrier tests are supported on the cut-locus or smooth reduced-distance region. -/
  barrierTestPoint_mem_cutLocus_or_smoothRegion :
    ∀ test,
      barrierTestPoint test ∈
        reducedDistanceCutLocusRegion ∪ smoothReducedDistanceRegion
  /-- Every cut-locus point has an assigned supporting barrier test. -/
  cutLocusPoint_supportedByBarrier :
    ∀ x, x ∈ reducedDistanceCutLocusRegion →
      ∃ test, barrierTestPoint test = x
  /-- Region supporting barrier replacements near the cut locus. -/
  barrierSupportRegion : Set M
  /-- Cut-locus points lie in the barrier support region. -/
  cutLocusRegion_subset_barrierSupportRegion :
    ∀ x, x ∈ reducedDistanceCutLocusRegion → x ∈ barrierSupportRegion
  /-- Barrier test points lie in the barrier support region. -/
  barrierTestPoint_mem_barrierSupportRegion :
    ∀ test, barrierTestPoint test ∈ barrierSupportRegion
  /-- Bound for barrier residuals across cut-locus control tests. -/
  cutLocusBarrierResidualBound : ℝ
  /-- The cut-locus barrier residual bound is nonnegative. -/
  cutLocusBarrierResidualBoundNonnegative :
    0 ≤ cutLocusBarrierResidualBound
  /-- The estimates-level barrier residual bound is absorbed by cut-locus control. -/
  barrierResidualEstimateBound_le_cutLocusBarrierResidualBound :
    reducedDistanceEstimatesPayload.barrierResidualEstimateBound ≤
      cutLocusBarrierResidualBound

/-- Cut-locus points lie in the recorded barrier support region. -/
theorem PerelmanReducedDistanceCutLocusControlPayload.cutLocusRegion_mem_barrierSupport
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    (payload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload)
    {x : M} (hx : x ∈ payload.reducedDistanceCutLocusRegion) :
    x ∈ payload.barrierSupportRegion :=
  payload.cutLocusRegion_subset_barrierSupportRegion x hx

/--
Barrier residuals are controlled by the cut-locus barrier residual bound.
-/
theorem PerelmanReducedDistanceCutLocusControlPayload.barrierResidual_le_cutLocusBound
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
