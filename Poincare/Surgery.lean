/--
Concrete payload for topological control of components that survive before
extinction.

The payload is attached to the same surgery-discard-control payload and the
surviving-component tracking payload. It records the tracked component set, a
carrier type embedded into the ambient manifold, a nonempty component witness,
and the retained-width/discarded-empty certificates used to identify the
surviving component as the relevant topological piece.
-/
structure FiniteExtinctionComponentTopologyPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory)
    (discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution) :
    Type (u + 1) where
  /-- Concrete surgery-discard-control payload whose retained component is controlled. -/
  surgeryDiscardControlPayload :
    FiniteExtinctionSurgeryDiscardControlPayload
      flow surgery control widthTheory widthEvolution
  /-- The abstract discard-control witness is built from the concrete payload. -/
  discardControlEq :
    discardControl =
      HasFiniteExtinctionSurgeryDiscardControl.of_surgery_discard_control_payload
        surgeryDiscardControlPayload
  /-- Surviving-component tracking payload identifying the retained component. -/
  survivingComponentTrackingPayload :
    FiniteExtinctionSurvivingComponentTrackingPayload
      flow surgery control widthTheory widthEvolution discardControl
  /-- The tracked component set whose topology is controlled. -/
  componentSet : Set M
  /-- The controlled component is the component tracked as surviving surgery. -/
  componentSetEqTracked :
    componentSet =
      survivingComponentTrackingPayload.survivingComponentSet
  /-- Concrete carrier used for the surviving component. -/
  componentCarrier : Type u
  /-- Embedding of the carrier into the ambient manifold. -/
  componentEmbedding : componentCarrier → M
  /-- The embedded carrier lands in the controlled component set. -/
  componentEmbeddingMem :
    ∀ x : componentCarrier, componentEmbedding x ∈ componentSet
  /-- Witness that the controlled component is nonempty. -/
  componentCarrierWitness : componentCarrier
  /-- Ambient witness point for the controlled component. -/
  componentWitnessPoint : M
  /-- The carrier witness maps to the ambient witness point. -/
  componentWitnessEq :
    componentEmbedding componentCarrierWitness = componentWitnessPoint
  /-- The ambient witness lies in the controlled component set. -/
  componentWitnessMem :
    componentWitnessPoint ∈ componentSet
  /-- Neighborhood/set used as the local topological control certificate. -/
  componentNeighborhood : Set M
  /-- The witness lies in the local topological-control neighborhood. -/
  componentWitnessMemNeighborhood :
    componentWitnessPoint ∈ componentNeighborhood
  /-- The local topological-control neighborhood stays inside the component. -/
  componentNeighborhoodSubset :
    componentNeighborhood ⊆ componentSet
  /-- The retained width remains controlled on the topological component. -/
  retainedWidthTopologyBound :
    surgeryDiscardControlPayload.retainedWidthContribution ≤
      surgeryDiscardControlPayload.surgeryWidthDropPayload.postSurgeryWidth
  /-- The discarded side has already been classified away as empty. -/
  discardedComponentsClassifiedEmpty :
    surgeryDiscardControlPayload.discardedComponentSet = ∅

/-- Bundle the local component-topology facts for the surviving finite-extinction component. -/
theorem FiniteExtinctionComponentTopologyPayload.component_topology_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    {discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution}
    (payload :
      FiniteExtinctionComponentTopologyPayload
        flow surgery control widthTheory widthEvolution discardControl) :
    payload.componentSet =
        payload.survivingComponentTrackingPayload.survivingComponentSet ∧
      (∀ x : payload.componentCarrier, payload.componentEmbedding x ∈ payload.componentSet) ∧
      payload.componentEmbedding payload.componentCarrierWitness =
        payload.componentWitnessPoint ∧
      payload.componentWitnessPoint ∈ payload.componentSet ∧
      payload.componentWitnessPoint ∈ payload.componentNeighborhood ∧
      payload.componentNeighborhood ⊆ payload.componentSet ∧
      payload.surgeryDiscardControlPayload.retainedWidthContribution ≤
        payload.surgeryDiscardControlPayload.surgeryWidthDropPayload.postSurgeryWidth ∧
      payload.surgeryDiscardControlPayload.discardedComponentSet = ∅ := by
  exact
    ⟨payload.componentSetEqTracked,
      payload.componentEmbeddingMem,
      payload.componentWitnessEq,
      payload.componentWitnessMem,
      payload.componentWitnessMemNeighborhood,
      payload.componentNeighborhoodSubset,
      payload.retainedWidthTopologyBound,
      payload.discardedComponentsClassifiedEmpty⟩

