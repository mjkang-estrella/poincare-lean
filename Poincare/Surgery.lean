/--
Concrete payload for the smooth width differential inequality.

The payload is attached to the width-evolution comparison for the same width
theory and records the local derivative, the Gauss-Bonnet and scalar-curvature
terms entering its upper bound, and the actual differential inequality. Surgery
metric comparison remains a separate downstream interface because it concerns
crossing surgery times rather than smooth-flow intervals.
-/
structure FiniteExtinctionWidthDifferentialInequalityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  /-- Width-evolution comparison data for the same width theory. -/
  widthEvolutionPayload :
    FiniteExtinctionWidthEvolutionPayload flow surgery control widthTheory
  /-- Regularity of the evolving metric used to differentiate widths. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Metric control across surgery times retained for boundary compatibility. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow
  /-- Scalar-curvature evolution input entering the smooth width inequality. -/
  scalarCurvatureEvolution : HasScalarCurvatureEvolutionEquation flow
  /-- Parameter space on which the local differential inequality is asserted. -/
  differentiationParameterSpace : Type u
  /-- Parameter selecting the smooth-flow point for the inequality. -/
  differentiationParameter : differentiationParameterSpace
  /-- Width value at the selected parameter. -/
  widthValue : ℝ
  /-- The selected width is the initial value from width evolution. -/
  widthValueEqEvolutionInitial :
    widthValue = widthEvolutionPayload.initialWidthValue
  /-- Local derivative of the width at the selected parameter. -/
  widthDerivative : ℝ
  /-- Gauss-Bonnet contribution in the width derivative estimate. -/
  gaussBonnetContribution : ℝ
  /-- Scalar-curvature contribution in the width derivative estimate. -/
  scalarCurvatureContribution : ℝ
  /-- Upper bound for the local width derivative. -/
  differentialUpperBound : ℝ
  /-- The upper bound is the stored sum of geometric contributions. -/
  differentialUpperBoundEq :
    differentialUpperBound =
      gaussBonnetContribution + scalarCurvatureContribution
  /-- The derivative is bounded by the geometric upper bound. -/
  widthDerivativeLeUpperBound :
    widthDerivative ≤ differentialUpperBound
  /-- The Gauss-Bonnet contribution is bounded by its stored curvature bound. -/
  gaussBonnetContributionLeBound :
    gaussBonnetContribution ≤
      (widthEvolutionPayload.scalarCurvatureWidthBoundPayload.gaussBonnetPayload).gaussBonnetUpperBound
  /-- The scalar-curvature contribution is controlled by the selected width. -/
  scalarCurvatureContributionLeWidth :
    scalarCurvatureContribution ≤ widthValue

/-- Source data for the width differential inequality along the smooth flow pieces. -/
structure FiniteExtinctionWidthDifferentialInequalityPayloadSource
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  payload :
    FiniteExtinctionWidthDifferentialInequalityPayload
      flow surgery control widthTheory

