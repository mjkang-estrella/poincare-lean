/--
Concrete payload for the Gauss-Bonnet estimate used in the finite-extinction
width derivative bound.

The payload records the analytic curvature theory, the stable min-max slice on
which Gauss-Bonnet is evaluated, and explicit integral/bound certificates used
by the width estimate.
-/
structure FiniteExtinctionGaussBonnetEstimatePayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  /-- Second-variation/stability payload for the same width theory. -/
  secondVariationPayload :
    FiniteExtinctionSecondVariationInequalityPayload
      flow surgery control widthTheory
  /-- Metric regularity for evaluating curvature and area on the selected slice. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Ambient Riemann-curvature tensor theory. -/
  riemannCurvature :
    HasRiemannCurvatureTensorTheory (metric_of_ricci_flow_data flow)
  /-- Scalar-curvature contraction formula from the ambient curvature data. -/
  scalarCurvatureContraction :
    HasScalarCurvatureContractionFormula
      (curvature_data_of_ricci_flow_data flow)
  /-- Scalar-curvature theory used to compare intrinsic and ambient terms. -/
  scalarCurvature :
    HasScalarCurvatureTheory (curvature_data_of_ricci_flow_data flow)
  /-- Canonical-neighborhood input for the regular stable slice. -/
  canonicalNeighborhood : HasCanonicalNeighborhoodTheorem flow
  /-- Parameter space for the stable min-max slices. -/
  surfaceParameterSpace : Type u
  /-- Parameter selecting the slice on which the estimate is evaluated. -/
  surfaceParameter : surfaceParameterSpace
  /-- The selected stable slice. -/
  surfaceSlice : Set M
  /-- A point witnessing that the selected slice is nonempty. -/
  surfaceWitnessPoint : M
  /-- The witness point lies on the selected slice. -/
  surfaceWitnessMem : surfaceWitnessPoint ∈ surfaceSlice
  /-- Abstract intrinsic curvature integral appearing in Gauss-Bonnet. -/
  gaussBonnetIntegral : ℝ
  /-- Euler-characteristic term in the Gauss-Bonnet identity. -/
  eulerCharacteristicTerm : ℝ
  /-- Error or ambient-curvature comparison term in the identity. -/
  curvatureComparisonTerm : ℝ
  /-- Concrete Gauss-Bonnet identity for the selected slice. -/
  gaussBonnetIdentity :
    gaussBonnetIntegral =
      eulerCharacteristicTerm + curvatureComparisonTerm
  /-- Upper bound used by the finite-extinction width estimate. -/
  gaussBonnetUpperBound : ℝ
  /-- The Gauss-Bonnet contribution is bounded above by the stored bound. -/
  gaussBonnetEstimate :
    gaussBonnetIntegral ≤ gaussBonnetUpperBound
  /-- The stored upper bound is nonnegative. -/
  gaussBonnetUpperBoundNonnegative :
    0 ≤ gaussBonnetUpperBound
  /-- Area value of the selected slice. -/
  surfaceAreaValue : ℝ
  /-- Width value controlling the selected slice. -/
  widthValue : ℝ
  /-- The selected slice area remains controlled by width. -/
  surfaceAreaLeWidth : surfaceAreaValue ≤ widthValue

/-- Source data for the Gauss-Bonnet estimate used in the width derivative bound. -/
structure FiniteExtinctionGaussBonnetEstimatePayloadSource
