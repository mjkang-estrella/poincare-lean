  exact
    KappaSolutionNonnegativeCurvatureOperatorPayload.curvatureOperatorLowerBound_nonnegative
      nonnegativeCurvatureOperatorPayload
      (payload.asymptoticSolitonToCurvatureOperatorTest model)

