  postSurgeryCanonicalNeighborhoodDefect_le_derivativeDefect :
    ∀ parameter x,
      x ∈ postSurgeryDerivativeBoundsPayload.derivativeControlRegion
          parameter →
        postSurgeryCanonicalNeighborhoodDefect parameter x ≤
          postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect
            0 parameter x
  /-- The persisted canonical-neighborhood defect is controlled by strong delta. -/
  postSurgeryCanonicalNeighborhoodDefect_le_strongDelta :
    ∀ parameter x,
      x ∈ persistedCanonicalNeighborhoodRegion parameter →
        postSurgeryCanonicalNeighborhoodDefect parameter x ≤
          strongDeltaPayload.strongDelta parameter

