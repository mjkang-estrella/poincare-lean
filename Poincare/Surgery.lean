    collapsedBallBlowupPayload.rescaledFlowModel
  /-- The normalized limit agrees with the pointed-rescaling limit model. -/
  normalizedLimitModel_eq_pointedRescalingLimit :
    normalizedLimitModel =
      pointedRescalingPayload.pointedRescalingLimitModel
  /-- Aggregate envelope for curvature-normalization data. -/
  curvatureNormalizationEnvelope : ℝ
  /-- The curvature-normalization envelope is nonnegative. -/
  curvatureNormalizationEnvelopeNonnegative :
    0 ≤ curvatureNormalizationEnvelope
  /-- Pointed-rescaling data are absorbed by the normalization envelope. -/
  pointedRescalingEnvelope_le_curvatureNormalizationEnvelope :
    pointedRescalingPayload.pointedRescalingEnvelope ≤
      curvatureNormalizationEnvelope

