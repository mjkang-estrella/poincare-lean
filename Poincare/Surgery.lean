    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    (entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload) :
    Type (u + 1) where
  /-- Scale on which entropy monotonicity is controlled. -/
  entropyMonotonicityScale : ℝ
  /-- The entropy-monotonicity control scale is positive. -/
  entropyMonotonicityScalePositive : 0 < entropyMonotonicityScale
  /-- First-variation control lies within the monotonicity scale. -/
  entropyFirstVariationScale_le_monotonicityScale :
    entropyFirstVariationPayload.entropyFirstVariationScale ≤
      entropyMonotonicityScale
  /-- Time interval on which the entropy value is tracked. -/
  entropyMonotonicityTimeInterval : Set ℝ
  /-- Distinguished time in the monotonicity interval. -/
  entropyMonotonicityBaseTime : ℝ
  /-- The distinguished time belongs to the monotonicity interval. -/
  entropyMonotonicityBaseTime_mem :
    entropyMonotonicityBaseTime ∈ entropyMonotonicityTimeInterval
  /-- Entropy value recorded along the flow. -/
  entropyValueAlongFlow : ℝ → ℝ
  /-- Dissipation term driving monotonicity. -/
  entropyDissipationAlongFlow : ℝ → ℝ
  /-- Dissipation is nonnegative on the controlled interval. -/
  entropyDissipationAlongFlowNonnegative :
    ∀ t, t ∈ entropyMonotonicityTimeInterval →
      0 ≤ entropyDissipationAlongFlow t
  /-- Defect term in the entropy-monotonicity identity. -/
  entropyMonotonicityDefect : ℝ → ℝ
  /-- Monotonicity defects are nonnegative on the controlled interval. -/
  entropyMonotonicityDefectNonnegative :
    ∀ t, t ∈ entropyMonotonicityTimeInterval →
      0 ≤ entropyMonotonicityDefect t
  /-- Monotonicity defects are controlled by first-variation defects. -/
  entropyMonotonicityDefect_le_firstVariationDefect :
    ∀ t variation,
      t ∈ entropyMonotonicityTimeInterval →
        entropyMonotonicityDefect t ≤
          entropyFirstVariationPayload.entropyFirstVariationDefect variation
  /-- Time derivative of the recorded entropy value. -/
  entropyDerivativeAlongFlow : ℝ → ℝ
  /-- Derivative identity: entropy grows by dissipation up to controlled defect. -/
  entropyDerivative_eq_dissipation_sub_defect :
    ∀ t, t ∈ entropyMonotonicityTimeInterval →
      entropyDerivativeAlongFlow t =
        entropyDissipationAlongFlow t - entropyMonotonicityDefect t
  /-- The recorded entropy value is monotone on the controlled interval. -/
  entropyValue_monotone_on_interval :
    ∀ t₁ t₂,
      t₁ ∈ entropyMonotonicityTimeInterval →
      t₂ ∈ entropyMonotonicityTimeInterval →
      t₁ ≤ t₂ →
        entropyValueAlongFlow t₁ ≤ entropyValueAlongFlow t₂

