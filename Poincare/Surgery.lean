    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    (postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload) :
    Type (u + 1) where
  /-- Region where the post-surgery metric is controlled. -/
  metricControlRegion : scalePayload.scaleParameterSpace → Set M
  /-- Persisted canonical neighborhoods lie in the metric-control region. -/
  persistedCanonicalNeighborhoodRegion_subset_metricControlRegion :
    ∀ parameter x,
      x ∈
        postSurgeryCanonicalNeighborhoodPersistencePayload.persistedCanonicalNeighborhoodRegion
          parameter →
        x ∈ metricControlRegion parameter
  /-- The constructed cap lies in the metric-control region. -/
  constructedCapRegion_subset_metricControlRegion :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ metricControlRegion parameter
  /-- The metric-control region stays on the persisted canonical or cap locus. -/
  metricControlRegion_subset_persistedCanonical_or_cap :
    ∀ parameter x,
      x ∈ metricControlRegion parameter →
        x ∈
            postSurgeryCanonicalNeighborhoodPersistencePayload.persistedCanonicalNeighborhoodRegion
              parameter ∨
          x ∈ capConstructionPayload.constructedCapRegion parameter
  /-- Scale on which the post-surgery metric comparison is controlled. -/
  postSurgeryMetricControlScale : scalePayload.scaleParameterSpace → ℝ
  /-- The post-surgery metric-control scale is positive. -/
  postSurgeryMetricControlScalePositive :
    ∀ parameter, 0 < postSurgeryMetricControlScale parameter
  /-- Canonical-neighborhood persistence occurs below the metric-control scale. -/
  postSurgeryCanonicalNeighborhoodScale_le_metricControlScale :
    ∀ parameter,
      postSurgeryCanonicalNeighborhoodPersistencePayload.postSurgeryCanonicalNeighborhoodScale
          parameter ≤
        postSurgeryMetricControlScale parameter
  /-- The metric-control scale remains below the separated canonical-neighborhood scale. -/
  postSurgeryMetricControlScale_le_separatedScale :
    ∀ parameter,
      postSurgeryMetricControlScale parameter ≤
        separationPayload.canonicalNeighborhoodScale parameter
  /-- Time window on which post-surgery metric control is asserted. -/
  postSurgeryMetricControlTimeWindow :
    scalePayload.scaleParameterSpace → Set ℝ
  /-- The canonical-neighborhood persistence window lies in the metric-control window. -/
  persistenceWindow_subset_metricControlWindow :
    ∀ parameter t,
      t ∈
        postSurgeryCanonicalNeighborhoodPersistencePayload.postSurgeryPersistenceTimeWindow
          parameter →
        t ∈ postSurgeryMetricControlTimeWindow parameter
  /-- Distinguished post-surgery time for the metric-control estimates. -/
  postSurgeryMetricControlBaseTime :
    scalePayload.scaleParameterSpace → ℝ
  /-- The distinguished metric-control time belongs to the metric-control window. -/
  postSurgeryMetricControlBaseTime_mem :
    ∀ parameter,
      postSurgeryMetricControlBaseTime parameter ∈
        postSurgeryMetricControlTimeWindow parameter
  /-- Reference real-valued metric profile used for comparison. -/
  referenceMetricProfile : scalePayload.scaleParameterSpace → M → ℝ
  /-- Post-surgery real-valued metric profile on the control region. -/
  postSurgeryMetricProfile : scalePayload.scaleParameterSpace → M → ℝ
  /-- Real-valued distortion between reference and post-surgery metric profiles. -/
  postSurgeryMetricDistortion : scalePayload.scaleParameterSpace → M → ℝ
  /-- Metric distortion is nonnegative on the control region. -/
  postSurgeryMetricDistortionNonnegative :
    ∀ parameter x,
      x ∈ metricControlRegion parameter →
        0 ≤ postSurgeryMetricDistortion parameter x
  /-- The reference profile is controlled by the post-surgery profile plus distortion. -/
  referenceMetricProfile_le_postSurgeryMetricProfile_plus_distortion :
    ∀ parameter x,
      x ∈ metricControlRegion parameter →
        referenceMetricProfile parameter x ≤
          postSurgeryMetricProfile parameter x +
            postSurgeryMetricDistortion parameter x
  /-- The post-surgery profile is controlled by the reference profile plus distortion. -/
  postSurgeryMetricProfile_le_referenceMetricProfile_plus_distortion :
    ∀ parameter x,
      x ∈ metricControlRegion parameter →
        postSurgeryMetricProfile parameter x ≤
          referenceMetricProfile parameter x +
            postSurgeryMetricDistortion parameter x
  /-- Uniform metric-distortion bound at each scale parameter. -/
  postSurgeryMetricDistortionBound :
    scalePayload.scaleParameterSpace → ℝ
  /-- Metric-distortion bounds are nonnegative. -/
  postSurgeryMetricDistortionBoundNonnegative :
    ∀ parameter, 0 ≤ postSurgeryMetricDistortionBound parameter
  /-- Real-valued defect in the post-surgery metric-control comparison. -/
  postSurgeryMetricControlDefect :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- Metric-control defects are nonnegative on the metric-control region. -/
  postSurgeryMetricControlDefectNonnegative :
    ∀ parameter x,
      x ∈ metricControlRegion parameter →
        0 ≤ postSurgeryMetricControlDefect parameter x
  /-- Metric distortion is bounded by the uniform bound plus defect. -/
  postSurgeryMetricDistortion_le_bound_plus_defect :
    ∀ parameter x,
      x ∈ metricControlRegion parameter →
        postSurgeryMetricDistortion parameter x ≤
          postSurgeryMetricDistortionBound parameter +
            postSurgeryMetricControlDefect parameter x
  /-- Metric-control defects are controlled by canonical-neighborhood defects. -/
  postSurgeryMetricControlDefect_le_canonicalNeighborhoodDefect :
    ∀ parameter x,
      x ∈
        postSurgeryCanonicalNeighborhoodPersistencePayload.persistedCanonicalNeighborhoodRegion
          parameter →
        postSurgeryMetricControlDefect parameter x ≤
          postSurgeryCanonicalNeighborhoodPersistencePayload.postSurgeryCanonicalNeighborhoodDefect
            parameter x
  /-- Metric-control defects are controlled by derivative defects on the derivative region. -/
  postSurgeryMetricControlDefect_le_derivativeDefect :
    ∀ parameter x,
      x ∈ postSurgeryDerivativeBoundsPayload.derivativeControlRegion
          parameter →
        postSurgeryMetricControlDefect parameter x ≤
          postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect
            0 parameter x

/--
Concrete discreteness data for surgery times after post-surgery metric control.

The payload is tied to explicit post-surgery metric-control data. It records a
countable surgery-time sequence for each scale parameter, event regions lying
inside the metric-control region, membership of those times in the metric-control
time window, and positive separation data controlling successive surgery events.
-/
structure SurgeryTimeDiscretenessPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    (postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload) :
    Type (u + 1) where
  /-- Surgery time assigned to each indexed surgery event. -/
  surgeryTime : scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Spatial event region attached to each indexed surgery time. -/
  surgeryTimeEventRegion :
    scalePayload.scaleParameterSpace → ℕ → Set M
  /-- Each surgery event region lies in the post-surgery metric-control region. -/
  surgeryTimeEventRegion_subset_metricControlRegion :
    ∀ parameter eventIndex x,
      x ∈ surgeryTimeEventRegion parameter eventIndex →
        x ∈ postSurgeryMetricControlPayload.metricControlRegion parameter
  /-- Surgery times lie in the metric-control time window. -/
  surgeryTime_mem_metricControlWindow :
    ∀ parameter eventIndex,
      surgeryTime parameter eventIndex ∈
        postSurgeryMetricControlPayload.postSurgeryMetricControlTimeWindow
          parameter
  /-- Successive indexed surgery times are strictly ordered. -/
  surgeryTime_strictlyOrdered :
    ∀ parameter eventIndex,
      surgeryTime parameter eventIndex <
        surgeryTime parameter (eventIndex + 1)
  /-- Positive lower separation scale for successive surgery times. -/
  surgeryTimeSeparationScale : scalePayload.scaleParameterSpace → ℝ
  /-- The surgery-time separation scale is positive. -/
  surgeryTimeSeparationScalePositive :
    ∀ parameter, 0 < surgeryTimeSeparationScale parameter
  /-- Real-valued defect in the successive surgery-time separation estimate. -/
  surgeryTimeSeparationDefect :
    scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Surgery-time separation defects are nonnegative. -/
  surgeryTimeSeparationDefectNonnegative :
    ∀ parameter eventIndex,
      0 ≤ surgeryTimeSeparationDefect parameter eventIndex
  /-- Successive surgery times are separated by the chosen scale up to defect. -/
  surgeryTime_gap_control :
    ∀ parameter eventIndex,
      surgeryTime parameter eventIndex +
          surgeryTimeSeparationScale parameter ≤
        surgeryTime parameter (eventIndex + 1) +
          surgeryTimeSeparationDefect parameter eventIndex
  /-- The separation scale is controlled by the post-surgery metric-control scale. -/
  surgeryTimeSeparationScale_le_metricControlScale :
    ∀ parameter,
      surgeryTimeSeparationScale parameter ≤
        postSurgeryMetricControlPayload.postSurgeryMetricControlScale
          parameter
  /-- Surgery-time separation defects are bounded by metric-control distortion. -/
  surgeryTimeSeparationDefect_le_metricDistortionBound :
    ∀ parameter eventIndex,
      surgeryTimeSeparationDefect parameter eventIndex ≤
        postSurgeryMetricControlPayload.postSurgeryMetricDistortionBound
          parameter
  /-- Distinct indexed surgery events have distinct surgery times. -/
  surgeryTime_injective :
    ∀ parameter eventIndex otherIndex,
      surgeryTime parameter eventIndex =
          surgeryTime parameter otherIndex →
        eventIndex = otherIndex

/--
Concrete local-finiteness data for surgery times on bounded time intervals.

The payload is tied to explicit surgery-time-discreteness data. It records, for
each bounded real time interval, a natural bound on the indices of surgery
events whose surgery times lie in that interval, together with the corresponding
active spatial region inside the post-surgery metric-control region.
-/
structure SurgeryTimeLocalFinitenessPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    {postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload}
    (surgeryTimeDiscretenessPayload :
      SurgeryTimeDiscretenessPayload postSurgeryMetricControlPayload) :
    Type (u + 1) where
  /-- Natural index bound for surgery events in a bounded time interval. -/
  surgeryTimeIntervalEventBound :
    scalePayload.scaleParameterSpace → ℝ → ℝ → ℕ
  /-- Events whose surgery times lie in the interval have index below the bound. -/
  surgeryTime_index_le_intervalEventBound :
    ∀ parameter intervalStart intervalEnd eventIndex,
      intervalStart ≤
          surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex →
        surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          intervalEnd →
          eventIndex ≤
            surgeryTimeIntervalEventBound parameter intervalStart intervalEnd
  /-- Active spatial region for surgery events in a bounded time interval. -/
  surgeryTimeIntervalActiveRegion :
    scalePayload.scaleParameterSpace → ℝ → ℝ → Set M
  /-- Event regions whose times lie in the interval are contained in the active region. -/
  surgeryTimeEventRegion_subset_intervalActiveRegion :
    ∀ parameter intervalStart intervalEnd eventIndex x,
      intervalStart ≤
          surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex →
        surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          intervalEnd →
          x ∈ surgeryTimeDiscretenessPayload.surgeryTimeEventRegion
            parameter eventIndex →
            x ∈
              surgeryTimeIntervalActiveRegion parameter intervalStart
                intervalEnd
  /-- Interval-active regions lie inside the post-surgery metric-control region. -/
  surgeryTimeIntervalActiveRegion_subset_metricControlRegion :
    ∀ parameter intervalStart intervalEnd x,
      x ∈ surgeryTimeIntervalActiveRegion parameter intervalStart
          intervalEnd →
        x ∈ postSurgeryMetricControlPayload.metricControlRegion parameter
  /-- Width of the bounded interval used by the local-finiteness bookkeeping. -/
  surgeryTimeIntervalWidth :
    scalePayload.scaleParameterSpace → ℝ → ℝ → ℝ
  /-- The recorded interval width is the real endpoint difference. -/
  surgeryTimeIntervalWidth_eq :
    ∀ parameter intervalStart intervalEnd,
      surgeryTimeIntervalWidth parameter intervalStart intervalEnd =
        intervalEnd - intervalStart
  /-- The recorded width is nonnegative when the interval endpoints are ordered. -/
  surgeryTimeIntervalWidthNonnegative :
    ∀ parameter intervalStart intervalEnd,
      intervalStart ≤ intervalEnd →
        0 ≤ surgeryTimeIntervalWidth parameter intervalStart intervalEnd
  /-- Interval-active events remain in the post-surgery metric-control time window. -/
  surgeryTime_interval_event_mem_metricControlWindow :
    ∀ parameter intervalStart intervalEnd eventIndex,
      intervalStart ≤
          surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex →
        surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          intervalEnd →
          surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ∈
            postSurgeryMetricControlPayload.postSurgeryMetricControlTimeWindow
              parameter
  /-- The interval event bound is compatible with the previous event index. -/
  previousEventIndex_le_intervalEventBound_of_next_mem :
    ∀ parameter intervalStart intervalEnd eventIndex,
      intervalStart ≤
          surgeryTimeDiscretenessPayload.surgeryTime parameter
            (eventIndex + 1) →
        surgeryTimeDiscretenessPayload.surgeryTime parameter
            (eventIndex + 1) ≤ intervalEnd →
          eventIndex ≤
            surgeryTimeIntervalEventBound parameter intervalStart intervalEnd

/--
Concrete long-time existence iteration data after surgery-time local finiteness.

The payload is tied to the local-finiteness data for surgery times. It records
an unbounded sequence of continuation times, finite event bounds for each
iteration interval, and spatial control regions for the events encountered
during that interval.
-/
structure LongTimeExistenceIterationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    {postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload}
    {surgeryTimeDiscretenessPayload :
      SurgeryTimeDiscretenessPayload postSurgeryMetricControlPayload}
    (surgeryTimeLocalFinitenessPayload :
      SurgeryTimeLocalFinitenessPayload
        surgeryTimeDiscretenessPayload) :
    Type (u + 1) where
  /-- Long-time iteration times for each scale parameter. -/
  iterationTime : scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Time window covered by the long-time iteration. -/
  iterationTimeWindow : scalePayload.scaleParameterSpace → Set ℝ
  /-- The post-surgery metric-control window is contained in the iteration window. -/
  metricControlWindow_subset_iterationTimeWindow :
    ∀ parameter t,
      t ∈ postSurgeryMetricControlPayload.postSurgeryMetricControlTimeWindow
          parameter →
        t ∈ iterationTimeWindow parameter
  /-- Iteration times lie in the long-time iteration window. -/
  iterationTime_mem_window :
    ∀ parameter step,
      iterationTime parameter step ∈ iterationTimeWindow parameter
  /-- The iteration starts at the post-surgery metric-control base time. -/
  iterationTime_zero_eq_metricControlBaseTime :
    ∀ parameter,
      iterationTime parameter 0 =
        postSurgeryMetricControlPayload.postSurgeryMetricControlBaseTime
          parameter
  /-- Successive iteration times are strictly ordered. -/
  iterationTime_strictlyOrdered :
    ∀ parameter step,
      iterationTime parameter step < iterationTime parameter (step + 1)
  /-- The iteration times are cofinal in real time. -/
  iterationTime_cofinal :
    ∀ parameter targetTime,
      ∃ step : ℕ, targetTime ≤ iterationTime parameter step
  /-- Finite surgery-event bound used on each iteration interval. -/
  iterationStepEventBound :
    scalePayload.scaleParameterSpace → ℕ → ℕ
  /-- Local-finiteness bounds are absorbed by the iteration-step event bound. -/
  localFinitenessBound_le_iterationStepEventBound :
    ∀ parameter step,
      surgeryTimeLocalFinitenessPayload.surgeryTimeIntervalEventBound
          parameter (iterationTime parameter step)
          (iterationTime parameter (step + 1)) ≤
        iterationStepEventBound parameter step
  /-- Spatial control region for a long-time iteration step. -/
  iterationStepControlRegion :
    scalePayload.scaleParameterSpace → ℕ → Set M
  /-- The interval-active surgery region lies in the iteration-step control region. -/
  intervalActiveRegion_subset_iterationStepControlRegion :
    ∀ parameter step x,
      x ∈ surgeryTimeLocalFinitenessPayload.surgeryTimeIntervalActiveRegion
          parameter
            (iterationTime parameter step)
            (iterationTime parameter (step + 1)) →
        x ∈ iterationStepControlRegion parameter step
  /-- Iteration-step control regions lie inside the post-surgery metric-control region. -/
  iterationStepControlRegion_subset_metricControlRegion :
    ∀ parameter step x,
      x ∈ iterationStepControlRegion parameter step →
        x ∈ postSurgeryMetricControlPayload.metricControlRegion parameter
  /-- Real-valued defect for the continuation step. -/
  iterationStepDefect : scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Iteration-step defects are nonnegative. -/
  iterationStepDefectNonnegative :
    ∀ parameter step, 0 ≤ iterationStepDefect parameter step
  /-- Iteration-step defects are controlled by the metric-distortion bound. -/
  iterationStepDefect_le_metricDistortionBound :
    ∀ parameter step,
      iterationStepDefect parameter step ≤
        postSurgeryMetricControlPayload.postSurgeryMetricDistortionBound
          parameter

/--
Concrete coherence data for surgery-parameter choices through the long-time
iteration.

The payload is tied to the explicit long-time existence iteration data. It
records the surgery parameter used on each iteration step and on each bounded
surgery event in that step, proves those choices agree with the original
surgery-parameter selection, and keeps the resulting coherence defect below the
iteration-step defect already recorded by the long-time iteration payload.
-/
structure LongTimeSurgeryParameterCoherencePayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    {postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload}
    {surgeryTimeDiscretenessPayload :
      SurgeryTimeDiscretenessPayload postSurgeryMetricControlPayload}
    {surgeryTimeLocalFinitenessPayload :
      SurgeryTimeLocalFinitenessPayload
        surgeryTimeDiscretenessPayload}
    (longTimeExistenceIterationPayload :
      LongTimeExistenceIterationPayload
        surgeryTimeLocalFinitenessPayload) :
    Type (u + 1) where
  /-- Surgery parameter used on a long-time iteration step. -/
  iterationSurgeryParameter :
    scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- The iteration-step parameter agrees with the selected surgery parameter. -/
  iterationSurgeryParameter_eq_selected :
    ∀ parameter step,
      iterationSurgeryParameter parameter step =
        parameterSelectionPayload.surgeryParameter parameter
  /-- Iteration-step surgery parameters are positive. -/
  iterationSurgeryParameterPositive :
    ∀ parameter step, 0 < iterationSurgeryParameter parameter step
  /-- Iteration-step surgery parameters remain before the cutoff threshold. -/
  iterationSurgeryParameter_lt_cutoffParameter :
    ∀ parameter step,
      iterationSurgeryParameter parameter step <
        cutoffPayload.cutoffParameter parameter
  /-- The cutoff bump is still in its plateau at each iteration-step parameter. -/
  cutoffBump_eq_one_at_iterationSurgeryParameter :
    ∀ parameter step,
      smoothBumpPayload.cutoffBump parameter
          (iterationSurgeryParameter parameter step) = 1
  /-- Iteration-step surgery parameters remain below the neck-detection scale. -/
  iterationSurgeryParameter_le_neckDetectionScale :
    ∀ parameter step,
      iterationSurgeryParameter parameter step ≤
        strongDeltaPayload.neckDetectionScale parameter
  /-- Standard cap scales remain controlled by the iteration-step parameter. -/
  standardCapScale_le_iterationSurgeryParameter :
    ∀ parameter step,
      standardCapModelPayload.standardCapScale parameter ≤
        iterationSurgeryParameter parameter step
  /-- Surgery parameter recorded for each bounded event in an iteration step. -/
  eventSurgeryParameter :
    scalePayload.scaleParameterSpace → ℕ → ℕ → ℝ
  /-- Bounded-event parameters agree with the iteration-step parameter. -/
  eventSurgeryParameter_eq_iteration_of_bounded :
    ∀ parameter step eventIndex,
      eventIndex ≤
          longTimeExistenceIterationPayload.iterationStepEventBound
            parameter step →
        eventSurgeryParameter parameter step eventIndex =
          iterationSurgeryParameter parameter step
  /-- Bounded-event parameters remain before the cutoff threshold. -/
  eventSurgeryParameter_lt_cutoffParameter_of_bounded :
    ∀ parameter step eventIndex,
      eventIndex ≤
          longTimeExistenceIterationPayload.iterationStepEventBound
            parameter step →
        eventSurgeryParameter parameter step eventIndex <
          cutoffPayload.cutoffParameter parameter
  /-- Real-valued defect in the long-time parameter-coherence bookkeeping. -/
  parameterCoherenceDefect :
    scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Parameter-coherence defects are nonnegative. -/
  parameterCoherenceDefectNonnegative :
    ∀ parameter step, 0 ≤ parameterCoherenceDefect parameter step
  /-- Parameter-coherence defects are controlled by the iteration-step defect. -/
  parameterCoherenceDefect_le_iterationStepDefect :
    ∀ parameter step,
      parameterCoherenceDefect parameter step ≤
        longTimeExistenceIterationPayload.iterationStepDefect parameter step

/--
Concrete nonaccumulation data for long-time surgery events.

The payload is tied to the long-time surgery-parameter coherence data. It
records, for every target time, a cofinal iteration step reaching beyond that
