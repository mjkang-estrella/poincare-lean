  singularityModelBlowupClassificationPayload_source :
    ∃ source : SingularityModelClassificationPayloadSource flow,
      Function.Surjective source.singularityModelToPointedRescalingIndex

/--
Construct blow-up classification from a classification source whose models
cover all pointed rescaling indices.
-/
def HasSingularityModelBlowupClassification.of_classification_payload_source
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    (source : SingularityModelClassificationPayloadSource flow)
    (hCoverage :
      Function.Surjective source.singularityModelToPointedRescalingIndex) :
    HasSingularityModelBlowupClassification flow :=
  ⟨⟨source, hCoverage⟩⟩

/-- Blow-up classification retains the underlying singularity-model data. -/
def HasSingularityModelBlowupClassification.to_singularityModelClassification
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    (classification : HasSingularityModelBlowupClassification flow) :
    HasSingularityModelClassification flow := by
  rcases classification.singularityModelBlowupClassificationPayload_source with
    ⟨source, _hCoverage⟩
  exact ⟨⟨source⟩⟩

/--
Concrete aggregate Perelman singularity-control data.

The payload is tied to the high-level Perelman inputs that feed the aggregate
control theorem: no-local-collapsing, reduced-volume monotonicity, canonical
neighborhoods, and singularity-model classification. It records the controlled
scale, the high-curvature region covered by canonical neighborhoods and
classified models, and a bounded aggregate defect.
-/
structure PerelmanSingularityControlPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (_noLocalCollapsing : HasPerelmanNoLocalCollapsing flow)
    (_reducedVolume : HasPerelmanReducedVolumeMonotonicity flow)
    (_canonicalNeighborhood : HasCanonicalNeighborhoodTheorem flow)
    (_singularityModelClassification :
      HasSingularityModelClassification flow)
    (_singularityModelBlowupClassification :
      HasSingularityModelBlowupClassification flow) : Type (u + 1) where
  /-- Scale on which the aggregate singularity-control theorem is asserted. -/
  singularityControlScale : ℝ
  /-- The singularity-control scale is positive. -/
  singularityControlScalePositive : 0 < singularityControlScale
  /-- Reduced-volume lower bound used to prevent local collapse. -/
  reducedVolumeLowerBound : ℝ
  /-- The reduced-volume lower bound is positive. -/
  reducedVolumeLowerBoundPositive : 0 < reducedVolumeLowerBound
  /-- Kappa-noncollapsing scale obtained from no-local-collapsing input. -/
  kappaNoncollapsingScale : ℝ
  /-- The kappa-noncollapsing scale is positive. -/
  kappaNoncollapsingScalePositive : 0 < kappaNoncollapsingScale
  /-- Canonical-neighborhood scale used in high-curvature regions. -/
  canonicalNeighborhoodScale : ℝ
  /-- The canonical-neighborhood scale is positive. -/
  canonicalNeighborhoodScalePositive : 0 < canonicalNeighborhoodScale
  /-- Region where singularity control is required. -/
  highCurvatureRegion : Set M
  /-- Region covered by canonical neighborhoods. -/
  canonicalNeighborhoodRegion : Set M
  /-- High-curvature points lie in canonical neighborhoods. -/
  highCurvatureRegion_subset_canonicalNeighborhoodRegion :
    ∀ x, x ∈ highCurvatureRegion → x ∈ canonicalNeighborhoodRegion
  /-- Region covered by classified singularity models. -/
  singularityModelRegion : Set M
  /-- Canonical-neighborhood regions are covered by classified models. -/
  canonicalNeighborhoodRegion_subset_singularityModelRegion :
    ∀ x, x ∈ canonicalNeighborhoodRegion → x ∈ singularityModelRegion
  /-- Blow-up model region supporting the classified singularity models. -/
  blowupModelRegion : Set M
  /-- Classified singularity-model regions are covered by blow-up models. -/
  singularityModelRegion_subset_blowupModelRegion :
    ∀ x, x ∈ singularityModelRegion → x ∈ blowupModelRegion
  /-- Real-valued defect in the aggregate singularity-control conclusion. -/
  singularityControlDefect : ℝ
  /-- The aggregate singularity-control defect is nonnegative. -/
  singularityControlDefectNonnegative : 0 ≤ singularityControlDefect
  /-- Bound for the aggregate singularity-control defect. -/
  singularityControlDefectBound : ℝ
  /-- The aggregate singularity-control defect bound is nonnegative. -/
  singularityControlDefectBoundNonnegative :
    0 ≤ singularityControlDefectBound
  /-- The aggregate singularity-control defect is bounded. -/
  singularityControlDefect_le_bound :
    singularityControlDefect ≤ singularityControlDefectBound

/--
Interface for Perelman's singularity-control package: non-collapsing,
canonical neighborhoods, and the estimates needed to control surgery.
-/
structure HasPerelmanSingularityControl
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M) : Prop where
  perelmanSingularityControlPayload_source :
    ∃ noLocalCollapsing : HasPerelmanNoLocalCollapsing flow,
      ∃ reducedVolume : HasPerelmanReducedVolumeMonotonicity flow,
        ∃ canonicalNeighborhood : HasCanonicalNeighborhoodTheorem flow,
          ∃ singularityModelClassification :
            HasSingularityModelClassification flow,
            ∃ singularityModelBlowupClassification :
              HasSingularityModelBlowupClassification flow,
              Nonempty
