      CanonicalNeighborhoodStabilityPayload scaleControlPayload) :
    Type (u + 1) where
  /-- Parameter space of cross-scale canonical-neighborhood transitions. -/
  persistenceScaleTransitionSpace : Type u
  /-- Distinguished transition used by downstream package data. -/
  basePersistenceScaleTransition : persistenceScaleTransitionSpace
  /-- Source stable model in a cross-scale transition. -/
  persistenceSourceModel :
    persistenceScaleTransitionSpace → stabilityPayload.stabilityModelFamily
  /-- Target stable model in a cross-scale transition. -/
  persistenceTargetModel :
    persistenceScaleTransitionSpace → stabilityPayload.stabilityModelFamily
  /-- Source canonical scale of a transition. -/
  persistenceSourceScale : persistenceScaleTransitionSpace → ℝ
  /-- Source scales agree with the stability scale of the source model. -/
  persistenceSourceScale_eq_stabilityScale :
    ∀ transition,
      persistenceSourceScale transition =
        stabilityPayload.stabilityScale
          (persistenceSourceModel transition)
  /-- Target canonical scale of a transition. -/
  persistenceTargetScale : persistenceScaleTransitionSpace → ℝ
  /-- Target scales agree with the stability scale of the target model. -/
  persistenceTargetScale_eq_stabilityScale :
    ∀ transition,
      persistenceTargetScale transition =
        stabilityPayload.stabilityScale
          (persistenceTargetModel transition)
  /-- Scale ratio controlling comparison between source and target scales. -/
  persistenceScaleRatio : persistenceScaleTransitionSpace → ℝ
  /-- Cross-scale ratios are positive. -/
  persistenceScaleRatioPositive :
    ∀ transition, 0 < persistenceScaleRatio transition
  /-- The ratio records target scale divided by source scale. -/
  persistenceScaleRatio_eq_target_div_source :
    ∀ transition,
      persistenceScaleRatio transition =
        persistenceTargetScale transition / persistenceSourceScale transition
  /-- Approximation defect for transporting canonical-neighborhood control. -/
  persistenceApproximationDefect : persistenceScaleTransitionSpace → ℝ
  /-- Cross-scale approximation defects are nonnegative. -/
  persistenceApproximationDefectNonnegative :
    ∀ transition, 0 ≤ persistenceApproximationDefect transition
  /-- Envelope controlling all cross-scale persistence data. -/
  persistenceEnvelope : ℝ
  /-- The persistence envelope is nonnegative. -/
  persistenceEnvelopeNonnegative : 0 ≤ persistenceEnvelope
  /-- Stability control is absorbed by the cross-scale persistence envelope. -/
  stabilityEnvelope_le_persistenceEnvelope :
    stabilityPayload.stabilityEnvelope ≤ persistenceEnvelope
  /-- Cross-scale approximation defects are bounded by the envelope. -/
  persistenceApproximationDefect_le_envelope :
    ∀ transition,
      persistenceApproximationDefect transition ≤ persistenceEnvelope
  /-- Cross-scale ratios are bounded by the envelope. -/
  persistenceScaleRatio_le_envelope :
    ∀ transition, persistenceScaleRatio transition ≤ persistenceEnvelope

