        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    (reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload) : Type (u + 1) where
  /-- Scale on which reduced-Jacobian comparison is asserted. -/
  reducedJacobianComparisonScale : ℝ
  /-- The reduced-Jacobian comparison scale is positive. -/
  reducedJacobianComparisonScalePositive :
    0 < reducedJacobianComparisonScale
  /-- Cut-locus control lies within the reduced-Jacobian comparison scale. -/
  cutLocusControlScale_le_reducedJacobianComparisonScale :
    reducedDistanceCutLocusControlPayload.reducedDistanceCutLocusControlScale ≤
      reducedJacobianComparisonScale
  /-- Smooth comparison tests for reduced-Jacobian comparison. -/
  smoothReducedJacobianComparisonTestDomain : Type u
  /-- Smooth comparison tests map to smooth reduced-distance tests. -/
  smoothComparisonTestToReducedDistanceTest :
    smoothReducedJacobianComparisonTestDomain →
      reducedDistanceDifferentialInequalityPayload.smoothReducedDistanceTestDomain
  /-- Point represented by each smooth comparison test. -/
  smoothComparisonTestPoint :
    smoothReducedJacobianComparisonTestDomain → M
  /-- Smooth comparison points agree with the cut-locus payload's smooth tests. -/
  smoothComparisonTestPoint_eq :
    ∀ test,
      smoothComparisonTestPoint test =
        reducedDistanceCutLocusControlPayload.smoothTestPoint
          (smoothComparisonTestToReducedDistanceTest test)
  /-- Reduced-Jacobian value at each smooth comparison test. -/
  smoothReducedJacobianValue :
    smoothReducedJacobianComparisonTestDomain → ℝ
  /-- Smooth reduced-Jacobian values are nonnegative. -/
  smoothReducedJacobianValueNonnegative :
    ∀ test, 0 ≤ smoothReducedJacobianValue test
  /-- Model Jacobian value used for comparison. -/
  smoothModelJacobianValue :
    smoothReducedJacobianComparisonTestDomain → ℝ
  /-- Model Jacobian values are nonnegative. -/
  smoothModelJacobianValueNonnegative :
    ∀ test, 0 ≤ smoothModelJacobianValue test
  /-- Smooth reduced-Jacobian values are bounded by their model values. -/
  smoothReducedJacobianValue_le_modelJacobianValue :
    ∀ test,
      smoothReducedJacobianValue test ≤
        smoothModelJacobianValue test
  /-- Smooth reduced-Jacobian estimate bound. -/
  smoothReducedJacobianBound : ℝ
  /-- The smooth reduced-Jacobian bound is nonnegative. -/
  smoothReducedJacobianBoundNonnegative :
    0 ≤ smoothReducedJacobianBound
  /-- Smooth reduced-Jacobian values are bounded by the smooth bound. -/
  smoothReducedJacobianValue_le_smoothBound :
    ∀ test,
      smoothReducedJacobianValue test ≤ smoothReducedJacobianBound
  /-- Barrier comparison tests for cut-locus points. -/
  barrierReducedJacobianComparisonTestDomain : Type u
  /-- Barrier comparison tests map to cut-locus barrier tests. -/
  barrierComparisonTestToCutLocusBarrierTest :
    barrierReducedJacobianComparisonTestDomain →
      reducedDistanceDifferentialInequalityPayload.barrierReducedDistanceTestDomain
  /-- Point represented by each barrier comparison test. -/
  barrierComparisonTestPoint :
    barrierReducedJacobianComparisonTestDomain → M
  /-- Barrier comparison points agree with the cut-locus payload's barrier tests. -/
  barrierComparisonTestPoint_eq :
    ∀ test,
      barrierComparisonTestPoint test =
        reducedDistanceCutLocusControlPayload.barrierTestPoint
          (barrierComparisonTestToCutLocusBarrierTest test)
  /-- Reduced-Jacobian value at each barrier comparison test. -/
  barrierReducedJacobianValue :
    barrierReducedJacobianComparisonTestDomain → ℝ
  /-- Barrier reduced-Jacobian values are nonnegative. -/
  barrierReducedJacobianValueNonnegative :
    ∀ test, 0 ≤ barrierReducedJacobianValue test
  /-- Barrier reduced-Jacobian estimate bound. -/
  barrierReducedJacobianBound : ℝ
  /-- The barrier reduced-Jacobian bound is nonnegative. -/
  barrierReducedJacobianBoundNonnegative :
    0 ≤ barrierReducedJacobianBound
  /-- Barrier reduced-Jacobian values are bounded by the barrier bound. -/
  barrierReducedJacobianValue_le_barrierBound :
    ∀ test,
      barrierReducedJacobianValue test ≤ barrierReducedJacobianBound
  /-- Common envelope for smooth and barrier reduced-Jacobian comparison. -/
  reducedJacobianComparisonEnvelope : ℝ
  /-- The common reduced-Jacobian comparison envelope is nonnegative. -/
  reducedJacobianComparisonEnvelopeNonnegative :
    0 ≤ reducedJacobianComparisonEnvelope
  /-- The smooth comparison bound is absorbed by the common envelope. -/
  smoothReducedJacobianBound_le_envelope :
    smoothReducedJacobianBound ≤ reducedJacobianComparisonEnvelope
  /-- The barrier comparison bound is absorbed by the common envelope. -/
  barrierReducedJacobianBound_le_envelope :
    barrierReducedJacobianBound ≤ reducedJacobianComparisonEnvelope

