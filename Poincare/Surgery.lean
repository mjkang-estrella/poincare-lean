        classificationPayload.classificationLabelOfModel
          (canonicalNeighborhoodRegionToModel region)
  /-- Every theorem-level region is classified as a neck or a cap. -/
  canonicalNeighborhoodRegionClass_neck_or_cap :
    ∀ region,
      classificationPayload.isEpsilonNeckClass
          (canonicalNeighborhoodRegionClassLabel region) ∨
        classificationPayload.isEpsilonCapClass
          (canonicalNeighborhoodRegionClassLabel region)
  /-- The theorem-level neck scale assigned to a covered region. -/
  canonicalNeighborhoodRegionNeckScale :
