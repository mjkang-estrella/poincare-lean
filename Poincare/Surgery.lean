/--
Concrete reduced-volume definition data for the Perelman package.

The payload is tied to reduced-distance theory. It records the integration
domain, the map into the reduced-distance theory domain, the reduced-volume
density and kernel data, an abstract aggregation functional, and bounds for the
resulting reduced-volume quantity used by downstream derivative formulas.
-/
structure PerelmanReducedVolumeDefinitionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    (reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload) : Type (u + 1) where
  /-- Scale on which the reduced-volume definition is asserted. -/
  reducedVolumeDefinitionScale : ℝ
  /-- The reduced-volume definition scale is positive. -/
  reducedVolumeDefinitionScalePositive :
    0 < reducedVolumeDefinitionScale
  /-- Reduced-distance theory lies within the reduced-volume definition scale. -/
  reducedDistanceTheoryScale_le_reducedVolumeDefinitionScale :
    reducedDistanceTheoryPayload.reducedDistanceTheoryScale ≤
      reducedVolumeDefinitionScale
  /-- Domain over which the reduced-volume density is aggregated. -/
  reducedVolumeIntegrationDomain : Type u
  /-- Integration-domain points map into the reduced-distance theory domain. -/
  reducedVolumePointToTheoryPoint :
    reducedVolumeIntegrationDomain →
      reducedDistanceTheoryPayload.reducedDistanceTheoryDomain
  /-- Reduced-distance value used in the reduced-volume density. -/
  reducedVolumeDistanceValue :
    reducedVolumeIntegrationDomain → ℝ
  /-- Reduced-volume distance values agree with the reduced-distance theory. -/
  reducedVolumeDistanceValue_eq_theoryValue :
    ∀ point,
      reducedVolumeDistanceValue point =
        reducedDistanceTheoryPayload.reducedDistanceTheoryValue
          (reducedVolumePointToTheoryPoint point)
  /-- Kernel factor in the reduced-volume density. -/
  reducedVolumeKernel : reducedVolumeIntegrationDomain → ℝ
  /-- The reduced-volume kernel is nonnegative. -/
  reducedVolumeKernelNonnegative :
    ∀ point, 0 ≤ reducedVolumeKernel point
  /-- Weight factor representing the evolving volume measure. -/
  reducedVolumeMeasureWeight :
    reducedVolumeIntegrationDomain → ℝ
  /-- The reduced-volume measure weights are nonnegative. -/
  reducedVolumeMeasureWeightNonnegative :
    ∀ point, 0 ≤ reducedVolumeMeasureWeight point
  /-- Reduced-volume density assembled from kernel and measure weight. -/
  reducedVolumeDensity : reducedVolumeIntegrationDomain → ℝ
  /-- The reduced-volume density is kernel times measure weight. -/
  reducedVolumeDensity_eq_kernel_mul_weight :
    ∀ point,
      reducedVolumeDensity point =
        reducedVolumeKernel point * reducedVolumeMeasureWeight point
  /-- Reduced-volume densities are nonnegative. -/
  reducedVolumeDensityNonnegative :
    ∀ point, 0 ≤ reducedVolumeDensity point
  /-- Reduced-volume densities are controlled by the reduced-distance envelope. -/
  reducedVolumeDensity_le_reducedDistanceTheoryEnvelope :
    ∀ point,
      reducedVolumeDensity point ≤
        reducedDistanceTheoryPayload.reducedDistanceTheoryEnvelope
  /-- Aggregation functional used to define the reduced volume. -/
  reducedVolumeAggregation :
    (reducedVolumeIntegrationDomain → ℝ) → ℝ
  /-- The reduced-volume value. -/
  reducedVolumeValue : ℝ
  /-- The reduced-volume value is the aggregation of the density. -/
  reducedVolumeValue_eq_aggregation :
    reducedVolumeValue = reducedVolumeAggregation reducedVolumeDensity
  /-- The reduced-volume value is nonnegative. -/
  reducedVolumeValueNonnegative :
    0 ≤ reducedVolumeValue
  /-- Common envelope for the reduced-volume definition data. -/
  reducedVolumeDefinitionEnvelope : ℝ
  /-- The reduced-volume definition envelope is nonnegative. -/
  reducedVolumeDefinitionEnvelopeNonnegative :
    0 ≤ reducedVolumeDefinitionEnvelope
  /-- The reduced-distance theory envelope is absorbed by the volume envelope. -/
  reducedDistanceTheoryEnvelope_le_reducedVolumeDefinitionEnvelope :
    reducedDistanceTheoryPayload.reducedDistanceTheoryEnvelope ≤
      reducedVolumeDefinitionEnvelope
  /-- The reduced-volume value is controlled by the definition envelope. -/
  reducedVolumeValue_le_definitionEnvelope :
    reducedVolumeValue ≤ reducedVolumeDefinitionEnvelope

/--
The density in the reduced-volume definition is controlled by the
reduced-volume definition envelope.
-/
theorem PerelmanReducedVolumeDefinitionPayload.reducedVolumeDensity_le_definitionEnvelope
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
