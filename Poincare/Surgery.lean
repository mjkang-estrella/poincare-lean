/--
Concrete entropy-functional data compatible with the propagated entropy lower
bound.

The payload is tied to lower-bound propagation data. It records the state space
on which the entropy functional is evaluated, the real-valued functional, and a
map from states to times in the propagated lower-bound interval.
-/
structure PerelmanEntropyFunctionalPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    (entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload) : Type (u + 1) where
  /-- Scale on which the entropy functional is controlled. -/
  entropyFunctionalScale : ℝ
  /-- The entropy-functional control scale is positive. -/
  entropyFunctionalScalePositive : 0 < entropyFunctionalScale
  /-- Lower-bound propagation control lies within the entropy-functional scale. -/
  entropyLowerBoundPropagationScale_le_entropyFunctionalScale :
    entropyLowerBoundPropagationPayload.entropyLowerBoundPropagationScale ≤
      entropyFunctionalScale
  /-- State space on which the entropy functional is evaluated. -/
  entropyStateSpace : Type u
  /-- Distinguished state for the entropy functional. -/
  baseEntropyState : entropyStateSpace
  /-- Time associated to each entropy state. -/
  entropyStateTime : entropyStateSpace → ℝ
  /-- State times lie in the propagated lower-bound interval. -/
  entropyStateTime_mem_lowerBoundInterval :
    ∀ state,
      entropyStateTime state ∈
        entropyLowerBoundPropagationPayload.entropyLowerBoundPropagationInterval
  /-- Real-valued entropy functional. -/
  entropyFunctionalValue : entropyStateSpace → ℝ
  /-- Functional values agree with the monotonicity payload's entropy values. -/
  entropyFunctionalValue_eq_entropyValue :
    ∀ state,
      entropyFunctionalValue state =
        entropyMonotonicityPayload.entropyValueAlongFlow
          (entropyStateTime state)
  /-- Lower bound stored with the entropy functional. -/
  entropyFunctionalLowerBound : ℝ
  /-- The functional lower bound is the propagated lower bound. -/
  entropyFunctionalLowerBound_eq :
    entropyFunctionalLowerBound =
      entropyLowerBoundPropagationPayload.entropyLowerBound
  /-- Defect term attached to the entropy functional. -/
  entropyFunctionalDefect : entropyStateSpace → ℝ
  /-- Entropy-functional defects are nonnegative. -/
  entropyFunctionalDefectNonnegative :
    ∀ state, 0 ≤ entropyFunctionalDefect state

/--
The lower bound stored by an entropy-functional payload controls every
functional value.
-/
theorem PerelmanEntropyFunctionalPayload.entropyFunctionalLowerBound_le_value
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    (payload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload)
    (state : payload.entropyStateSpace) :
    payload.entropyFunctionalLowerBound ≤
      payload.entropyFunctionalValue state := by
  rw [payload.entropyFunctionalLowerBound_eq,
    payload.entropyFunctionalValue_eq_entropyValue state]
  exact
    PerelmanEntropyLowerBoundPropagationPayload.entropyLowerBound_le_value
      entropyLowerBoundPropagationPayload
      (payload.entropyStateTime_mem_lowerBoundInterval state)

