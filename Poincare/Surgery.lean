  /-- Scale on which the canonical-neighborhood theorem is asserted. -/
  canonicalNeighborhoodTheoremScale : ℝ
  /-- The theorem scale is positive. -/
  canonicalNeighborhoodTheoremScalePositive :
    0 < canonicalNeighborhoodTheoremScale
  /-- Envelope controlling theorem-level canonical-neighborhood data. -/
  canonicalNeighborhoodTheoremEnvelope : ℝ
  /-- The theorem envelope is nonnegative. -/
  canonicalNeighborhoodTheoremEnvelopeNonnegative :
    0 ≤ canonicalNeighborhoodTheoremEnvelope
  /-- Classification control is absorbed by the theorem envelope. -/
  classificationEnvelope_le_theoremEnvelope :
    classificationPayload.classificationEnvelope ≤
      canonicalNeighborhoodTheoremEnvelope
  /-- Domain of regions covered by canonical neighborhoods. -/
  canonicalNeighborhoodTheoremRegionDomain : Type u
  /-- The classified neck/cap model assigned to a covered region. -/
  canonicalNeighborhoodRegionToModel :
    canonicalNeighborhoodTheoremRegionDomain →
      neckCapPayload.neckCapModelFamily
  /-- The theorem-level class label assigned to a covered region. -/
