        areaPayload widthPayload compactnessPayload
        lowerSemicontinuityPayload minimizingSequencePayload
        pullTightPayload) :
    Type (u + 1) where
  /-- Parameter representing the regular min-max slice. -/
  regularityParameter : sweepoutPayload.parameterSpace
  /-- The regularity parameter is the stationary min-max parameter. -/
  regularityMatchesStationaryParameter :
    regularityParameter = stationarityPayload.stationaryParameter
  /-- Slice represented by the regularity parameter. -/
  regularitySlice : Set M
  /-- The regularity slice is the sweepout slice at the regularity parameter. -/
  regularitySliceEq :
    regularitySlice = sweepoutPayload.slices regularityParameter
  /-- Witness point on the regularity slice. -/
  regularityWitnessPoint : M
  /-- The witness point lies on the regularity slice. -/
  regularityWitnessMem :
    regularityWitnessPoint ∈ regularitySlice
  /-- Parameter neighborhood used for the regularity certificate. -/
  regularityNeighborhood : Set sweepoutPayload.parameterSpace
  /-- The regularity parameter belongs to its regularity neighborhood. -/
  regularityParameterMemNeighborhood :
    regularityParameter ∈ regularityNeighborhood
  /-- Area of the regularity parameter is controlled by the chosen width. -/
  regularityAreaLeWidth :
    areaPayload.areaFunctional regularityParameter ≤ widthPayload.widthValue
  /-- The inherited first variation vanishes at the regularity parameter. -/
  regularityFirstVariationZero :
    stationarityPayload.firstVariationFunctional regularityParameter = 0

