/--
Concrete payload for tracking components that survive surgery before
extinction.

The payload is attached to the same surgery-discard-control payload and the
discarded-component classification payload. It records a component-tracking
map, identifies the retained component set from discard control as the tracked
surviving component, and keeps the retained witness and post-surgery width
control used by the tracking step.
-/
structure FiniteExtinctionSurvivingComponentTrackingPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory)
    (discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution) :
    Type (u + 1) where
  /-- Concrete surgery-discard-control payload whose retained component is tracked. -/
  surgeryDiscardControlPayload :
    FiniteExtinctionSurgeryDiscardControlPayload
      flow surgery control widthTheory widthEvolution
  /-- The abstract discard-control witness is built from the concrete payload. -/
  discardControlEq :
    discardControl =
      HasFiniteExtinctionSurgeryDiscardControl.of_surgery_discard_control_payload
        surgeryDiscardControlPayload
  /-- Discarded-component classification payload used before tracking survivors. -/
  classificationPayload :
    FiniteExtinctionDiscardedComponentClassificationPayload
      flow surgery control widthTheory widthEvolution discardControl
  /-- Indexing space for surviving components in the selected comparison. -/
  survivingComponentIndex : Type u
  /-- Component before the selected surgery comparison. -/
  preSurgerySurvivingComponent : survivingComponentIndex
  /-- Component after the selected surgery comparison. -/
  postSurgerySurvivingComponent : survivingComponentIndex
  /-- Tracking map from pre-surgery surviving components to post-surgery components. -/
  survivingComponentMap :
    survivingComponentIndex → survivingComponentIndex
  /-- The selected surviving component is tracked through the comparison. -/
  selectedSurvivingComponentTracked :
    survivingComponentMap preSurgerySurvivingComponent =
      postSurgerySurvivingComponent
  /-- The component set tracked as surviving surgery. -/
  survivingComponentSet : Set M
  /-- The surviving component set is the retained component set from discard control. -/
  survivingComponentSetEqRetained :
    survivingComponentSet =
      surgeryDiscardControlPayload.retainedComponentSet
  /-- Witness point showing the surviving component set is nonempty. -/
  survivingWitnessPoint : M
  /-- The surviving witness lies in the tracked surviving component set. -/
  survivingWitnessMem :
    survivingWitnessPoint ∈ survivingComponentSet
  /-- The retained width contribution is still controlled after surgery. -/
  retainedWidthTrackedLePostSurgeryWidth :
    surgeryDiscardControlPayload.retainedWidthContribution ≤
      surgeryDiscardControlPayload.surgeryWidthDropPayload.postSurgeryWidth
  /-- The discarded component has already been classified as trivial. -/
  discardedComponentClassifiedTrivial :
    classificationPayload.componentClassification
        classificationPayload.classifiedComponent =
      classificationPayload.trivialComponentClass
  /-- The classified discarded set is empty, so only the retained component survives. -/
  classifiedDiscardedSetEmpty :
    classificationPayload.surgeryDiscardControlPayload.discardedComponentSet = ∅

/-- Bundle the retained-component tracking facts used by the component topology step. -/
theorem FiniteExtinctionSurvivingComponentTrackingPayload.tracking_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    {discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution}
    (payload :
      FiniteExtinctionSurvivingComponentTrackingPayload
        flow surgery control widthTheory widthEvolution discardControl) :
    payload.survivingComponentMap payload.preSurgerySurvivingComponent =
        payload.postSurgerySurvivingComponent ∧
      payload.survivingComponentSet =
        payload.surgeryDiscardControlPayload.retainedComponentSet ∧
      payload.survivingWitnessPoint ∈ payload.survivingComponentSet ∧
      payload.surgeryDiscardControlPayload.retainedWidthContribution ≤
        payload.surgeryDiscardControlPayload.surgeryWidthDropPayload.postSurgeryWidth ∧
      payload.classificationPayload.componentClassification
          payload.classificationPayload.classifiedComponent =
        payload.classificationPayload.trivialComponentClass ∧
      payload.classificationPayload.surgeryDiscardControlPayload.discardedComponentSet = ∅ := by
  exact
    ⟨payload.selectedSurvivingComponentTracked,
      payload.survivingComponentSetEqRetained,
      payload.survivingWitnessMem,
      payload.retainedWidthTrackedLePostSurgeryWidth,
      payload.discardedComponentClassifiedTrivial,
      payload.classifiedDiscardedSetEmpty⟩

