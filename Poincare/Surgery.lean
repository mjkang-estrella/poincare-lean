argument.

The payload is tied to the no-local-collapsing contradiction setup. It records
which collapsed-ball hypotheses feed the blowup sequence, the parabolic
rescaling data inherited from the setup, and a modeled pointed-convergence
input for the rescaled flows.
-/
structure PerelmanCollapsedBallBlowupPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {reducedVolumeNonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    {kappaNoncollapsingFromReducedVolumePayload :
      PerelmanKappaNoncollapsingFromReducedVolumePayload
        reducedVolumeNonincreasingPayload}
    (noLocalCollapsingContradictionSetupPayload :
      PerelmanNoLocalCollapsingContradictionSetupPayload
        kappaNoncollapsingFromReducedVolumePayload) : Type (u + 1) where
  /-- Index domain for the collapsed-ball blowup sequence. -/
  blowupIndexDomain : Type u
  /-- Distinguished index used as the recorded base blowup. -/
  baseBlowupIndex : blowupIndexDomain
  /-- Collapsed-ball setup associated to each blowup index. -/
  blowupIndexToSetup :
    blowupIndexDomain →
      noLocalCollapsingContradictionSetupPayload.collapsedBallSetupDomain
  /-- Each blowup index is backed by the collapse hypothesis. -/
  blowupSetupCollapseHypothesis :
    ∀ index,
      noLocalCollapsingContradictionSetupPayload.collapseHypothesis
        (blowupIndexToSetup index)
  /-- Basepoint of the rescaled pointed flow at each index. -/
  blowupBasepoint : blowupIndexDomain → M
  /-- The blowup basepoint agrees with the collapsed-ball center. -/
  blowupBasepoint_eq_collapsedBallCenter :
    ∀ index,
      blowupBasepoint index =
        noLocalCollapsingContradictionSetupPayload.collapsedBallCenter
          (blowupIndexToSetup index)
  /-- Time coordinate of the rescaled pointed flow at each index. -/
  blowupTime : blowupIndexDomain → ℝ
  /-- The blowup time agrees with the setup blowup time. -/
  blowupTime_eq_contradictionBlowupTime :
    ∀ index,
      blowupTime index =
        noLocalCollapsingContradictionSetupPayload.contradictionBlowupTime
          (blowupIndexToSetup index)
  /-- Radius of the rescaled blowup ball at each index. -/
  blowupRadius : blowupIndexDomain → ℝ
  /-- The blowup radius agrees with the setup blowup radius. -/
  blowupRadius_eq_contradictionBlowupRadius :
    ∀ index,
      blowupRadius index =
        noLocalCollapsingContradictionSetupPayload.contradictionBlowupRadius
          (blowupIndexToSetup index)
  /-- Parabolic rescaling factor at each blowup index. -/
  rescalingFactor : blowupIndexDomain → ℝ
  /-- The rescaling factor agrees with the setup rescaling factor. -/
  rescalingFactor_eq_contradictionRescalingFactor :
    ∀ index,
      rescalingFactor index =
        noLocalCollapsingContradictionSetupPayload.contradictionRescalingFactor
          (blowupIndexToSetup index)
  /-- Abstract model space of rescaled pointed flows. -/
  rescaledFlowModel : Type u
  /-- Rescaled pointed flow attached to each blowup index. -/
  rescaledFlowAtIndex : blowupIndexDomain → rescaledFlowModel
  /-- Pointed limit model for the rescaled collapsed-ball sequence. -/
  pointedLimitFlowModel : rescaledFlowModel
  /-- Test domain used to record pointed convergence. -/
  pointedConvergenceTestDomain : Type u
  /-- Pointed convergence error against each test. -/
  pointedConvergenceError :
    blowupIndexDomain → pointedConvergenceTestDomain → ℝ
  /-- Pointed convergence errors are nonnegative. -/
  pointedConvergenceErrorNonnegative :
    ∀ index test, 0 ≤ pointedConvergenceError index test
  /-- Envelope controlling pointed convergence errors. -/
  pointedConvergenceEnvelope : ℝ
  /-- The pointed convergence envelope is nonnegative. -/
  pointedConvergenceEnvelopeNonnegative :
    0 ≤ pointedConvergenceEnvelope
  /-- Pointed convergence errors are controlled by the envelope. -/
  pointedConvergenceError_le_envelope :
    ∀ index test,
      pointedConvergenceError index test ≤ pointedConvergenceEnvelope
  /-- Volume ratio of the rescaled blowup model at each index. -/
  rescaledVolumeRatio : blowupIndexDomain → ℝ
  /-- Rescaled volume ratios agree with the collapsed setup ratios. -/
  rescaledVolumeRatio_eq_collapsedVolumeRatio :
    ∀ index,
      rescaledVolumeRatio index =
        noLocalCollapsingContradictionSetupPayload.collapsedVolumeRatio
          (blowupIndexToSetup index)
  /-- Curvature scale after rescaling. -/
  rescaledCurvatureScale : blowupIndexDomain → ℝ
  /-- Rescaled curvature is normalized at scale one. -/
  rescaledCurvatureScale_eq_one :
    ∀ index, rescaledCurvatureScale index = 1
  /-- Envelope controlling collapsed-ball blowup data. -/
  collapsedBallBlowupEnvelope : ℝ
  /-- The collapsed-ball blowup envelope is nonnegative. -/
  collapsedBallBlowupEnvelopeNonnegative :
    0 ≤ collapsedBallBlowupEnvelope
  /-- The contradiction-setup envelope is absorbed by the blowup envelope. -/
  contradictionSetupEnvelope_le_blowupEnvelope :
    noLocalCollapsingContradictionSetupPayload.contradictionSetupEnvelope ≤
      collapsedBallBlowupEnvelope
  /-- The convergence envelope is absorbed by the blowup envelope. -/
  pointedConvergenceEnvelope_le_blowupEnvelope :
    pointedConvergenceEnvelope ≤ collapsedBallBlowupEnvelope
  /-- Rescaled volume ratios are controlled by the blowup envelope. -/
  rescaledVolumeRatio_le_blowupEnvelope :
    ∀ index, rescaledVolumeRatio index ≤ collapsedBallBlowupEnvelope

