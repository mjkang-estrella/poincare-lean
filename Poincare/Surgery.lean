/--
Concrete payload for the pull-tight argument in the target min-max setup.

The payload records a tightened sweepout sequence, compares it to the stored
minimizing sequence, keeps the tightened sequence in the same compactness
neighborhood eventually, and records that the tightening does not increase the
area functional.
-/
structure FiniteExtinctionPullTightPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (fundamentalGroup : HasFiniteExtinctionFundamentalGroupInput M)
    (sweepoutPayload :
      FiniteExtinctionSweepoutPayload M fundamentalGroup)
    (areaPayload :
      FiniteExtinctionAreaFunctionalPayload
        flow surgery control fundamentalGroup sweepoutPayload)
    (widthPayload :
      FiniteExtinctionMinMaxWidthPayload
        flow surgery control fundamentalGroup sweepoutPayload areaPayload)
    (compactnessPayload :
      FiniteExtinctionWidthCompactnessPayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload)
    (lowerSemicontinuityPayload :
      FiniteExtinctionWidthLowerSemicontinuityPayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload compactnessPayload)
    (minimizingSequencePayload :
      FiniteExtinctionMinimizingSequencePayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload compactnessPayload
        lowerSemicontinuityPayload) :
    Type (u + 1) where
  /-- Tightened sequence of sweepout parameters. -/
  tightenedSequence : ℕ → sweepoutPayload.parameterSpace
  /-- The tightened sequence remains in the same sweepout class. -/
  comparisonSequence : ℕ → sweepoutPayload.parameterSpace
  /-- The comparison sequence is the stored minimizing sequence. -/
  comparisonIsMinimizingSequence :
    comparisonSequence = minimizingSequencePayload.minimizingSequence
  /-- Tightening does not increase the area functional. -/
  tightenedAreaLeOriginal :
    ∀ k : ℕ,
      areaPayload.areaFunctional (tightenedSequence k) ≤
        areaPayload.areaFunctional
          (minimizingSequencePayload.minimizingSequence k)
  /-- The tightened sequence remains controlled by the chosen width. -/
  tightenedAreaLeWidth :
    ∀ k : ℕ,
      areaPayload.areaFunctional (tightenedSequence k) ≤
        widthPayload.widthValue
  /-- The tightened sequence uses the same limiting parameter as before. -/
  tightenedLimit : sweepoutPayload.parameterSpace
  /-- The tightened limit is the lower-semicontinuity limit. -/
  tightenedLimitMatchesLowerSemicontinuity :
    tightenedLimit =
      lowerSemicontinuityPayload.lowerSemicontinuityLimit
  /-- The tightened limit remains in the compactness-control neighborhood. -/
  tightenedLimitMemCompactnessNeighborhood :
    tightenedLimit ∈ compactnessPayload.compactnessNeighborhood
  /-- The tightened sequence is eventually in the compactness neighborhood. -/
  eventuallyTightenedMem :
    ∃ N : ℕ, ∀ k : ℕ, N ≤ k →
      tightenedSequence k ∈ compactnessPayload.compactnessNeighborhood

