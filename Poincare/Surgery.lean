/--
Concrete payload for defining the min-max width associated to a finite
extinction sweepout.

The payload records the real width value extracted from the area functional,
uniform comparison with all sweepout slices, and a distinguished parameter
used to normalize the definition against the concrete sweepout family.
-/
structure FiniteExtinctionMinMaxWidthPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (fundamentalGroup : HasFiniteExtinctionFundamentalGroupInput M)
    (sweepoutPayload :
      FiniteExtinctionSweepoutPayload M fundamentalGroup)
    (areaPayload :
      FiniteExtinctionAreaFunctionalPayload
        flow surgery control fundamentalGroup sweepoutPayload) :
    Type (u + 1) where
  /-- Real value assigned to the min-max width. -/
  widthValue : ℝ
  /-- The width value uniformly bounds the sweepout area functional. -/
  areaFunctionalLeWidth :
    ∀ p : sweepoutPayload.parameterSpace,
      areaPayload.areaFunctional p ≤ widthValue
  /-- Distinguished parameter used to normalize the min-max family. -/
  normalizingParameter : sweepoutPayload.parameterSpace
  /-- The normalizing parameter is controlled by the width value. -/
  normalizingParameterLeWidth :
    areaPayload.areaFunctional normalizingParameter ≤ widthValue
  /-- The chosen width remains within the sweepout payload's uniform bound. -/
  widthLeSweepoutBound : widthValue ≤ sweepoutPayload.areaBound

