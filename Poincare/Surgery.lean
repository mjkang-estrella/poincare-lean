          (singularityModelToCanonicalRegion model)
  /-- Every singularity model is classified as a neck class or a cap class. -/
  singularityModelClass_neck_or_cap :
    ∀ model,
      classificationPayload.isEpsilonNeckClass
          (singularityModelClassLabel model) ∨
        classificationPayload.isEpsilonCapClass
          (singularityModelClassLabel model)
