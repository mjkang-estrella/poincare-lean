/--
Concrete payload for comparing the width metric across a surgery time.

The payload is tied to a concrete width-evolution witness, keeps the smooth
width differential inequality on adjacent nonsurgical intervals, stores the
post-surgery metric-control input, and records an explicit before/after width
comparison with a nonnegative distortion bound.
-/
structure FiniteExtinctionSurgeryMetricComparisonPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory) :
    Type (u + 1) where
  /-- Concrete width-evolution data being compared across surgery. -/
  widthEvolutionPayload :
    FiniteExtinctionWidthEvolutionPayload flow surgery control widthTheory
  /-- The metric-comparison payload is attached to that width-evolution witness. -/
  widthEvolutionEq :
    widthEvolution =
      HasFiniteExtinctionWidthEvolution.of_width_evolution_payload
        widthEvolutionPayload
  /-- Smooth width differential inequality on the adjacent flow intervals. -/
  widthDifferentialPayload :
    FiniteExtinctionWidthDifferentialInequalityPayload
      flow surgery control widthTheory
  /-- Regularity of the evolving metric used in the comparison. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Post-surgery metric control for comparing widths across the surgery time. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow
  /-- Parameter space indexing the surgery comparison. -/
  surgeryComparisonParameterSpace : Type u
  /-- Parameter immediately before the surgery comparison. -/
  preSurgeryParameter : surgeryComparisonParameterSpace
  /-- Parameter immediately after the surgery comparison. -/
  postSurgeryParameter : surgeryComparisonParameterSpace
  /-- Width value immediately before surgery. -/
  preSurgeryWidth : ℝ
  /-- Width value immediately after surgery. -/
  postSurgeryWidth : ℝ
  /-- The pre-surgery width agrees with the width-evolution initial value. -/
  preSurgeryWidthEqEvolutionInitial :
    preSurgeryWidth = widthEvolutionPayload.initialWidthValue
  /-- The post-surgery width agrees with the width-evolution comparison value. -/
  postSurgeryWidthEqEvolutionComparison :
    postSurgeryWidth = widthEvolutionPayload.comparisonWidthValue
  /-- Direct nonincrease comparison for the selected surgery parameters. -/
  postSurgeryWidthLePreSurgeryWidth :
    postSurgeryWidth ≤ preSurgeryWidth
  /-- Nonnegative metric-distortion allowance across surgery. -/
  metricDistortionBound : ℝ
  /-- The metric-distortion allowance is nonnegative. -/
  metricDistortionBoundNonnegative : 0 ≤ metricDistortionBound
  /-- Width comparison with the stored metric-distortion allowance. -/
  postSurgeryWidthLePreSurgeryWidthPlusDistortion :
    postSurgeryWidth ≤ preSurgeryWidth + metricDistortionBound

