    ∀ model,
      singularityModelNeckScale model =
        canonicalNeighborhoodTheoremPayload.canonicalNeighborhoodRegionNeckScale
          (singularityModelToCanonicalRegion model)
  /-- Neck scales assigned to singularity models are positive. -/
  singularityModelNeckScalePositive :
    ∀ model, 0 < singularityModelNeckScale model
  /-- Cap scale assigned to each classified singularity model. -/
  singularityModelCapScale : singularityModelFamily → ℝ
  /-- Singularity-model cap scales agree with theorem-level region scales. -/
  singularityModelCapScale_eq_canonicalRegionCapScale :
    ∀ model,
      singularityModelCapScale model =
        canonicalNeighborhoodTheoremPayload.canonicalNeighborhoodRegionCapScale
          (singularityModelToCanonicalRegion model)
  /-- Cap scales assigned to singularity models are positive. -/
  singularityModelCapScalePositive :
    ∀ model, 0 < singularityModelCapScale model
  /-- Curvature lower bound retained by the classified singularity model. -/
  singularityModelCurvatureLowerBound : singularityModelFamily → ℝ
  /-- Singularity-model lower bounds agree with asymptotic-soliton bounds. -/
  singularityModelCurvatureLowerBound_eq_asymptoticSolitonLowerBound :
    ∀ model,
      singularityModelCurvatureLowerBound model =
        asymptoticSolitonPayload.asymptoticSolitonCurvatureLowerBound
          (singularityModelToAsymptoticSoliton model)
  /-- Curvature lower bounds of classified singularity models are nonnegative. -/
  singularityModelCurvatureLowerBoundNonnegative :
    ∀ model, 0 ≤ singularityModelCurvatureLowerBound model
  /-- Envelope controlling singularity-model classification data. -/
  singularityModelClassificationEnvelope : ℝ
  /-- The singularity-model classification envelope is nonnegative. -/
  singularityModelClassificationEnvelopeNonnegative :
    0 ≤ singularityModelClassificationEnvelope
  /-- Asymptotic-soliton control is absorbed by the classification envelope. -/
  asymptoticSolitonEnvelope_le_singularityModelClassificationEnvelope :
    asymptoticSolitonPayload.asymptoticSolitonEnvelope ≤
      singularityModelClassificationEnvelope
  /-- Canonical-neighborhood theorem control is absorbed by the envelope. -/
  canonicalNeighborhoodTheoremEnvelope_le_singularityModelClassificationEnvelope :
    canonicalNeighborhoodTheoremPayload.canonicalNeighborhoodTheoremEnvelope ≤
      singularityModelClassificationEnvelope
  /-- Defect measuring singularity-model classification. -/
  singularityModelClassificationDefect : singularityModelFamily → ℝ
  /-- Classification defects are nonnegative. -/
  singularityModelClassificationDefectNonnegative :
    ∀ model, 0 ≤ singularityModelClassificationDefect model
  /-- Classification defects are bounded by the classification envelope. -/
  singularityModelClassificationDefect_le_envelope :
    ∀ model,
      singularityModelClassificationDefect model ≤
        singularityModelClassificationEnvelope

