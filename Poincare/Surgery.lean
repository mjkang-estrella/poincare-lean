/--
Concrete reduced-distance minimizer/L-geodesic existence data.

The payload is tied to the reduced-length first-variation payload. It records a
nonempty minimizer space, reduced-distance values compatible with reduced
length, a base minimizer attaining the recorded infimum, and an associated
L-geodesic assignment.
-/
structure PerelmanReducedDistanceExistencePayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    (reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload) : Type (u + 1) where
  /-- Scale on which reduced-distance existence is controlled. -/
  reducedDistanceExistenceScale : ℝ
  /-- The reduced-distance existence scale is positive. -/
  reducedDistanceExistenceScalePositive : 0 < reducedDistanceExistenceScale
  /-- Reduced-length first-variation control lies within the existence scale. -/
  reducedLengthFirstVariationScale_le_reducedDistanceExistenceScale :
    reducedLengthFirstVariationPayload.reducedLengthFirstVariationScale ≤
      reducedDistanceExistenceScale
  /-- Space of reduced-distance minimizers. -/
  reducedDistanceMinimizerSpace : Type u
  /-- Distinguished minimizer attaining the recorded infimum. -/
  baseReducedDistanceMinimizer : reducedDistanceMinimizerSpace
  /-- Variation associated to each reduced-distance minimizer. -/
  reducedDistanceMinimizerToVariation :
    reducedDistanceMinimizerSpace →
      reducedLengthFirstVariationPayload.reducedLengthVariationSpace
  /-- Reduced-distance value at each minimizer. -/
  reducedDistanceValue : reducedDistanceMinimizerSpace → ℝ
  /-- Reduced-distance values agree with the associated reduced-length values. -/
  reducedDistanceValue_eq_reducedLengthValue :
    ∀ minimizer,
      reducedDistanceValue minimizer =
        reducedLengthFirstVariationPayload.reducedLengthValue
          (reducedDistanceMinimizerToVariation minimizer)
  /-- Recorded infimum of the reduced-distance values. -/
  reducedDistanceInfimum : ℝ
  /-- The recorded infimum bounds every reduced-distance value from below. -/
  reducedDistanceInfimum_le_value :
    ∀ minimizer,
      reducedDistanceInfimum ≤ reducedDistanceValue minimizer
  /-- The distinguished minimizer attains the recorded infimum. -/
  baseReducedDistanceMinimizer_attainsInfimum :
    reducedDistanceValue baseReducedDistanceMinimizer =
      reducedDistanceInfimum
  /-- Space of L-geodesics associated to reduced-distance minimizers. -/
  reducedDistanceLGeodesicSpace : Type u
  /-- L-geodesic assigned to each reduced-distance minimizer. -/
  reducedDistanceMinimizerToLGeodesic :
    reducedDistanceMinimizerSpace → reducedDistanceLGeodesicSpace
  /-- Distinguished L-geodesic associated to the base minimizer. -/
  baseReducedDistanceLGeodesic : reducedDistanceLGeodesicSpace
  /-- The distinguished L-geodesic agrees with the base minimizer's assignment. -/
  baseReducedDistanceLGeodesic_eq :
    baseReducedDistanceLGeodesic =
      reducedDistanceMinimizerToLGeodesic baseReducedDistanceMinimizer

/-- A reduced-distance existence payload contains a minimizer attaining its infimum. -/
theorem PerelmanReducedDistanceExistencePayload.exists_minimizer_attaining_infimum
    {n : ℕ∞ω}
