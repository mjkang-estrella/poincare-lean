  /-- Time associated to a volume-ratio comparison point. -/
  ratioPointToTime :
    reducedVolumeToVolumeRatioDomain →
      reducedVolumeNonincreasingPayload.reducedVolumeTimeDomain
  /-- Volume ratio produced at a comparison point. -/
  volumeRatioAtScale : reducedVolumeToVolumeRatioDomain → ℝ
  /-- Reduced-volume values control the corresponding volume ratios. -/
  reducedVolumeAtTime_le_volumeRatioAtScale :
    ∀ point,
      reducedVolumeNonincreasingPayload.reducedVolumeAtTime
          (ratioPointToTime point) ≤
        volumeRatioAtScale point
  /-- Domain of balls receiving kappa-noncollapsing volume-ratio bounds. -/
  kappaNoncollapsedBallDomain : Type u
  /-- Volume-ratio comparison point associated to a ball. -/
  ballToRatioPoint :
    kappaNoncollapsedBallDomain → reducedVolumeToVolumeRatioDomain
  /-- Volume ratio of a ball at the relevant scale. -/
  ballVolumeRatio : kappaNoncollapsedBallDomain → ℝ
  /-- Ball-volume ratios agree with the corresponding comparison volume ratio. -/
  ballVolumeRatio_eq_volumeRatioAtScale :
    ∀ ball,
      ballVolumeRatio ball =
        volumeRatioAtScale (ballToRatioPoint ball)
  /-- Envelope controlling kappa-from-reduced-volume data. -/
  kappaFromReducedVolumeEnvelope : ℝ
  /-- The kappa-from-reduced-volume envelope is nonnegative. -/
  kappaFromReducedVolumeEnvelopeNonnegative :
    0 ≤ kappaFromReducedVolumeEnvelope
  /-- Nonincreasing envelope data are absorbed by the kappa envelope. -/
  nonincreasingEnvelope_le_kappaEnvelope :
    reducedVolumeNonincreasingPayload.reducedVolumeNonincreasingEnvelope ≤
      kappaFromReducedVolumeEnvelope
  /-- The kappa constant is controlled by the kappa envelope. -/
  kappaConstant_le_kappaEnvelope :
    kappaFromReducedVolumeConstant ≤ kappaFromReducedVolumeEnvelope
  /-- Comparison volume ratios are controlled by the kappa envelope. -/
  volumeRatioAtScale_le_kappaEnvelope :
    ∀ point, volumeRatioAtScale point ≤ kappaFromReducedVolumeEnvelope

