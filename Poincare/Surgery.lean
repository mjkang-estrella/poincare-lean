/--
Concrete reduced-distance estimates used in blow-up analysis.

The payload is tied to the reduced-distance differential-inequality data. It
records pointwise upper/lower bounds for reduced distance on the smooth test
domain, a squared-gradient estimate, barrier residual control, and a common
scale-dependent constant packaging the bounds used downstream.
-/
structure PerelmanReducedDistanceEstimatesPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    (reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload) : Type (u + 1) where
  /-- Scale on which reduced-distance estimates are controlled. -/
  reducedDistanceEstimatesScale : ℝ
  /-- The reduced-distance estimates scale is positive. -/
  reducedDistanceEstimatesScalePositive : 0 < reducedDistanceEstimatesScale
  /-- Differential-inequality control lies within the estimates scale. -/
  differentialInequalityScale_le_estimatesScale :
    reducedDistanceDifferentialInequalityPayload.reducedDistanceDifferentialInequalityScale ≤
      reducedDistanceEstimatesScale
  /-- Lower pointwise reduced-distance bound on the smooth test domain. -/
  reducedDistanceLowerBound : ℝ
  /-- Upper pointwise reduced-distance bound on the smooth test domain. -/
  reducedDistanceUpperBound : ℝ
  /-- The pointwise lower bound is below the pointwise upper bound. -/
  reducedDistanceLowerBound_le_upperBound :
    reducedDistanceLowerBound ≤ reducedDistanceUpperBound
  /-- Smooth reduced-distance values are bounded below. -/
  reducedDistanceLowerBound_le_smoothValue :
    ∀ test,
      reducedDistanceLowerBound ≤
        reducedDistanceDifferentialInequalityPayload.smoothReducedDistanceValue
          test
  /-- Smooth reduced-distance values are bounded above. -/
  smoothValue_le_reducedDistanceUpperBound :
    ∀ test,
      reducedDistanceDifferentialInequalityPayload.smoothReducedDistanceValue
          test ≤
        reducedDistanceUpperBound
  /-- Squared-gradient estimate bound on the smooth test domain. -/
  smoothGradientEstimateBound : ℝ
  /-- The squared-gradient estimate bound is nonnegative. -/
  smoothGradientEstimateBoundNonnegative : 0 ≤ smoothGradientEstimateBound
  /-- Smooth squared-gradient terms are bounded by the estimate bound. -/
  smoothGradientNormSquared_le_estimateBound :
    ∀ test,
      reducedDistanceDifferentialInequalityPayload.smoothGradientNormSquared
          test ≤
        smoothGradientEstimateBound
  /-- Barrier residual estimate bound for distributional tests. -/
  barrierResidualEstimateBound : ℝ
  /-- The barrier residual estimate bound is nonnegative. -/
  barrierResidualEstimateBoundNonnegative : 0 ≤ barrierResidualEstimateBound
  /-- Barrier residuals are bounded by the estimate bound. -/
  barrierHamiltonJacobiResidual_le_estimateBound :
    ∀ test,
      reducedDistanceDifferentialInequalityPayload.barrierHamiltonJacobiResidual
          test ≤
        barrierResidualEstimateBound
  /-- Common constant packaging the reduced-distance estimates for blow-up use. -/
  reducedDistanceBlowupEstimateConstant : ℝ
  /-- The common blow-up estimate constant is nonnegative. -/
  reducedDistanceBlowupEstimateConstantNonnegative :
    0 ≤ reducedDistanceBlowupEstimateConstant
  /-- The pointwise upper bound is absorbed by the common constant. -/
  reducedDistanceUpperBound_le_blowupEstimateConstant :
    reducedDistanceUpperBound ≤ reducedDistanceBlowupEstimateConstant
  /-- The squared-gradient bound is absorbed by the common constant. -/
  smoothGradientEstimateBound_le_blowupEstimateConstant :
    smoothGradientEstimateBound ≤ reducedDistanceBlowupEstimateConstant
  /-- The barrier residual bound is absorbed by the common constant. -/
  barrierResidualEstimateBound_le_blowupEstimateConstant :
    barrierResidualEstimateBound ≤ reducedDistanceBlowupEstimateConstant

/--
Smooth reduced-distance values are controlled by the packaged blow-up estimate
bound.
-/
theorem PerelmanReducedDistanceEstimatesPayload.smoothValue_le_blowupEstimateConstant
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
