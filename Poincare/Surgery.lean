/--
Concrete payload for the width-evolution comparison used in finite extinction.

The payload keeps the width theory and scalar-curvature width bound for the
same min-max family, adds the metric/surgery/scalar-evolution controls needed
to compare widths along the flow, and records an explicit two-time width
comparison. The smooth differential inequality that produces such comparisons
remains the next finite-width interface.
-/
structure FiniteExtinctionWidthEvolutionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  /-- Concrete payload from which the shared width theory is built. -/
  widthTheoryPayload :
    FiniteExtinctionWidthTheoryPayload flow surgery control
  /-- The width-evolution payload is attached to that concrete width theory. -/
  widthTheoryEq :
    widthTheory =
      HasFiniteExtinctionWidthTheory.of_width_theory_payload
        widthTheoryPayload
  /-- Scalar-curvature width-bound data used in the width evolution estimate. -/
  scalarCurvatureWidthBoundPayload :
    FiniteExtinctionScalarCurvatureWidthBoundPayload
      flow surgery control widthTheory
  /-- Regularity of the evolving metric used to compare widths over time. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Metric comparison/control across surgery times. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow
  /-- Scalar-curvature evolution input for the width comparison. -/
  scalarCurvatureEvolution : HasScalarCurvatureEvolutionEquation flow
  /-- Reduced-volume monotonicity input used to control the evolving family. -/
  reducedVolumeMonotonicity :
    HasPerelmanReducedVolumeMonotonicity flow
  /-- Parameter space indexing the width comparison. -/
  timeParameterSpace : Type u
  /-- Initial comparison parameter. -/
  initialTime : timeParameterSpace
  /-- Later comparison parameter. -/
  comparisonTime : timeParameterSpace
  /-- Abstract width value along the comparison parameters. -/
  widthAtTime : timeParameterSpace → ℝ
  /-- Width value at the initial parameter. -/
  initialWidthValue : ℝ
  /-- Width value at the comparison parameter. -/
  comparisonWidthValue : ℝ
  /-- The time-indexed width agrees with the stored initial width. -/
  widthAtInitialTime : widthAtTime initialTime = initialWidthValue
  /-- The time-indexed width agrees with the stored comparison width. -/
  widthAtComparisonTime : widthAtTime comparisonTime = comparisonWidthValue
  /-- The initial width is the width controlling the scalar-curvature term. -/
  initialWidthEqScalarCurvatureWidth :
    initialWidthValue = scalarCurvatureWidthBoundPayload.widthValue
  /-- The scalar-curvature contribution is controlled by the initial width. -/
  scalarCurvatureContributionLeInitialWidth :
    scalarCurvatureWidthBoundPayload.scalarCurvatureContribution ≤
      initialWidthValue
  /-- Width comparison/nonincrease between the two selected parameters. -/
  comparisonWidthLeInitialWidth :
    comparisonWidthValue ≤ initialWidthValue

/-- Source data for the differential/monotonicity inequality controlling width. -/
structure FiniteExtinctionWidthEvolutionPayloadSource
