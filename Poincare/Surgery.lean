/--
Concrete payload for classifying discarded components in the finite-extinction
argument.

The payload is attached to the same surgery-discard-control payload and the
sweepout-triviality payload for the discarded component. It records an explicit
classification map for discarded-component indices, identifies the selected
discarded component with the trivialized component, and keeps the empty
discarded-set and zero-width certificates used by the classification.
-/
structure FiniteExtinctionDiscardedComponentClassificationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory)
    (discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution) :
    Type (u + 1) where
  /-- Concrete surgery-discard-control payload being classified. -/
  surgeryDiscardControlPayload :
    FiniteExtinctionSurgeryDiscardControlPayload
      flow surgery control widthTheory widthEvolution
  /-- The abstract discard-control witness is built from the concrete payload. -/
  discardControlEq :
    discardControl =
      HasFiniteExtinctionSurgeryDiscardControl.of_surgery_discard_control_payload
        surgeryDiscardControlPayload
  /-- Sweepout-triviality payload used by the classification. -/
  sweepoutTrivialityPayload :
    FiniteExtinctionDiscardedComponentSweepoutTrivialityPayload
      flow surgery control widthTheory widthEvolution discardControl
  /-- Type of component classes used for discarded components. -/
  classificationType : Type u
  /-- Class representing the trivial discarded component. -/
  trivialComponentClass : classificationType
  /-- Classification map for discarded-component indices. -/
  componentClassification :
    surgeryDiscardControlPayload.discardedComponentIndex →
      classificationType
  /-- Component selected for classification. -/
  classifiedComponent :
    surgeryDiscardControlPayload.discardedComponentIndex
  /-- The classified component is the selected discarded component. -/
  classifiedComponentEqSelected :
    classifiedComponent =
      surgeryDiscardControlPayload.selectedDiscardedComponent
  /-- The prior triviality payload trivializes its selected component. -/
  trivializedComponentEqSelected :
    sweepoutTrivialityPayload.trivializedComponent =
      sweepoutTrivialityPayload.surgeryDiscardControlPayload.selectedDiscardedComponent
  /-- The selected component is classified as the trivial component class. -/
  classifiedComponentClassEqTrivial :
    componentClassification classifiedComponent = trivialComponentClass
  /-- The classified discarded component set is empty. -/
  classifiedDiscardedSetEmpty :
    surgeryDiscardControlPayload.discardedComponentSet = ∅
  /-- The trivialized sweepout slice is empty. -/
  trivializedSweepoutSliceEmpty :
    sweepoutTrivialityPayload.trivializedSweepoutSlice = ∅
  /-- The discarded component has zero width contribution. -/
  classifiedDiscardedWidthZero :
    surgeryDiscardControlPayload.discardedWidthContribution = 0

/-- Bundle the discarded-component classification data used before survivor tracking. -/
theorem FiniteExtinctionDiscardedComponentClassificationPayload.classification_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    {discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution}
    (payload :
      FiniteExtinctionDiscardedComponentClassificationPayload
        flow surgery control widthTheory widthEvolution discardControl) :
    payload.classifiedComponent =
        payload.surgeryDiscardControlPayload.selectedDiscardedComponent ∧
      payload.sweepoutTrivialityPayload.trivializedComponent =
        payload.sweepoutTrivialityPayload.surgeryDiscardControlPayload.selectedDiscardedComponent ∧
      payload.componentClassification payload.classifiedComponent =
        payload.trivialComponentClass ∧
      payload.surgeryDiscardControlPayload.discardedComponentSet = ∅ ∧
      payload.sweepoutTrivialityPayload.trivializedSweepoutSlice = ∅ ∧
      payload.surgeryDiscardControlPayload.discardedWidthContribution = 0 := by
  exact
    ⟨payload.classifiedComponentEqSelected,
      payload.trivializedComponentEqSelected,
      payload.classifiedComponentClassEqTrivial,
      payload.classifiedDiscardedSetEmpty,
      payload.trivializedSweepoutSliceEmpty,
      payload.classifiedDiscardedWidthZero⟩

