/--
Concrete payload for controlling surgery and discarded components in the width
argument.

The payload ties discard control to the already constructed surgery metric
comparison, sweepout comparison map, and width-drop/nonincrease data. It also
records an explicit retained slice and nonnegative discarded-width accounting,
leaving the later neutrality/triviality statements for discarded components as
separate downstream interfaces.
-/
structure FiniteExtinctionSurgeryDiscardControlPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory) :
    Type (u + 1) where
  /-- Concrete width-evolution data underlying the surgery comparison. -/
  widthEvolutionPayload :
    FiniteExtinctionWidthEvolutionPayload flow surgery control widthTheory
  /-- Metric comparison across the selected surgery time. -/
  surgeryMetricComparisonPayload :
    FiniteExtinctionSurgeryMetricComparisonPayload
      flow surgery control widthTheory widthEvolution
  /-- Sweepout comparison map through the surgery metric comparison. -/
  surgeryWidthComparisonMapPayload :
    FiniteExtinctionSurgeryWidthComparisonMapPayload
      flow surgery control widthTheory widthEvolution
  /-- Width drop/nonincrease data across the selected surgery time. -/
  surgeryWidthDropPayload :
    FiniteExtinctionSurgeryWidthDropPayload
      flow surgery control widthTheory widthEvolution
  /-- Post-surgery metric control used to identify retained regions. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow
  /-- Parameter space for the selected surgery/discard-control time. -/
  surgeryDiscardParameterSpace : Type u
  /-- Parameter selecting the surgery/discard-control time. -/
  surgeryDiscardParameter : surgeryDiscardParameterSpace
  /-- Indexing space for discarded components in the selected comparison. -/
  discardedComponentIndex : Type u
  /-- Selected discarded-component index for the accounting statement. -/
  selectedDiscardedComponent : discardedComponentIndex
  /-- Region discarded in the selected comparison. -/
  discardedComponentSet : Set M
  /-- Retained region carrying the compared sweepout slice. -/
  retainedComponentSet : Set M
  /-- Width contribution assigned to the discarded region. -/
  discardedWidthContribution : ℝ
  /-- Width contribution assigned to the retained region. -/
  retainedWidthContribution : ℝ
  /-- Discarded width contribution is nonnegative. -/
  discardedWidthContributionNonnegative :
    0 ≤ discardedWidthContribution
  /-- Retained width remains bounded by the pre-surgery width. -/
  retainedWidthContributionLePreSurgeryWidth :
    retainedWidthContribution ≤ surgeryWidthDropPayload.preSurgeryWidth
  /-- Discarded width is bounded by the stored width drop. -/
  discardedWidthContributionLeDrop :
    discardedWidthContribution ≤ surgeryWidthDropPayload.widthDropAmount
  /-- Retained width is bounded by the post-surgery width. -/
  retainedWidthContributionLePostSurgeryWidth :
    retainedWidthContribution ≤ surgeryWidthDropPayload.postSurgeryWidth

/-- Discard-control payloads expose nonnegative discarded width and retained/discarded bounds. -/
theorem FiniteExtinctionSurgeryDiscardControlPayload.width_accounting_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    (payload :
      FiniteExtinctionSurgeryDiscardControlPayload
        flow surgery control widthTheory widthEvolution) :
    0 ≤ payload.discardedWidthContribution ∧
      payload.retainedWidthContribution ≤
        payload.surgeryWidthDropPayload.preSurgeryWidth ∧
      payload.discardedWidthContribution ≤
        payload.surgeryWidthDropPayload.widthDropAmount ∧
      payload.retainedWidthContribution ≤
        payload.surgeryWidthDropPayload.postSurgeryWidth := by
  exact
    ⟨payload.discardedWidthContributionNonnegative,
      payload.retainedWidthContributionLePreSurgeryWidth,
      payload.discardedWidthContributionLeDrop,
      payload.retainedWidthContributionLePostSurgeryWidth⟩

