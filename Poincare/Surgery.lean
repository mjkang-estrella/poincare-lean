/--
Concrete payload for the sweepout comparison map across surgery.

The payload is tied to the concrete surgery metric comparison, records an
explicit map between pre- and post-surgery sweepout parameter spaces, names the
selected source and target slices, and transports the stored metric-comparison
width bound along that map.
-/
structure FiniteExtinctionSurgeryWidthComparisonMapPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory) :
    Type (u + 1) where
  /-- Concrete surgery metric comparison used to control the map. -/
  surgeryMetricComparisonPayload :
    FiniteExtinctionSurgeryMetricComparisonPayload
      flow surgery control widthTheory widthEvolution
  /-- Pre-surgery sweepout parameter space. -/
  sourceParameterSpace : Type u
  /-- Post-surgery sweepout parameter space. -/
  targetParameterSpace : Type u
  /-- Map pushing pre-surgery sweepout parameters to post-surgery parameters. -/
  comparisonMap : sourceParameterSpace → targetParameterSpace
  /-- Selected pre-surgery parameter. -/
  sourceParameter : sourceParameterSpace
  /-- Selected post-surgery parameter. -/
  targetParameter : targetParameterSpace
  /-- The comparison map carries the selected source parameter to the target. -/
  comparisonMapSelected :
    comparisonMap sourceParameter = targetParameter
  /-- Selected source slice for the comparison. -/
  sourceSlice : Set M
  /-- Selected target slice after applying the comparison map. -/
  targetSlice : Set M
  /-- Point witnessing that the source slice is nonempty. -/
  sourceWitnessPoint : M
  /-- The source witness lies in the source slice. -/
  sourceWitnessMem : sourceWitnessPoint ∈ sourceSlice
  /-- Point witnessing that the target slice is nonempty. -/
  targetWitnessPoint : M
  /-- The target witness lies in the target slice. -/
  targetWitnessMem : targetWitnessPoint ∈ targetSlice
  /-- The selected target witness is transported from the source witness. -/
  comparisonCarriesWitness : targetWitnessPoint = sourceWitnessPoint
  /-- Width value attached to the selected source slice. -/
  sourceWidth : ℝ
  /-- Width value attached to the selected target slice. -/
  targetWidth : ℝ
  /-- Source width agrees with the metric-comparison pre-surgery width. -/
  sourceWidthEqMetricPre :
    sourceWidth = surgeryMetricComparisonPayload.preSurgeryWidth
  /-- Target width agrees with the metric-comparison post-surgery width. -/
  targetWidthEqMetricPost :
    targetWidth = surgeryMetricComparisonPayload.postSurgeryWidth
  /-- The comparison map transports the metric width bound. -/
  targetWidthLeSourceWidthPlusDistortion :
    targetWidth ≤
      sourceWidth + surgeryMetricComparisonPayload.metricDistortionBound

/-- The sweepout comparison map carries a nonempty source slice to a nonempty target slice with the stored width bound. -/
theorem FiniteExtinctionSurgeryWidthComparisonMapPayload.target_slice_transport_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    (payload :
      FiniteExtinctionSurgeryWidthComparisonMapPayload
        flow surgery control widthTheory widthEvolution) :
    ∃ sourcePoint targetPoint : M,
      sourcePoint ∈ payload.sourceSlice ∧
        targetPoint ∈ payload.targetSlice ∧
          targetPoint = sourcePoint ∧
            payload.targetWidth ≤
              payload.sourceWidth +
                payload.surgeryMetricComparisonPayload.metricDistortionBound := by
  exact
    ⟨payload.sourceWitnessPoint, payload.targetWitnessPoint,
      payload.sourceWitnessMem, payload.targetWitnessMem,
      payload.comparisonCarriesWitness,
      payload.targetWidthLeSourceWidthPlusDistortion⟩

