      ∃ _basePackage_eq :
        basePackage =
          surgery_package_of_equation_boundary_surgery_package package,
      ∃ _equationBoundary :
        RicciFlowEquationBoundaryPackage
          (ricci_flow_data_of_surgery_package
            (surgery_package_of_equation_boundary_surgery_package package)),
      ∃ verification :
        RicciFlowEquationVerification
          (curvature_data_of_ricci_flow_data
            (ricci_flow_data_of_surgery_package
              (surgery_package_of_equation_boundary_surgery_package package))),
      ∃ _verification_eq :
        verification =
