/--
Concrete payload for width drop/nonincrease across surgery.

The payload is attached to a concrete width-evolution comparison and records
the before/after surgery width values, a nonnegative drop amount, and the
explicit identity showing that the pre-surgery width decomposes as the
post-surgery width plus the drop.
-/
structure FiniteExtinctionSurgeryWidthDropPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (_widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory) :
    Type (u + 1) where
  /-- Concrete width-evolution data being compared across surgery. -/
  widthEvolutionPayload :
    FiniteExtinctionWidthEvolutionPayload flow surgery control widthTheory
  /-- Regularity of the evolving metric used in the surgery width comparison. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Post-surgery metric control used to compare widths. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow
  /-- Parameter space indexing the surgery drop comparison. -/
  surgeryDropParameterSpace : Type u
  /-- Parameter immediately before surgery. -/
  preSurgeryParameter : surgeryDropParameterSpace
  /-- Parameter immediately after surgery. -/
  postSurgeryParameter : surgeryDropParameterSpace
  /-- Width value immediately before surgery. -/
  preSurgeryWidth : ℝ
  /-- Width value immediately after surgery. -/
  postSurgeryWidth : ℝ
  /-- Pre-surgery width agrees with the width-evolution initial value. -/
  preSurgeryWidthEqEvolutionInitial :
    preSurgeryWidth = widthEvolutionPayload.initialWidthValue
  /-- Post-surgery width agrees with the width-evolution comparison value. -/
  postSurgeryWidthEqEvolutionComparison :
    postSurgeryWidth = widthEvolutionPayload.comparisonWidthValue
  /-- Nonnegative amount by which width drops across surgery. -/
  widthDropAmount : ℝ
  /-- The width drop amount is nonnegative. -/
  widthDropAmountNonnegative : 0 ≤ widthDropAmount
  /-- Width does not increase across surgery. -/
  postSurgeryWidthLePreSurgeryWidth :
    postSurgeryWidth ≤ preSurgeryWidth

/-- Width-drop payloads expose the pre/post widths, nonnegative drop, and nonincrease. -/
theorem FiniteExtinctionSurgeryWidthDropPayload.width_drop_accounting_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    (payload :
      FiniteExtinctionSurgeryWidthDropPayload
        flow surgery control widthTheory widthEvolution) :
    payload.preSurgeryWidth = payload.widthEvolutionPayload.initialWidthValue ∧
      payload.postSurgeryWidth =
        payload.widthEvolutionPayload.comparisonWidthValue ∧
      0 ≤ payload.widthDropAmount ∧
      payload.postSurgeryWidth ≤ payload.preSurgeryWidth := by
  exact
    ⟨payload.preSurgeryWidthEqEvolutionInitial,
      payload.postSurgeryWidthEqEvolutionComparison,
      payload.widthDropAmountNonnegative,
      payload.postSurgeryWidthLePreSurgeryWidth⟩

