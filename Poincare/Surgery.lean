/--
Concrete adjoint heat-kernel construction data along the backward flow.

The payload is tied to the conjugate heat equation payload. It records the
controlled kernel time interval, a nonnegative two-point kernel, unit-mass
normalization, and a residual certificate bounded by the conjugate heat
equation residual for the distinguished normalized solution.
-/
structure AdjointHeatKernelConstructionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    (conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload) :
    Type (u + 1) where
  /-- Scale on which adjoint heat kernels are constructed. -/
  adjointHeatKernelScale : ℝ
  /-- The adjoint heat-kernel construction scale is positive. -/
  adjointHeatKernelScalePositive : 0 < adjointHeatKernelScale
  /-- Conjugate heat control lies within the adjoint heat-kernel scale. -/
  conjugateHeatScale_le_adjointHeatKernelScale :
    conjugateHeatPayload.conjugateHeatScale ≤ adjointHeatKernelScale
  /-- Time interval on which the adjoint kernel is constructed. -/
  adjointHeatKernelTimeInterval : Set ℝ
  /-- The adjoint kernel interval is contained in the conjugate heat interval. -/
  adjointHeatKernelTimeInterval_subset_conjugateHeatInterval :
    ∀ t,
      t ∈ adjointHeatKernelTimeInterval →
        t ∈ conjugateHeatPayload.conjugateHeatTimeInterval
  /-- Source time for the constructed adjoint heat kernel. -/
  adjointHeatKernelSourceTime : ℝ
  /-- The source time belongs to the adjoint kernel time interval. -/
  adjointHeatKernelSourceTime_mem :
    adjointHeatKernelSourceTime ∈ adjointHeatKernelTimeInterval
  /-- Target time for the constructed adjoint heat kernel. -/
  adjointHeatKernelTargetTime : ℝ
  /-- The target time belongs to the adjoint kernel time interval. -/
  adjointHeatKernelTargetTime_mem :
    adjointHeatKernelTargetTime ∈ adjointHeatKernelTimeInterval
  /-- Backward-time ordering for the adjoint heat kernel. -/
  adjointHeatKernelBackwardTimeOrder :
    adjointHeatKernelTargetTime ≤ adjointHeatKernelSourceTime
  /-- Constructed two-point adjoint heat kernel. -/
  adjointHeatKernel : M → M → ℝ
  /-- The adjoint heat kernel is pointwise nonnegative. -/
  adjointHeatKernelNonnegative :
    ∀ source target, 0 ≤ adjointHeatKernel source target
  /-- Total mass of the adjoint heat kernel from each source point. -/
  adjointHeatKernelMass : M → ℝ
  /-- The constructed adjoint heat kernels have unit mass. -/
  adjointHeatKernelMass_eq_one :
    ∀ source, adjointHeatKernelMass source = 1
  /-- Pointwise residual of the adjoint heat-kernel equation. -/
  adjointHeatKernelEquationResidual : M → M → ℝ
  /-- The constructed kernel satisfies the adjoint heat-kernel equation. -/
  adjointHeatKernelEquation :
    ∀ source target,
      adjointHeatKernelEquationResidual source target = 0
  /-- Aggregate defect in the adjoint heat-kernel construction. -/
  adjointHeatKernelDefect : ℝ
  /-- The adjoint heat-kernel construction defect is nonnegative. -/
  adjointHeatKernelDefectNonnegative : 0 ≤ adjointHeatKernelDefect
  /-- The adjoint kernel defect is controlled by the conjugate heat residual. -/
  adjointHeatKernelDefect_le_conjugateHeatResidual :
    adjointHeatKernelDefect ≤
      conjugateHeatPayload.conjugateHeatResidual
        conjugateHeatPayload.baseConjugateHeatSolution

