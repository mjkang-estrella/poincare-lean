      entropyFirstVariationScale
  /-- Space of variations used by the first-variation formula. -/
  entropyVariationSpace : Type u
  /-- Distinguished variation used as a normalization reference. -/
  baseEntropyVariation : entropyVariationSpace
  /-- Map assigning a W-potential to each variation. -/
  variationToWPotential :
    entropyVariationSpace → wFunctionalPayload.wPotentialSpace
  /-- First-variation value for each variation. -/
  entropyFirstVariationValue : entropyVariationSpace → ℝ
  /-- The first variation agrees with the W-functional time derivative. -/
  entropyFirstVariationValue_eq_timeDerivative :
    ∀ variation,
      entropyFirstVariationValue variation =
        entropyGradientPayload.wFunctionalTimeDerivative
          (variationToWPotential variation)
  /-- Defect term in the first-variation formula. -/
  entropyFirstVariationDefect : entropyVariationSpace → ℝ
  /-- First-variation defects are nonnegative. -/
  entropyFirstVariationDefectNonnegative :
    ∀ variation, 0 ≤ entropyFirstVariationDefect variation
  /-- First-variation defects are controlled by entropy-gradient formula defects. -/
  entropyFirstVariationDefect_le_gradientDefect :
    ∀ variation,
      entropyFirstVariationDefect variation ≤
        entropyGradientPayload.entropyGradientFormulaDefect
          (variationToWPotential variation)
  /-- Linearization error in the first-variation formula. -/
  entropyFirstVariationLinearizationError :
    entropyVariationSpace → ℝ
  /-- Linearization errors are nonnegative. -/
  entropyFirstVariationLinearizationErrorNonnegative :
    ∀ variation, 0 ≤ entropyFirstVariationLinearizationError variation
  /-- Linearization errors are controlled by the first-variation defect. -/
  entropyFirstVariationLinearizationError_le_defect :
    ∀ variation,
      entropyFirstVariationLinearizationError variation ≤
        entropyFirstVariationDefect variation
  /-- First-variation identity with negative gradient dissipation plus defect. -/
  entropyFirstVariationIdentity :
    ∀ variation,
      entropyFirstVariationValue variation =
        - entropyGradientPayload.entropyGradientDissipation
            (variationToWPotential variation) +
          entropyFirstVariationDefect variation

