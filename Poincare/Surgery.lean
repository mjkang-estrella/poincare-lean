/--
Concrete contradiction-setup data for Perelman's no-local-collapsing theorem.

The payload is tied to the kappa-from-reduced-volume payload. It records the
hypothetical collapsed-ball configurations, their local scales and rescaling
data, and the conditional collapse hypothesis whose volume-ratio upper bound is
incompatible with the kappa lower bound supplied by reduced volume.
-/
structure PerelmanNoLocalCollapsingContradictionSetupPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {reducedVolumeNonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    (kappaNoncollapsingFromReducedVolumePayload :
      PerelmanKappaNoncollapsingFromReducedVolumePayload
        reducedVolumeNonincreasingPayload) : Type (u + 1) where
  /-- Domain of hypothetical locally collapsed ball configurations. -/
  collapsedBallSetupDomain : Type u
  /-- Center of each hypothetical collapsed ball. -/
  collapsedBallCenter : collapsedBallSetupDomain → M
  /-- Time assigned to each hypothetical collapsed ball. -/
  collapsedBallTime : collapsedBallSetupDomain → ℝ
  /-- Radius of each hypothetical collapsed ball. -/
  collapsedBallRadius : collapsedBallSetupDomain → ℝ
  /-- Collapsed-ball radii are positive. -/
  collapsedBallRadiusPositive :
    ∀ setup, 0 < collapsedBallRadius setup
  /-- Hypothesis that a setup is a collapsed-ball counterexample. -/
  collapseHypothesis : collapsedBallSetupDomain → Prop
  /-- Comparison kappa-ball associated to a hypothetical collapsed ball. -/
  collapsedBallToKappaBall :
    collapsedBallSetupDomain →
      kappaNoncollapsingFromReducedVolumePayload.kappaNoncollapsedBallDomain
  /-- Recorded collapsed volume ratio for each hypothetical setup. -/
  collapsedVolumeRatio : collapsedBallSetupDomain → ℝ
  /-- Collapsed volume ratios agree with the kappa comparison ball ratios. -/
  collapsedVolumeRatio_eq_ballVolumeRatio :
    ∀ setup,
      collapsedVolumeRatio setup =
        kappaNoncollapsingFromReducedVolumePayload.ballVolumeRatio
          (collapsedBallToKappaBall setup)
  /-- Threshold appearing in the local-collapsing contradiction hypothesis. -/
  collapseThreshold : ℝ
  /-- The collapse threshold is positive. -/
  collapseThresholdPositive : 0 < collapseThreshold
  /-- The collapse threshold lies below the reduced-volume kappa constant. -/
  collapseThreshold_lt_kappaConstant :
    collapseThreshold <
      kappaNoncollapsingFromReducedVolumePayload.kappaFromReducedVolumeConstant
  /-- The collapse hypothesis gives an upper volume-ratio bound. -/
  collapseHypothesis_volumeRatio_le_threshold :
    ∀ setup,
      collapseHypothesis setup →
        collapsedVolumeRatio setup ≤ collapseThreshold
  /-- Curvature scale assigned to the collapsed-ball setup. -/
  contradictionCurvatureScale : collapsedBallSetupDomain → ℝ
  /-- Curvature scales are positive. -/
  contradictionCurvatureScalePositive :
    ∀ setup, 0 < contradictionCurvatureScale setup
  /-- Parabolic rescaling factor used for the collapsed-ball blowup. -/
  contradictionRescalingFactor : collapsedBallSetupDomain → ℝ
  /-- Rescaling factors are positive. -/
  contradictionRescalingFactorPositive :
    ∀ setup, 0 < contradictionRescalingFactor setup
  /-- Blowup time associated to a hypothetical collapsed ball. -/
  contradictionBlowupTime : collapsedBallSetupDomain → ℝ
  /-- Blowup radius after rescaling. -/
  contradictionBlowupRadius : collapsedBallSetupDomain → ℝ
  /-- Blowup radii are positive. -/
  contradictionBlowupRadiusPositive :
    ∀ setup, 0 < contradictionBlowupRadius setup
  /-- Collapsed-ball radii lie inside the kappa-from-reduced-volume scale. -/
  collapsedBallRadius_le_kappaScale :
    ∀ setup,
      collapsedBallRadius setup ≤
        kappaNoncollapsingFromReducedVolumePayload.kappaFromReducedVolumeScale
  /-- The rescaling factor is normalized against the curvature scale. -/
  rescalingFactor_mul_curvatureScale_eq_one :
    ∀ setup,
      contradictionRescalingFactor setup *
          contradictionCurvatureScale setup =
        1
  /-- Envelope controlling the contradiction-setup data. -/
  contradictionSetupEnvelope : ℝ
  /-- The contradiction-setup envelope is nonnegative. -/
  contradictionSetupEnvelopeNonnegative :
    0 ≤ contradictionSetupEnvelope
  /-- The kappa-from-reduced-volume envelope is absorbed by the setup envelope. -/
  kappaEnvelope_le_contradictionSetupEnvelope :
    kappaNoncollapsingFromReducedVolumePayload.kappaFromReducedVolumeEnvelope ≤
      contradictionSetupEnvelope
  /-- Collapsed-ball volume ratios are controlled by the setup envelope. -/
  collapsedVolumeRatio_le_contradictionSetupEnvelope :
    ∀ setup, collapsedVolumeRatio setup ≤ contradictionSetupEnvelope

