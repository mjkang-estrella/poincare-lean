      payload.cutLocusBarrierResidualBound :=
  le_trans
    (reducedDistanceEstimatesPayload.barrierHamiltonJacobiResidual_le_estimateBound
      test)
    payload.barrierResidualEstimateBound_le_cutLocusBarrierResidualBound

