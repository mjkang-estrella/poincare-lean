  /-- Scale on which the kappa-from-reduced-volume estimate is asserted. -/
  kappaFromReducedVolumeScale : ℝ
  /-- The kappa-from-reduced-volume scale is positive. -/
  kappaFromReducedVolumeScalePositive :
    0 < kappaFromReducedVolumeScale
  /-- Reduced-volume nonincreasing control lies within the kappa scale. -/
  nonincreasingScale_le_kappaScale :
    reducedVolumeNonincreasingPayload.reducedVolumeNonincreasingScale ≤
      kappaFromReducedVolumeScale
  /-- Positive kappa constant obtained from reduced-volume control. -/
  kappaFromReducedVolumeConstant : ℝ
  /-- The kappa constant is positive. -/
  kappaFromReducedVolumeConstantPositive :
    0 < kappaFromReducedVolumeConstant
  /-- The kappa constant is below the reduced-volume lower-bound constant. -/
  kappaConstant_le_reducedVolumeLowerBoundConstant :
    kappaFromReducedVolumeConstant ≤
      reducedVolumePositiveLowerBoundPayload.reducedVolumeLowerBoundConstant
  /-- Domain of reduced-volume-to-volume-ratio comparisons. -/
