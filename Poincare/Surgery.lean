  /-- Pointwise residuals of the adjoint heat equation are controlled by the estimate defect. -/
  adjointHeatKernelResidual_le_estimateDefect :
    ∀ source target,
      adjointHeatPayload.adjointHeatKernelEquationResidual source target ≤
        heatKernelEstimateDefect

