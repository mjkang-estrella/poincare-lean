/--
Concrete reduced-volume rigidity/equality-case data for the Perelman package.

The payload is tied to the reduced-volume derivative formula. It records the
equality-case tests, the vanishing derivative and residual data, a rigidity
defect identified with the derivative-formula dissipation, and the conclusion
that follows when the defect vanishes.
-/
structure PerelmanReducedVolumeRigidityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    (reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload) : Type (u + 1) where
  /-- Scale on which reduced-volume rigidity is asserted. -/
  reducedVolumeRigidityScale : ℝ
  /-- The reduced-volume rigidity scale is positive. -/
  reducedVolumeRigidityScalePositive :
    0 < reducedVolumeRigidityScale
  /-- Derivative-formula control lies within the rigidity scale. -/
  derivativeFormulaScale_le_rigidityScale :
    reducedVolumeDerivativeFormulaPayload.reducedVolumeDerivativeFormulaScale ≤
      reducedVolumeRigidityScale
  /-- Equality-case domain for reduced-volume monotonicity. -/
  reducedVolumeEqualityCaseDomain : Type u
  /-- Derivative-formula test associated to each equality case. -/
  equalityCaseToDerivativeTest :
    reducedVolumeEqualityCaseDomain →
      reducedVolumeDerivativeFormulaPayload.reducedVolumeDerivativeTestDomain
  /-- The reduced-volume derivative vanishes in equality cases. -/
  equalityCaseTimeDerivative_zero :
    ∀ equalityCase,
      reducedVolumeDerivativeFormulaPayload.reducedVolumeTimeDerivative
          (equalityCaseToDerivativeTest equalityCase) =
        0
  /-- The derivative-formula residual vanishes in equality cases. -/
  equalityCaseResidual_zero :
    ∀ equalityCase,
      reducedVolumeDerivativeFormulaPayload.reducedVolumeDerivativeFormulaResidual
          (equalityCaseToDerivativeTest equalityCase) =
        0
  /-- Rigid model domain assigned to equality cases. -/
  reducedVolumeRigidModelDomain : Type u
  /-- Rigid model selected by each equality case. -/
  equalityCaseToRigidModel :
    reducedVolumeEqualityCaseDomain → reducedVolumeRigidModelDomain
  /-- Defect measuring failure of the rigidity conclusion. -/
  reducedVolumeRigidityDefect :
    reducedVolumeEqualityCaseDomain → ℝ
  /-- The rigidity defect is nonnegative. -/
  reducedVolumeRigidityDefectNonnegative :
    ∀ equalityCase, 0 ≤ reducedVolumeRigidityDefect equalityCase
  /-- The rigidity defect is the reduced-volume dissipation in the equality case. -/
  reducedVolumeRigidityDefect_eq_dissipation :
    ∀ equalityCase,
      reducedVolumeRigidityDefect equalityCase =
        reducedVolumeDerivativeFormulaPayload.reducedVolumeDissipation
          (equalityCaseToDerivativeTest equalityCase)
  /-- Proposition expressing the rigidity conclusion for each equality case. -/
  reducedVolumeRigidityConclusion :
    reducedVolumeEqualityCaseDomain → Prop
  /-- Vanishing defect implies the recorded rigidity conclusion. -/
  reducedVolumeRigidityConclusion_of_zeroDefect :
    ∀ equalityCase,
      reducedVolumeRigidityDefect equalityCase = 0 →
        reducedVolumeRigidityConclusion equalityCase
  /-- Envelope controlling the rigidity defect and model data. -/
  reducedVolumeRigidityEnvelope : ℝ
  /-- The reduced-volume rigidity envelope is nonnegative. -/
  reducedVolumeRigidityEnvelopeNonnegative :
    0 ≤ reducedVolumeRigidityEnvelope
  /-- Derivative-formula data are absorbed by the rigidity envelope. -/
  derivativeFormulaEnvelope_le_rigidityEnvelope :
    reducedVolumeDerivativeFormulaPayload.reducedVolumeDerivativeFormulaEnvelope ≤
      reducedVolumeRigidityEnvelope
  /-- Rigidity defects are bounded by the rigidity envelope. -/
  reducedVolumeRigidityDefect_le_envelope :
    ∀ equalityCase,
      reducedVolumeRigidityDefect equalityCase ≤
        reducedVolumeRigidityEnvelope

