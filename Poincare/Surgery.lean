        classificationPayload.classificationNeckScale
          (canonicalNeighborhoodRegionToModel region)
  /-- The theorem-level neck scales are positive. -/
  canonicalNeighborhoodRegionNeckScalePositive :
    ∀ region, 0 < canonicalNeighborhoodRegionNeckScale region
  /-- The theorem-level cap scale assigned to a covered region. -/
  canonicalNeighborhoodRegionCapScale :
    canonicalNeighborhoodTheoremRegionDomain → ℝ
  /-- Region cap scales agree with the classification payload scales. -/
  canonicalNeighborhoodRegionCapScale_eq_classificationCapScale :
    ∀ region,
      canonicalNeighborhoodRegionCapScale region =
        classificationPayload.classificationCapScale
          (canonicalNeighborhoodRegionToModel region)
  /-- The theorem-level cap scales are positive. -/
  canonicalNeighborhoodRegionCapScalePositive :
    ∀ region, 0 < canonicalNeighborhoodRegionCapScale region
  /-- Defect measuring theorem-level canonical-neighborhood coverage. -/
  canonicalNeighborhoodRegionDefect :
    canonicalNeighborhoodTheoremRegionDomain → ℝ
  /-- The region coverage defects are nonnegative. -/
  canonicalNeighborhoodRegionDefectNonnegative :
    ∀ region, 0 ≤ canonicalNeighborhoodRegionDefect region
  /-- Region coverage defects are bounded by the theorem envelope. -/
  canonicalNeighborhoodRegionDefect_le_envelope :
    ∀ region,
      canonicalNeighborhoodRegionDefect region ≤
        canonicalNeighborhoodTheoremEnvelope

