/--
Concrete reduced-volume limit-rigidity data for equality and almost-equality
cases.

The payload is tied to the positive lower-bound payload. It records the limit
case domain, the defect measuring failure of sharpness at the lower bound, the
rigidity conclusion for exact limit cases, and almost-equality defects that
specialize to the recorded limit-case defect.
-/
structure PerelmanReducedVolumeLimitRigidityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    (reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload) : Type (u + 1) where
  /-- Scale on which limit rigidity is asserted. -/
  reducedVolumeLimitRigidityScale : ℝ
  /-- The limit-rigidity scale is positive. -/
  reducedVolumeLimitRigidityScalePositive :
    0 < reducedVolumeLimitRigidityScale
  /-- Positive lower-bound control lies within the limit-rigidity scale. -/
  positiveLowerBoundScale_le_limitRigidityScale :
    reducedVolumePositiveLowerBoundPayload.reducedVolumePositiveLowerBoundScale ≤
      reducedVolumeLimitRigidityScale
  /-- Domain of exact reduced-volume limit cases. -/
  reducedVolumeLimitCaseDomain : Type u
  /-- Equality-case data associated to each limit case. -/
  limitCaseToRigidityEqualityCase :
    reducedVolumeLimitCaseDomain →
      reducedVolumeRigidityPayload.reducedVolumeEqualityCaseDomain
  /-- Reduced-volume value assigned to each limit case. -/
  reducedVolumeLimitCaseValue : reducedVolumeLimitCaseDomain → ℝ
  /-- Limit-case values agree with the reduced-volume definition value. -/
  reducedVolumeLimitCaseValue_eq_definitionValue :
    ∀ limitCase,
      reducedVolumeLimitCaseValue limitCase =
        reducedVolumeDefinitionPayload.reducedVolumeValue
  /-- Defect measuring failure of lower-bound sharpness in a limit case. -/
  reducedVolumeLimitRigidityDefect : reducedVolumeLimitCaseDomain → ℝ
  /-- The limit-rigidity defect is nonnegative. -/
  reducedVolumeLimitRigidityDefectNonnegative :
    ∀ limitCase, 0 ≤ reducedVolumeLimitRigidityDefect limitCase
  /-- The defect is the gap between the limit value and the lower-bound constant. -/
  reducedVolumeLimitRigidityDefect_eq_value_sub_lowerBound :
    ∀ limitCase,
      reducedVolumeLimitRigidityDefect limitCase =
        reducedVolumeLimitCaseValue limitCase -
          reducedVolumePositiveLowerBoundPayload.reducedVolumeLowerBoundConstant
  /-- Rigid model domain for exact limit cases. -/
  reducedVolumeLimitRigidModelDomain : Type u
  /-- Rigid model selected by each exact limit case. -/
  reducedVolumeLimitRigidModel :
    reducedVolumeLimitCaseDomain → reducedVolumeLimitRigidModelDomain
  /-- Proposition expressing the limit-rigidity conclusion. -/
  reducedVolumeLimitRigidityConclusion :
    reducedVolumeLimitCaseDomain → Prop
  /-- Vanishing limit defect implies the limit-rigidity conclusion. -/
  reducedVolumeLimitRigidityConclusion_of_zeroDefect :
    ∀ limitCase,
      reducedVolumeLimitRigidityDefect limitCase = 0 →
        reducedVolumeLimitRigidityConclusion limitCase
  /-- Earlier equality-case rigidity implies the limit-rigidity conclusion. -/
  reducedVolumeLimitRigidityConclusion_of_rigidityEqualityCase :
    ∀ limitCase,
      reducedVolumeRigidityPayload.reducedVolumeRigidityConclusion
          (limitCaseToRigidityEqualityCase limitCase) →
        reducedVolumeLimitRigidityConclusion limitCase
  /-- Domain of almost-equality cases converging to recorded limit cases. -/
  reducedVolumeAlmostEqualityCaseDomain : Type u
  /-- Limit case associated to an almost-equality case. -/
  almostEqualityToLimitCase :
    reducedVolumeAlmostEqualityCaseDomain → reducedVolumeLimitCaseDomain
  /-- Defect of an almost-equality case. -/
  reducedVolumeAlmostEqualityDefect :
    reducedVolumeAlmostEqualityCaseDomain → ℝ
  /-- Almost-equality defects specialize to the corresponding limit-case defect. -/
  reducedVolumeAlmostEqualityDefect_eq_limitDefect :
    ∀ almostCase,
      reducedVolumeAlmostEqualityDefect almostCase =
        reducedVolumeLimitRigidityDefect
          (almostEqualityToLimitCase almostCase)
  /-- Envelope controlling exact and almost-equality limit-rigidity data. -/
  reducedVolumeLimitRigidityEnvelope : ℝ
  /-- The limit-rigidity envelope is nonnegative. -/
  reducedVolumeLimitRigidityEnvelopeNonnegative :
    0 ≤ reducedVolumeLimitRigidityEnvelope
  /-- Positive lower-bound data are absorbed by the limit-rigidity envelope. -/
  positiveLowerBoundEnvelope_le_limitRigidityEnvelope :
    reducedVolumePositiveLowerBoundPayload.reducedVolumeLowerBoundEnvelope ≤
      reducedVolumeLimitRigidityEnvelope
  /-- Limit-rigidity defects are controlled by the envelope. -/
  reducedVolumeLimitRigidityDefect_le_envelope :
    ∀ limitCase,
      reducedVolumeLimitRigidityDefect limitCase ≤
        reducedVolumeLimitRigidityEnvelope

