/--
Concrete pointed parabolic-rescaling data for the extracted ancient
kappa-solution limit.

The payload is tied to ancient limit-extraction data. It records the pointed
rescaling domain, its map to the extracted limit and original blowup sequence,
basepoints, times, parabolic factors, rescaled models, and envelope controls.
-/
structure KappaSolutionPointedRescalingPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {reducedVolumeNonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    {kappaNoncollapsingFromReducedVolumePayload :
      PerelmanKappaNoncollapsingFromReducedVolumePayload
        reducedVolumeNonincreasingPayload}
    {noLocalCollapsingContradictionSetupPayload :
      PerelmanNoLocalCollapsingContradictionSetupPayload
        kappaNoncollapsingFromReducedVolumePayload}
    {collapsedBallBlowupPayload :
      PerelmanCollapsedBallBlowupPayload
        noLocalCollapsingContradictionSetupPayload}
    {hamiltonCompactnessPayload :
      HamiltonCompactnessPayload collapsedBallBlowupPayload}
    (limitExtractionPayload :
      AncientKappaSolutionLimitExtractionPayload
        hamiltonCompactnessPayload) : Type (u + 1) where
  /-- Index domain for pointed parabolic rescalings. -/
  pointedRescalingDomain : Type u
  /-- Distinguished pointed-rescaling index. -/
  basePointedRescalingIndex : pointedRescalingDomain
  /-- Map from pointed-rescaling indices to ancient limit-extraction indices. -/
  pointedRescalingToLimitExtractionIndex :
    pointedRescalingDomain → limitExtractionPayload.limitExtractionDomain
  /-- Map from pointed-rescaling indices to the original blowup sequence. -/
  pointedRescalingToBlowupIndex :
    pointedRescalingDomain → collapsedBallBlowupPayload.blowupIndexDomain
  /-- The blowup-index map is induced by limit extraction and Hamilton compactness. -/
  pointedRescalingToBlowupIndex_eq_compactnessBlowupIndex :
    ∀ index,
      pointedRescalingToBlowupIndex index =
        hamiltonCompactnessPayload.subsequenceToBlowupIndex
          (limitExtractionPayload.limitExtractionToCompactnessIndex
            (pointedRescalingToLimitExtractionIndex index))
  /-- Pointed basepoint for each rescaled model. -/
  pointedRescalingBasepoint : pointedRescalingDomain → M
  /-- The pointed basepoint agrees with the collapsed-ball blowup basepoint. -/
  pointedRescalingBasepoint_eq_blowupBasepoint :
    ∀ index,
      pointedRescalingBasepoint index =
        collapsedBallBlowupPayload.blowupBasepoint
          (pointedRescalingToBlowupIndex index)
  /-- Time coordinate for each pointed rescaling. -/
  pointedRescalingTime : pointedRescalingDomain → ℝ
  /-- The pointed rescaling time agrees with the collapsed-ball blowup time. -/
  pointedRescalingTime_eq_blowupTime :
    ∀ index,
      pointedRescalingTime index =
        collapsedBallBlowupPayload.blowupTime
          (pointedRescalingToBlowupIndex index)
  /-- Radius scale used by each pointed rescaling. -/
  pointedRescalingRadius : pointedRescalingDomain → ℝ
  /-- Pointed rescaling radii agree with collapsed-ball blowup radii. -/
  pointedRescalingRadius_eq_blowupRadius :
    ∀ index,
      pointedRescalingRadius index =
        collapsedBallBlowupPayload.blowupRadius
          (pointedRescalingToBlowupIndex index)
  /-- Parabolic rescaling factor at each pointed rescaling. -/
  parabolicRescalingFactor : pointedRescalingDomain → ℝ
  /-- Parabolic rescaling factors agree with collapsed-ball rescaling factors. -/
  parabolicRescalingFactor_eq_blowupRescalingFactor :
    ∀ index,
      parabolicRescalingFactor index =
        collapsedBallBlowupPayload.rescalingFactor
          (pointedRescalingToBlowupIndex index)
  /-- Rescaled pointed model attached to each pointed-rescaling index. -/
  pointedRescaledModelAtIndex :
    pointedRescalingDomain →
      collapsedBallBlowupPayload.rescaledFlowModel
  /-- Pointed rescaled models agree with collapsed-ball rescaled flows. -/
  pointedRescaledModelAtIndex_eq_blowupRescaledFlow :
    ∀ index,
      pointedRescaledModelAtIndex index =
        collapsedBallBlowupPayload.rescaledFlowAtIndex
          (pointedRescalingToBlowupIndex index)
  /-- Pointed limit model selected by the rescaling package. -/
  pointedRescalingLimitModel :
    collapsedBallBlowupPayload.rescaledFlowModel
  /-- The pointed rescaling limit agrees with the extracted ancient limit. -/
  pointedRescalingLimitModel_eq_ancientLimit :
    pointedRescalingLimitModel =
      limitExtractionPayload.ancientLimitFlowModel
  /-- Curvature scale of each pointed rescaling. -/
  pointedRescalingCurvatureScale : pointedRescalingDomain → ℝ
  /-- Pointed curvature scales agree with the collapsed-ball rescaled scales. -/
  pointedRescalingCurvatureScale_eq_blowupCurvatureScale :
    ∀ index,
      pointedRescalingCurvatureScale index =
        collapsedBallBlowupPayload.rescaledCurvatureScale
          (pointedRescalingToBlowupIndex index)
  /-- Kappa scale retained by the pointed rescaling package. -/
  pointedRescalingKappaScale : ℝ
  /-- The pointed-rescaling kappa scale is inherited from limit extraction. -/
  pointedRescalingKappaScale_eq_ancientLimitKappaScale :
    pointedRescalingKappaScale =
      limitExtractionPayload.ancientLimitKappaScale
  /-- Aggregate envelope for pointed-rescaling data. -/
  pointedRescalingEnvelope : ℝ
  /-- The aggregate pointed-rescaling envelope is nonnegative. -/
  pointedRescalingEnvelopeNonnegative :
    0 ≤ pointedRescalingEnvelope
  /-- Ancient limit-extraction data are absorbed by the pointed-rescaling envelope. -/
  ancientLimitExtractionEnvelope_le_pointedRescalingEnvelope :
    limitExtractionPayload.ancientLimitExtractionEnvelope ≤
      pointedRescalingEnvelope
  /-- Pointed rescaling radii are controlled by the pointed-rescaling envelope. -/
  pointedRescalingRadius_le_envelope :
    ∀ index, pointedRescalingRadius index ≤ pointedRescalingEnvelope
  /-- Parabolic rescaling factors are controlled by the pointed-rescaling envelope. -/
  parabolicRescalingFactor_le_envelope :
    ∀ index, parabolicRescalingFactor index ≤ pointedRescalingEnvelope

