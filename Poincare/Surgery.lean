/--
Concrete payload for the second-variation/stability inequality in the finite
extinction width argument.

The payload keeps the first-variation data at the stationary slice, adds the
Perelman/noncollapsing control used in the stability regime, and records a
second-variation functional with a nonnegative lower bound at the stationary
parameter.
-/
structure FiniteExtinctionSecondVariationInequalityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  /-- First-variation payload at the stationary width-realizing slice. -/
  firstVariationPayload :
    FiniteExtinctionFirstVariationFormulaPayload
      flow surgery control widthTheory
  /-- Metric regularity needed for the second variation of area. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Canonical-neighborhood input for the stability regime. -/
  canonicalNeighborhood : HasCanonicalNeighborhoodTheorem flow
  /-- No-local-collapsing input used in compactness/stability estimates. -/
  noLocalCollapsing : HasPerelmanNoLocalCollapsing flow
  /-- Post-surgery noncollapsing control used for stability through surgery. -/
  postSurgeryNoncollapsing : HasPostSurgeryNoncollapsingControl flow
  /-- Parameter space on which the second-variation functional is evaluated. -/
  variationParameterSpace : Type u
  /-- Stationary parameter where the stability inequality is asserted. -/
  stableParameter : variationParameterSpace
  /-- First-variation functional inherited from the stationary min-max slice. -/
  firstVariationFunctional : variationParameterSpace → ℝ
  /-- First variation vanishes at the stable parameter. -/
  firstVariationZeroAtStableParameter :
    firstVariationFunctional stableParameter = 0
  /-- Second-variation functional for the selected stable slice. -/
  secondVariationFunctional : variationParameterSpace → ℝ
  /-- Lower bound appearing in the stability inequality. -/
  secondVariationLowerBound : ℝ
  /-- Stability inequality at the selected parameter. -/
  secondVariationBound :
    secondVariationLowerBound ≤ secondVariationFunctional stableParameter
  /-- The selected lower bound is nonnegative. -/
  nonnegativeSecondVariationLowerBound :
    0 ≤ secondVariationLowerBound
  /-- Area value of the stable slice. -/
  stableAreaValue : ℝ
  /-- Width value controlling the stable slice. -/
  widthValue : ℝ
  /-- The stable slice area remains bounded by the width. -/
  stableAreaLeWidth : stableAreaValue ≤ widthValue

