        conjugateHeatKernelEstimatesPayload) : Type (u + 1) where
  /-- Scale on which the entropy-gradient formula is controlled. -/
  entropyGradientScale : ℝ
  /-- The entropy-gradient formula scale is positive. -/
  entropyGradientScalePositive : 0 < entropyGradientScale
  /-- W-functional control lies within the entropy-gradient formula scale. -/
  wFunctionalScale_le_entropyGradientScale :
    wFunctionalPayload.wFunctionalScale ≤ entropyGradientScale
  /-- Formal gradient field for each W-potential. -/
  entropyGradientField :
    wFunctionalPayload.wPotentialSpace → M → ℝ
  /-- Squared norm of the formal entropy gradient. -/
  entropyGradientNormSquared :
    wFunctionalPayload.wPotentialSpace → M → ℝ
  /-- Squared gradient norms are nonnegative. -/
  entropyGradientNormSquaredNonnegative :
    ∀ potential x, 0 ≤ entropyGradientNormSquared potential x
  /-- Aggregate entropy-gradient dissipation for each W-potential. -/
  entropyGradientDissipation :
    wFunctionalPayload.wPotentialSpace → ℝ
  /-- Entropy-gradient dissipation is nonnegative. -/
  entropyGradientDissipationNonnegative :
    ∀ potential, 0 ≤ entropyGradientDissipation potential
  /-- Time derivative of the W-functional along the entropy-gradient flow. -/
  wFunctionalTimeDerivative :
    wFunctionalPayload.wPotentialSpace → ℝ
  /-- Defect term in the entropy-gradient formula. -/
  entropyGradientFormulaDefect :
    wFunctionalPayload.wPotentialSpace → ℝ
  /-- Entropy-gradient formula defects are nonnegative. -/
  entropyGradientFormulaDefectNonnegative :
    ∀ potential, 0 ≤ entropyGradientFormulaDefect potential
  /-- Entropy-gradient formula defects are controlled by W-functional setup defects. -/
  entropyGradientFormulaDefect_le_wFunctionalSetupDefect :
    ∀ potential,
      entropyGradientFormulaDefect potential ≤
        wFunctionalPayload.wFunctionalSetupDefect potential
  /-- Gradient identity: variation is negative dissipation plus controlled defect. -/
  entropyGradientFormulaIdentity :
