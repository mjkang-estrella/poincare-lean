/--
Concrete reduced-distance theory data for the Perelman package.

The payload is tied to the accepted reduced-distance chain through
reduced-Jacobian comparison. It records a common spacetime domain for
reduced-distance values, compatibility with minimizers and smooth test data,
and envelope bounds that package the reduced-distance and reduced-Jacobian
estimates needed by downstream reduced-volume arguments.
-/
structure PerelmanReducedDistanceTheoryPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    (reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload) : Type (u + 1) where
  /-- Scale on which the reduced-distance theory package is asserted. -/
  reducedDistanceTheoryScale : ℝ
  /-- The reduced-distance theory scale is positive. -/
  reducedDistanceTheoryScalePositive :
    0 < reducedDistanceTheoryScale
  /-- Reduced-Jacobian comparison lies within the reduced-distance theory scale. -/
  reducedJacobianComparisonScale_le_reducedDistanceTheoryScale :
    reducedJacobianComparisonPayload.reducedJacobianComparisonScale ≤
      reducedDistanceTheoryScale
  /-- Domain carrying reduced-distance values for downstream reduced-volume use. -/
  reducedDistanceTheoryDomain : Type u
  /-- Minimizer represented by each reduced-distance theory point. -/
  theoryPointToMinimizer :
    reducedDistanceTheoryDomain →
      reducedDistanceExistencePayload.reducedDistanceMinimizerSpace
  /-- Smooth reduced-distance test represented by each theory point. -/
  theoryPointToSmoothTest :
    reducedDistanceTheoryDomain →
      reducedDistanceDifferentialInequalityPayload.smoothReducedDistanceTestDomain
  /-- Spatial point represented by each reduced-distance theory point. -/
  reducedDistanceTheoryPoint : reducedDistanceTheoryDomain → M
  /-- Theory points agree with the smooth-test points from cut-locus control. -/
  reducedDistanceTheoryPoint_eq_smoothTestPoint :
    ∀ point,
      reducedDistanceTheoryPoint point =
        reducedDistanceCutLocusControlPayload.smoothTestPoint
          (theoryPointToSmoothTest point)
  /-- Reduced-distance value assigned to each theory point. -/
  reducedDistanceTheoryValue : reducedDistanceTheoryDomain → ℝ
  /-- Theory reduced-distance values agree with minimizer values. -/
  reducedDistanceTheoryValue_eq_minimizerValue :
    ∀ point,
      reducedDistanceTheoryValue point =
        reducedDistanceExistencePayload.reducedDistanceValue
          (theoryPointToMinimizer point)
  /-- Theory reduced-distance values agree with smooth-test values. -/
  reducedDistanceTheoryValue_eq_smoothValue :
    ∀ point,
      reducedDistanceTheoryValue point =
        reducedDistanceDifferentialInequalityPayload.smoothReducedDistanceValue
          (theoryPointToSmoothTest point)
  /-- Lower reduced-distance bound on the theory domain. -/
  reducedDistanceTheoryLowerBound : ℝ
  /-- Upper reduced-distance bound on the theory domain. -/
  reducedDistanceTheoryUpperBound : ℝ
  /-- The lower theory bound is below the upper theory bound. -/
  reducedDistanceTheoryLowerBound_le_upperBound :
    reducedDistanceTheoryLowerBound ≤ reducedDistanceTheoryUpperBound
  /-- Theory reduced-distance values are bounded below. -/
  reducedDistanceTheoryLowerBound_le_value :
    ∀ point,
      reducedDistanceTheoryLowerBound ≤
        reducedDistanceTheoryValue point
  /-- Theory reduced-distance values are bounded above. -/
  reducedDistanceTheoryValue_le_upperBound :
    ∀ point,
      reducedDistanceTheoryValue point ≤
        reducedDistanceTheoryUpperBound
  /-- Common envelope for reduced-distance and reduced-Jacobian estimates. -/
  reducedDistanceTheoryEnvelope : ℝ
  /-- The common theory envelope is nonnegative. -/
  reducedDistanceTheoryEnvelopeNonnegative :
    0 ≤ reducedDistanceTheoryEnvelope
  /-- The upper reduced-distance bound is absorbed by the common envelope. -/
  reducedDistanceTheoryUpperBound_le_envelope :
    reducedDistanceTheoryUpperBound ≤ reducedDistanceTheoryEnvelope
  /-- Reduced-distance blow-up estimates are absorbed by the theory envelope. -/
  reducedDistanceBlowupEstimateConstant_le_theoryEnvelope :
    reducedDistanceEstimatesPayload.reducedDistanceBlowupEstimateConstant ≤
      reducedDistanceTheoryEnvelope
  /-- Reduced-Jacobian comparison estimates are absorbed by the theory envelope. -/
  reducedJacobianComparisonEnvelope_le_theoryEnvelope :
    reducedJacobianComparisonPayload.reducedJacobianComparisonEnvelope ≤
      reducedDistanceTheoryEnvelope

