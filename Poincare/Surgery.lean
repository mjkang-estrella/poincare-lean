/--
Concrete first-variation data for Perelman's reduced length.

The payload is tied to the entropy-functional payload. It records a variation
space, reduced-length values, first-variation values, and a controlled defect
relating the first variation to the entropy-functional value of the associated
state.
-/
structure PerelmanReducedLengthFirstVariationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    (entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload) : Type (u + 1) where
  /-- Scale on which the reduced-length first variation is controlled. -/
  reducedLengthFirstVariationScale : ℝ
  /-- The reduced-length first-variation scale is positive. -/
  reducedLengthFirstVariationScalePositive :
    0 < reducedLengthFirstVariationScale
  /-- Entropy-functional control lies within the reduced-length scale. -/
  entropyFunctionalScale_le_reducedLengthFirstVariationScale :
    entropyFunctionalPayload.entropyFunctionalScale ≤
      reducedLengthFirstVariationScale
  /-- Space of reduced-length variations. -/
  reducedLengthVariationSpace : Type u
  /-- Distinguished reduced-length variation. -/
  baseReducedLengthVariation : reducedLengthVariationSpace
  /-- Entropy state associated to each reduced-length variation. -/
  reducedLengthVariationToEntropyState :
    reducedLengthVariationSpace →
      entropyFunctionalPayload.entropyStateSpace
  /-- Reduced-length value for each variation. -/
  reducedLengthValue : reducedLengthVariationSpace → ℝ
  /-- First-variation value of reduced length. -/
  reducedLengthFirstVariationValue :
    reducedLengthVariationSpace → ℝ
  /-- Defect term in the reduced-length first-variation formula. -/
  reducedLengthFirstVariationDefect :
    reducedLengthVariationSpace → ℝ
  /-- Reduced-length first-variation defects are nonnegative. -/
  reducedLengthFirstVariationDefectNonnegative :
    ∀ variation, 0 ≤ reducedLengthFirstVariationDefect variation
  /-- The first-variation value is controlled by entropy-functional data. -/
  reducedLengthFirstVariationIdentity :
    ∀ variation,
      reducedLengthFirstVariationValue variation =
        entropyFunctionalPayload.entropyFunctionalValue
          (reducedLengthVariationToEntropyState variation) +
        reducedLengthFirstVariationDefect variation
  /-- Linearization error in the reduced-length first-variation formula. -/
  reducedLengthLinearizationError :
    reducedLengthVariationSpace → ℝ
  /-- Linearization errors are nonnegative. -/
  reducedLengthLinearizationErrorNonnegative :
    ∀ variation, 0 ≤ reducedLengthLinearizationError variation
  /-- Linearization errors are controlled by first-variation defects. -/
  reducedLengthLinearizationError_le_defect :
    ∀ variation,
      reducedLengthLinearizationError variation ≤
        reducedLengthFirstVariationDefect variation

/--
The entropy-functional lower bound controls the reduced-length first variation
up to the recorded nonnegative defect.
-/
theorem PerelmanReducedLengthFirstVariationPayload.entropyFunctionalLowerBound_le_firstVariationValue
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    (payload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload)
    (variation : payload.reducedLengthVariationSpace) :
    entropyFunctionalPayload.entropyFunctionalLowerBound ≤
      payload.reducedLengthFirstVariationValue variation := by
  calc
    entropyFunctionalPayload.entropyFunctionalLowerBound ≤
        entropyFunctionalPayload.entropyFunctionalValue
          (payload.reducedLengthVariationToEntropyState variation) :=
      PerelmanEntropyFunctionalPayload.entropyFunctionalLowerBound_le_value
        entropyFunctionalPayload
        (payload.reducedLengthVariationToEntropyState variation)
    _ ≤ entropyFunctionalPayload.entropyFunctionalValue
          (payload.reducedLengthVariationToEntropyState variation) +
        payload.reducedLengthFirstVariationDefect variation :=
      le_add_of_nonneg_right
        (payload.reducedLengthFirstVariationDefectNonnegative variation)
    _ = payload.reducedLengthFirstVariationValue variation := by
      rw [← payload.reducedLengthFirstVariationIdentity variation]

