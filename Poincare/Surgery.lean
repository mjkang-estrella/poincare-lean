/--
Concrete nonincreasing/monotonicity data for reduced volume.

The payload is tied to the reduced-volume limit-rigidity payload. It records the
time-domain values, their derivative tests, derivative nonpositivity through
the reduced-volume derivative formula, and ordered-pair monotonicity data.
-/
structure PerelmanReducedVolumeNonincreasingPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    (reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload) : Type (u + 1) where
  /-- Scale on which reduced-volume nonincreasing control is asserted. -/
  reducedVolumeNonincreasingScale : ℝ
  /-- The nonincreasing scale is positive. -/
  reducedVolumeNonincreasingScalePositive :
    0 < reducedVolumeNonincreasingScale
  /-- Limit-rigidity control lies within the nonincreasing scale. -/
  limitRigidityScale_le_nonincreasingScale :
    reducedVolumeLimitRigidityPayload.reducedVolumeLimitRigidityScale ≤
      reducedVolumeNonincreasingScale
  /-- Time-domain on which reduced-volume values are tracked. -/
  reducedVolumeTimeDomain : Type u
  /-- Reduced-volume value at a tracked time. -/
  reducedVolumeAtTime : reducedVolumeTimeDomain → ℝ
  /-- Derivative-formula test associated to each tracked time. -/
  timeToDerivativeTest :
    reducedVolumeTimeDomain →
      reducedVolumeDerivativeFormulaPayload.reducedVolumeDerivativeTestDomain
  /-- Time values agree with the derivative-formula reduced-volume value. -/
  reducedVolumeAtTime_eq_derivativeTestValue :
    ∀ time,
      reducedVolumeAtTime time =
        reducedVolumeDerivativeFormulaPayload.reducedVolumeValueAtDerivativeTest
          (timeToDerivativeTest time)
  /-- Time derivative assigned to each tracked time. -/
  reducedVolumeTimeDerivativeAt : reducedVolumeTimeDomain → ℝ
  /-- The assigned derivative is the derivative-formula derivative. -/
  reducedVolumeTimeDerivativeAt_eq_formula :
    ∀ time,
      reducedVolumeTimeDerivativeAt time =
        reducedVolumeDerivativeFormulaPayload.reducedVolumeTimeDerivative
          (timeToDerivativeTest time)
  /-- The positive reduced-volume lower bound holds at tracked times. -/
  lowerBoundConstant_le_reducedVolumeAtTime :
    ∀ time,
      reducedVolumePositiveLowerBoundPayload.reducedVolumeLowerBoundConstant ≤
        reducedVolumeAtTime time
  /-- Ordered time-pair domain for nonincreasing comparisons. -/
  reducedVolumeOrderedTimePairDomain : Type u
  /-- Earlier endpoint of an ordered time pair. -/
  orderedPairEarlier :
    reducedVolumeOrderedTimePairDomain → reducedVolumeTimeDomain
  /-- Later endpoint of an ordered time pair. -/
  orderedPairLater :
    reducedVolumeOrderedTimePairDomain → reducedVolumeTimeDomain
  /-- Reduced volume at later times is bounded by reduced volume at earlier times. -/
  reducedVolumeLater_le_earlier :
    ∀ pair,
      reducedVolumeAtTime (orderedPairLater pair) ≤
        reducedVolumeAtTime (orderedPairEarlier pair)
  /-- Defect measuring the drop of reduced volume across an ordered pair. -/
  reducedVolumeMonotonicityDefect :
    reducedVolumeOrderedTimePairDomain → ℝ
  /-- The monotonicity defect is the earlier value minus the later value. -/
  reducedVolumeMonotonicityDefect_eq_drop :
    ∀ pair,
      reducedVolumeMonotonicityDefect pair =
        reducedVolumeAtTime (orderedPairEarlier pair) -
          reducedVolumeAtTime (orderedPairLater pair)
  /-- Envelope controlling reduced-volume nonincreasing data. -/
  reducedVolumeNonincreasingEnvelope : ℝ
  /-- The nonincreasing envelope is nonnegative. -/
  reducedVolumeNonincreasingEnvelopeNonnegative :
    0 ≤ reducedVolumeNonincreasingEnvelope
  /-- Limit-rigidity envelope data are absorbed by the nonincreasing envelope. -/
  limitRigidityEnvelope_le_nonincreasingEnvelope :
    reducedVolumeLimitRigidityPayload.reducedVolumeLimitRigidityEnvelope ≤
      reducedVolumeNonincreasingEnvelope
  /-- Reduced-volume values at tracked times are controlled by the envelope. -/
  reducedVolumeAtTime_le_nonincreasingEnvelope :
    ∀ time, reducedVolumeAtTime time ≤ reducedVolumeNonincreasingEnvelope

/-- Time derivatives in the nonincreasing payload are nonpositive. -/
theorem PerelmanReducedVolumeNonincreasingPayload.timeDerivative_nonpositive
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
