/--
Concrete setup data for Perelman's F-functional.

The payload records a space of test potentials, a real-valued density assigned
to each potential, the F-functional value, and the scale/error data used by the
formal package layer. Entropy normalization and minimizer existence remain
separate Perelman package fields.
-/
structure PerelmanFFunctionalSetupPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (_flow : RicciFlowData ThreeManifoldModelWithCorners n M) : Type (u + 1) where
  /-- Space of admissible test potentials for the F-functional. -/
  fPotentialSpace : Type u
  /-- Distinguished potential used as a baseline in the setup. -/
  baseFPotential : fPotentialSpace
  /-- Time at which the F-functional setup is recorded. -/
  fFunctionalBaseTime : ℝ
  /-- Scale on which the F-functional setup is controlled. -/
  fFunctionalScale : ℝ
  /-- The F-functional control scale is positive. -/
  fFunctionalScalePositive : 0 < fFunctionalScale
  /-- Real-valued density associated to each test potential. -/
  fPotentialDensity : fPotentialSpace → M → ℝ
  /-- F-functional densities are nonnegative. -/
  fPotentialDensityNonnegative :
    ∀ potential x, 0 ≤ fPotentialDensity potential x
  /-- Value of the F-functional on each admissible potential. -/
  fFunctionalValue : fPotentialSpace → ℝ
  /-- The distinguished baseline potential has finite recorded value. -/
  baseFPotentialValue : ℝ
  /-- The baseline value agrees with the F-functional value at the baseline. -/
  baseFPotentialValue_eq :
    baseFPotentialValue = fFunctionalValue baseFPotential
  /-- Defect term in the F-functional setup estimates. -/
  fFunctionalSetupDefect : fPotentialSpace → ℝ
  /-- F-functional setup defects are nonnegative. -/
  fFunctionalSetupDefectNonnegative :
    ∀ potential, 0 ≤ fFunctionalSetupDefect potential
  /-- F-functional values are controlled by the stored setup defect. -/
  fFunctionalValue_le_setupDefect :
    ∀ potential, fFunctionalValue potential ≤ fFunctionalSetupDefect potential

/-- Interface for Perelman's F-functional and normalization constraints. -/
structure HasPerelmanFFunctionalSetup
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M) : Prop where
  fFunctionalSetupPayload_source :
    Nonempty (PerelmanFFunctionalSetupPayload flow)

/-- Compatibility constructor for F-functional setup payloads. -/
def HasPerelmanFFunctionalSetup.of_f_functional_setup_payload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    (payload : PerelmanFFunctionalSetupPayload flow) :
    HasPerelmanFFunctionalSetup flow where
  fFunctionalSetupPayload_source := ⟨payload⟩

/--
Concrete entropy-normalization data for Perelman's F-functional setup.

The payload is tied to the explicit F-functional setup. It records normalization
weights and normalized densities on the same test-potential space, a total-mass
normalization certificate, and a defect term controlled by the F-functional
setup defect.
-/
structure PerelmanEntropyNormalizationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    (fFunctionalPayload : PerelmanFFunctionalSetupPayload flow) :
    Type (u + 1) where
  /-- Normalization weight assigned to each F-functional potential. -/
  entropyNormalizationWeight :
    fFunctionalPayload.fPotentialSpace → ℝ
  /-- Normalization weights are nonnegative. -/
  entropyNormalizationWeightNonnegative :
    ∀ potential, 0 ≤ entropyNormalizationWeight potential
  /-- Total normalized mass recorded by the entropy setup. -/
  normalizedTotalMass : ℝ
  /-- The total normalized mass is one. -/
  normalizedTotalMass_eq_one : normalizedTotalMass = 1
  /-- The distinguished potential has unit normalization weight. -/
  basePotentialWeight_eq_one :
    entropyNormalizationWeight fFunctionalPayload.baseFPotential = 1
  /-- Normalized density associated to each F-functional potential. -/
  normalizedDensity :
    fFunctionalPayload.fPotentialSpace → M → ℝ
  /-- The normalized density is the weighted F-functional density. -/
  normalizedDensity_eq_weight_mul_fDensity :
    ∀ potential x,
      normalizedDensity potential x =
        entropyNormalizationWeight potential *
          fFunctionalPayload.fPotentialDensity potential x
  /-- Normalized densities are nonnegative. -/
  normalizedDensityNonnegative :
    ∀ potential x, 0 ≤ normalizedDensity potential x
  /-- Scale on which entropy normalization is controlled. -/
  entropyNormalizationScale : ℝ
  /-- The entropy-normalization scale is positive. -/
  entropyNormalizationScalePositive : 0 < entropyNormalizationScale
  /-- Defect term for entropy normalization. -/
  entropyNormalizationDefect :
    fFunctionalPayload.fPotentialSpace → ℝ
  /-- Entropy-normalization defects are nonnegative. -/
  entropyNormalizationDefectNonnegative :
    ∀ potential, 0 ≤ entropyNormalizationDefect potential
  /-- Entropy-normalization defects are controlled by F-functional setup defects. -/
  entropyNormalizationDefect_le_fFunctionalSetupDefect :
    ∀ potential,
      entropyNormalizationDefect potential ≤
        fFunctionalPayload.fFunctionalSetupDefect potential

/-- Interface for entropy normalization choices in Perelman's functional. -/
structure HasPerelmanEntropyNormalization
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M) : Prop where
  entropyNormalizationPayload_source :
    ∃ fFunctionalPayload : PerelmanFFunctionalSetupPayload flow,
      Nonempty (PerelmanEntropyNormalizationPayload fFunctionalPayload)

/-- Compatibility constructor for entropy-normalization payloads. -/
def HasPerelmanEntropyNormalization.of_entropy_normalization_payload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    (payload : PerelmanEntropyNormalizationPayload fFunctionalPayload) :
    HasPerelmanEntropyNormalization flow where
  entropyNormalizationPayload_source := ⟨fFunctionalPayload, ⟨payload⟩⟩

/--
Concrete entropy-minimizer existence data for the normalized F-functional.

The payload is tied to the explicit F-functional and entropy-normalization
payloads. It records an actual normalized potential, its F-functional value,
its normalized density certificates, and the comparison inequality making it a
minimizer up to the stored normalization defect.
-/
structure PerelmanEntropyMinimizerExistencePayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    (entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload) :
    Type (u + 1) where
  /-- The normalized potential realizing the entropy infimum. -/
  entropyMinimizer : fFunctionalPayload.fPotentialSpace
  /-- Recorded F-functional value at the minimizer. -/
  entropyMinimizerValue : ℝ
  /-- The recorded value agrees with the F-functional value. -/
  entropyMinimizerValue_eq :
    entropyMinimizerValue =
      fFunctionalPayload.fFunctionalValue entropyMinimizer
  /-- The minimizer carries positive normalized weight. -/
  entropyMinimizerNormalizedWeightPositive :
    0 < entropyNormalizationPayload.entropyNormalizationWeight
      entropyMinimizer
  /-- The normalized minimizer density is nonnegative. -/
  entropyMinimizerDensityNonnegative :
    ∀ x,
      0 ≤ entropyNormalizationPayload.normalizedDensity
        entropyMinimizer x
  /-- Stored entropy infimum value. -/
  entropyInfimumValue : ℝ
  /-- The entropy infimum is realized by the stored minimizer value. -/
  entropyInfimumValue_eq_minimizerValue :
    entropyInfimumValue = entropyMinimizerValue
  /-- The minimizer value is bounded by every normalized potential value. -/
  entropyMinimizer_le_all_normalized :
    ∀ potential,
      entropyMinimizerValue ≤
        fFunctionalPayload.fFunctionalValue potential +
          entropyNormalizationPayload.entropyNormalizationDefect potential
  /-- Stored defect for the entropy-minimizer existence step. -/
  entropyMinimizerDefect : ℝ
  /-- The entropy-minimizer defect is nonnegative. -/
  entropyMinimizerDefectNonnegative : 0 ≤ entropyMinimizerDefect
  /-- The minimizer defect is controlled by the normalization defect. -/
  entropyMinimizerDefect_le_normalizationDefect :
    entropyMinimizerDefect ≤
      entropyNormalizationPayload.entropyNormalizationDefect
        entropyMinimizer

/-- Interface for existence of entropy minimizers at controlled scales. -/
structure HasPerelmanEntropyMinimizerExistence
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M) : Prop where
  entropyMinimizerExistencePayload_source :
    ∃ fFunctionalPayload : PerelmanFFunctionalSetupPayload flow,
      ∃ entropyNormalizationPayload :
        PerelmanEntropyNormalizationPayload fFunctionalPayload,
        Nonempty
          (PerelmanEntropyMinimizerExistencePayload
            entropyNormalizationPayload)

/-- Compatibility constructor for entropy-minimizer existence payloads. -/
def HasPerelmanEntropyMinimizerExistence.of_entropy_minimizer_existence_payload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    (payload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload) :
    HasPerelmanEntropyMinimizerExistence flow where
  entropyMinimizerExistencePayload_source :=
    ⟨fFunctionalPayload, entropyNormalizationPayload, ⟨payload⟩⟩

/--
Concrete log-Sobolev control data for the normalized entropy setup.

The payload is tied to an explicit entropy minimizer. It records the controlled
scale, the log-Sobolev constant, and a defect-controlled inequality comparing
each normalized potential to the stored entropy minimizer.
-/
structure PerelmanEntropyLogSobolevControlPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    (entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload) :
    Type (u + 1) where
  /-- Scale on which the log-Sobolev estimate is asserted. -/
  entropyLogSobolevScale : ℝ
  /-- The log-Sobolev control scale is positive. -/
  entropyLogSobolevScalePositive : 0 < entropyLogSobolevScale
  /-- The entropy-normalization scale lies within the log-Sobolev control scale. -/
  entropyNormalizationScale_le_logSobolevScale :
    entropyNormalizationPayload.entropyNormalizationScale ≤
      entropyLogSobolevScale
  /-- Constant in the normalized log-Sobolev inequality. -/
  entropyLogSobolevConstant : ℝ
  /-- The log-Sobolev constant is positive. -/
  entropyLogSobolevConstantPositive : 0 < entropyLogSobolevConstant
  /-- Reference entropy value used in the inequality. -/
  entropyLogSobolevReferenceValue : ℝ
  /-- The reference value is the stored minimizer value. -/
  entropyLogSobolevReferenceValue_eq_minimizerValue :
    entropyLogSobolevReferenceValue =
      entropyMinimizerPayload.entropyMinimizerValue
  /-- Defect term for the log-Sobolev estimate. -/
  entropyLogSobolevDefect :
    fFunctionalPayload.fPotentialSpace → ℝ
  /-- Log-Sobolev defects are nonnegative. -/
  entropyLogSobolevDefectNonnegative :
    ∀ potential, 0 ≤ entropyLogSobolevDefect potential
  /-- Log-Sobolev defects are controlled by the normalization and minimizer defects. -/
  entropyLogSobolevDefect_le_normalizationAndMinimizerDefect :
    ∀ potential,
      entropyLogSobolevDefect potential ≤
        entropyNormalizationPayload.entropyNormalizationDefect potential +
          entropyMinimizerPayload.entropyMinimizerDefect
  /--
  Normalized log-Sobolev control comparing each potential to the entropy
  minimizer, with the stored defect absorbing the analytic error term.
  -/
  entropyLogSobolevInequality :
    ∀ potential,
      entropyNormalizationPayload.entropyNormalizationWeight potential *
          (fFunctionalPayload.fFunctionalValue potential -
            entropyMinimizerPayload.entropyMinimizerValue) ≤
        entropyLogSobolevConstant *
          (entropyNormalizationPayload.entropyNormalizationDefect potential +
            entropyLogSobolevDefect potential)

