/--
Concrete reduced-volume monotonicity data derived from the nonincreasing
reduced-volume payload.

The payload is tied to the accepted reduced-volume nonincreasing data. It
records the monotonicity time domain and ordered time pairs used by the
high-level package, together with maps back to the nonincreasing payload where
the derivative sign and later-before-earlier inequality are already proved.
-/
structure PerelmanReducedVolumeMonotonicityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    (nonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload) : Type (u + 1) where
  /-- Scale on which reduced-volume monotonicity is asserted. -/
  reducedVolumeMonotonicityScale : ℝ
  /-- The reduced-volume monotonicity scale is positive. -/
  reducedVolumeMonotonicityScalePositive :
    0 < reducedVolumeMonotonicityScale
  /-- Nonincreasing control lies within the monotonicity scale. -/
  nonincreasingScale_le_monotonicityScale :
    nonincreasingPayload.reducedVolumeNonincreasingScale ≤
      reducedVolumeMonotonicityScale
  /-- Time domain used by the monotonicity statement. -/
  reducedVolumeMonotonicityTimeDomain : Type u
  /-- Map from monotonicity times to nonincreasing-payload times. -/
  monotonicityTimeToNonincreasingTime :
    reducedVolumeMonotonicityTimeDomain →
      nonincreasingPayload.reducedVolumeTimeDomain
  /-- Reduced-volume value at a monotonicity time. -/
  reducedVolumeMonotonicityValueAtTime :
    reducedVolumeMonotonicityTimeDomain → ℝ
  /-- Monotonicity values agree with nonincreasing-payload values. -/
  reducedVolumeMonotonicityValueAtTime_eq_nonincreasingValue :
    ∀ time,
      reducedVolumeMonotonicityValueAtTime time =
        nonincreasingPayload.reducedVolumeAtTime
          (monotonicityTimeToNonincreasingTime time)
  /-- Time derivative assigned to a monotonicity time. -/
  reducedVolumeMonotonicityTimeDerivativeAt :
    reducedVolumeMonotonicityTimeDomain → ℝ
  /-- Monotonicity derivatives agree with nonincreasing-payload derivatives. -/
  reducedVolumeMonotonicityTimeDerivativeAt_eq_nonincreasingDerivative :
    ∀ time,
      reducedVolumeMonotonicityTimeDerivativeAt time =
        nonincreasingPayload.reducedVolumeTimeDerivativeAt
          (monotonicityTimeToNonincreasingTime time)
  /-- Ordered time-pair domain for the monotonicity statement. -/
  reducedVolumeMonotonicityPairDomain : Type u
  /-- Map from monotonicity pairs to nonincreasing-payload ordered pairs. -/
  monotonicityPairToNonincreasingPair :
    reducedVolumeMonotonicityPairDomain →
      nonincreasingPayload.reducedVolumeOrderedTimePairDomain
  /-- Earlier endpoint of a monotonicity pair. -/
  monotonicityPairEarlier :
    reducedVolumeMonotonicityPairDomain →
      reducedVolumeMonotonicityTimeDomain
  /-- Later endpoint of a monotonicity pair. -/
  monotonicityPairLater :
    reducedVolumeMonotonicityPairDomain →
      reducedVolumeMonotonicityTimeDomain
  /-- Earlier endpoints agree with the nonincreasing-payload pair. -/
  monotonicityPairEarlier_maps_to_nonincreasingEarlier :
    ∀ pair,
      monotonicityTimeToNonincreasingTime
          (monotonicityPairEarlier pair) =
        nonincreasingPayload.orderedPairEarlier
          (monotonicityPairToNonincreasingPair pair)
  /-- Later endpoints agree with the nonincreasing-payload pair. -/
  monotonicityPairLater_maps_to_nonincreasingLater :
    ∀ pair,
      monotonicityTimeToNonincreasingTime
          (monotonicityPairLater pair) =
        nonincreasingPayload.orderedPairLater
          (monotonicityPairToNonincreasingPair pair)
  /-- Defect measuring the drop of reduced volume across a monotonicity pair. -/
  reducedVolumeMonotonicityDefect :
    reducedVolumeMonotonicityPairDomain → ℝ
  /-- The monotonicity defect is the earlier value minus the later value. -/
  reducedVolumeMonotonicityDefect_eq_drop :
    ∀ pair,
      reducedVolumeMonotonicityDefect pair =
        reducedVolumeMonotonicityValueAtTime
            (monotonicityPairEarlier pair) -
          reducedVolumeMonotonicityValueAtTime
            (monotonicityPairLater pair)
  /-- Envelope controlling reduced-volume monotonicity data. -/
  reducedVolumeMonotonicityEnvelope : ℝ
  /-- The monotonicity envelope is nonnegative. -/
  reducedVolumeMonotonicityEnvelopeNonnegative :
    0 ≤ reducedVolumeMonotonicityEnvelope
  /-- Nonincreasing envelope data are absorbed by the monotonicity envelope. -/
  nonincreasingEnvelope_le_monotonicityEnvelope :
    nonincreasingPayload.reducedVolumeNonincreasingEnvelope ≤
      reducedVolumeMonotonicityEnvelope
  /-- Monotonicity values are controlled by the monotonicity envelope. -/
  reducedVolumeMonotonicityValueAtTime_le_envelope :
    ∀ time,
      reducedVolumeMonotonicityValueAtTime time ≤
        reducedVolumeMonotonicityEnvelope

/-- Time derivatives in the monotonicity payload are nonpositive. -/
theorem PerelmanReducedVolumeMonotonicityPayload.timeDerivative_nonpositive
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {nonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    (payload :
      PerelmanReducedVolumeMonotonicityPayload nonincreasingPayload)
    (time : payload.reducedVolumeMonotonicityTimeDomain) :
    payload.reducedVolumeMonotonicityTimeDerivativeAt time ≤ 0 := by
  rw [payload.reducedVolumeMonotonicityTimeDerivativeAt_eq_nonincreasingDerivative time]
  exact
    PerelmanReducedVolumeNonincreasingPayload.timeDerivative_nonpositive
      nonincreasingPayload
      (payload.monotonicityTimeToNonincreasingTime time)

/-- Later reduced-volume values are bounded by earlier values. -/
theorem PerelmanReducedVolumeMonotonicityPayload.reducedVolumeLater_le_earlier
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    {entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload}
    {conjugateHeatPayload :
      ConjugateHeatEquationTheoryPayload entropyLogSobolevPayload}
    {adjointHeatPayload :
      AdjointHeatKernelConstructionPayload conjugateHeatPayload}
    {conjugateHeatKernelEstimatesPayload :
      PerelmanConjugateHeatKernelEstimatesPayload adjointHeatPayload}
    {wFunctionalPayload :
      PerelmanWFunctionalSetupPayload
        conjugateHeatKernelEstimatesPayload}
    {entropyGradientPayload :
      PerelmanEntropyGradientFormulaPayload wFunctionalPayload}
    {entropyFirstVariationPayload :
      PerelmanEntropyFirstVariationPayload entropyGradientPayload}
    {entropyMonotonicityPayload :
      PerelmanEntropyMonotonicityPayload
        entropyFirstVariationPayload}
    {entropyLowerBoundPropagationPayload :
      PerelmanEntropyLowerBoundPropagationPayload
        entropyMonotonicityPayload}
    {entropyFunctionalPayload :
      PerelmanEntropyFunctionalPayload
        entropyLowerBoundPropagationPayload}
    {reducedLengthFirstVariationPayload :
      PerelmanReducedLengthFirstVariationPayload
        entropyFunctionalPayload}
    {reducedDistanceExistencePayload :
      PerelmanReducedDistanceExistencePayload
        reducedLengthFirstVariationPayload}
    {reducedDistanceDifferentialInequalityPayload :
      PerelmanReducedDistanceDifferentialInequalityPayload
        reducedDistanceExistencePayload}
    {reducedDistanceEstimatesPayload :
      PerelmanReducedDistanceEstimatesPayload
        reducedDistanceDifferentialInequalityPayload}
    {reducedDistanceCutLocusControlPayload :
      PerelmanReducedDistanceCutLocusControlPayload
        reducedDistanceEstimatesPayload}
    {reducedJacobianComparisonPayload :
      PerelmanReducedJacobianComparisonPayload
        reducedDistanceCutLocusControlPayload}
    {reducedDistanceTheoryPayload :
      PerelmanReducedDistanceTheoryPayload
        reducedJacobianComparisonPayload}
    {reducedVolumeDefinitionPayload :
      PerelmanReducedVolumeDefinitionPayload
        reducedDistanceTheoryPayload}
    {reducedVolumeDerivativeFormulaPayload :
      PerelmanReducedVolumeDerivativeFormulaPayload
        reducedVolumeDefinitionPayload}
    {reducedVolumeRigidityPayload :
      PerelmanReducedVolumeRigidityPayload
        reducedVolumeDerivativeFormulaPayload}
    {reducedVolumePositiveLowerBoundPayload :
      PerelmanReducedVolumePositiveLowerBoundPayload
        reducedVolumeRigidityPayload}
    {reducedVolumeLimitRigidityPayload :
      PerelmanReducedVolumeLimitRigidityPayload
        reducedVolumePositiveLowerBoundPayload}
    {nonincreasingPayload :
      PerelmanReducedVolumeNonincreasingPayload
        reducedVolumeLimitRigidityPayload}
    (payload :
      PerelmanReducedVolumeMonotonicityPayload nonincreasingPayload)
    (pair : payload.reducedVolumeMonotonicityPairDomain) :
    payload.reducedVolumeMonotonicityValueAtTime
        (payload.monotonicityPairLater pair) ≤
      payload.reducedVolumeMonotonicityValueAtTime
        (payload.monotonicityPairEarlier pair) := by
  rw [payload.reducedVolumeMonotonicityValueAtTime_eq_nonincreasingValue
      (payload.monotonicityPairLater pair)]
  rw [payload.reducedVolumeMonotonicityValueAtTime_eq_nonincreasingValue
      (payload.monotonicityPairEarlier pair)]
  rw [payload.monotonicityPairLater_maps_to_nonincreasingLater pair]
  rw [payload.monotonicityPairEarlier_maps_to_nonincreasingEarlier pair]
  exact
    nonincreasingPayload.reducedVolumeLater_le_earlier
      (payload.monotonicityPairToNonincreasingPair pair)

/-- Monotonicity defects are nonnegative. -/
theorem PerelmanReducedVolumeMonotonicityPayload.monotonicityDefect_nonnegative
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
