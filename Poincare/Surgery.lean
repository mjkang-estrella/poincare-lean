/--
Concrete payload for the statement that discarded components carry only trivial
sweepout classes.

The payload is attached to the same surgery-discard-control payload used for
width neutrality, keeps that width-neutrality payload as input data, and records
an explicit discarded sweepout slice with zero width contribution and an empty
discarded component set for the triviality step.
-/
structure FiniteExtinctionDiscardedComponentSweepoutTrivialityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control)
    (widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory)
    (discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution) :
    Type (u + 1) where
  /-- Concrete surgery-discard-control payload being trivialized. -/
  surgeryDiscardControlPayload :
    FiniteExtinctionSurgeryDiscardControlPayload
      flow surgery control widthTheory widthEvolution
  /-- The abstract discard-control witness is built from the concrete payload. -/
  discardControlEq :
    discardControl =
      HasFiniteExtinctionSurgeryDiscardControl.of_surgery_discard_control_payload
        surgeryDiscardControlPayload
  /-- Width-neutrality payload used to force triviality on discarded pieces. -/
  widthNeutralityPayload :
    FiniteExtinctionDiscardedComponentWidthNeutralityPayload
      flow surgery control widthTheory widthEvolution discardControl
  /-- The discarded component set is empty in this triviality certificate. -/
  discardedComponentSetEmpty :
    surgeryDiscardControlPayload.discardedComponentSet = ∅
  /-- Sweepout slice restricted to the discarded component. -/
  trivializedSweepoutSlice : Set M
  /-- The restricted slice is the discarded component set. -/
  trivializedSweepoutSliceEqDiscarded :
    trivializedSweepoutSlice =
      surgeryDiscardControlPayload.discardedComponentSet
  /-- The restricted discarded slice is empty, hence sweepout-trivial. -/
  trivializedSweepoutSliceEmpty :
    trivializedSweepoutSlice = ∅
  /-- Triviality is asserted for the selected discarded component. -/
  trivializedComponent :
    surgeryDiscardControlPayload.discardedComponentIndex
  /-- The trivialized component is the selected discarded component. -/
  trivializedComponentEqSelected :
    trivializedComponent =
      surgeryDiscardControlPayload.selectedDiscardedComponent
  /-- The discarded width contribution vanishes. -/
  discardedWidthZero :
    surgeryDiscardControlPayload.discardedWidthContribution = 0
  /-- The vanishing width is compatible with the width-neutrality payload. -/
  discardedWidthZeroEqNeutrality :
    surgeryDiscardControlPayload.discardedWidthContribution =
      widthNeutralityPayload.surgeryDiscardControlPayload.discardedWidthContribution
  /-- Retained slice from width neutrality, kept for boundary compatibility. -/
  retainedTargetSlice : Set M
  /-- The retained slice agrees with the width-neutrality payload. -/
  retainedTargetSliceEqNeutrality :
    retainedTargetSlice = widthNeutralityPayload.retainedTargetSlice

/-- Bundle the empty discarded-slice and zero-width facts used by sweepout triviality. -/
theorem FiniteExtinctionDiscardedComponentSweepoutTrivialityPayload.triviality_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {surgery : HasRicciFlowWithSurgery n M}
    {control : HasPerelmanSingularityControl (n := n) (M := M) flow}
    {widthTheory : HasFiniteExtinctionWidthTheory flow surgery control}
    {widthEvolution :
      HasFiniteExtinctionWidthEvolution flow surgery control widthTheory}
    {discardControl :
      HasFiniteExtinctionSurgeryDiscardControl
        flow surgery control widthTheory widthEvolution}
    (payload :
      FiniteExtinctionDiscardedComponentSweepoutTrivialityPayload
        flow surgery control widthTheory widthEvolution discardControl) :
    payload.surgeryDiscardControlPayload.discardedComponentSet = ∅ ∧
      payload.trivializedSweepoutSlice =
        payload.surgeryDiscardControlPayload.discardedComponentSet ∧
      payload.trivializedSweepoutSlice = ∅ ∧
      payload.trivializedComponent =
        payload.surgeryDiscardControlPayload.selectedDiscardedComponent ∧
      payload.surgeryDiscardControlPayload.discardedWidthContribution = 0 ∧
      payload.surgeryDiscardControlPayload.discardedWidthContribution =
        payload.widthNeutralityPayload.surgeryDiscardControlPayload.discardedWidthContribution ∧
      payload.retainedTargetSlice =
        payload.widthNeutralityPayload.retainedTargetSlice := by
  exact
    ⟨payload.discardedComponentSetEmpty,
      payload.trivializedSweepoutSliceEqDiscarded,
      payload.trivializedSweepoutSliceEmpty,
      payload.trivializedComponentEqSelected,
      payload.discardedWidthZero,
      payload.discardedWidthZeroEqNeutrality,
      payload.retainedTargetSliceEqNeutrality⟩

/-- Source data for proving discarded components carry only trivial sweepout classes. -/
structure FiniteExtinctionDiscardedComponentSweepoutTrivialityPayloadSource
