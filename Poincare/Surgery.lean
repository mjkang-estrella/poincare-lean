/--
Concrete conjugate heat equation data for the normalized entropy setup.

The payload is tied to the log-Sobolev control payload. It records a space of
backward heat solutions, the time interval on which the equation is controlled,
the heat operator and density, normalization and positivity certificates, and a
residual bound controlled by the log-Sobolev defect at the entropy minimizer.
-/
structure ConjugateHeatEquationTheoryPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {fFunctionalPayload : PerelmanFFunctionalSetupPayload flow}
    {entropyNormalizationPayload :
      PerelmanEntropyNormalizationPayload fFunctionalPayload}
    {entropyMinimizerPayload :
      PerelmanEntropyMinimizerExistencePayload
        entropyNormalizationPayload}
    (entropyLogSobolevPayload :
      PerelmanEntropyLogSobolevControlPayload
        entropyMinimizerPayload) : Type (u + 1) where
  /-- Scale on which the conjugate heat equation theory is controlled. -/
  conjugateHeatScale : ℝ
  /-- The conjugate heat control scale is positive. -/
  conjugateHeatScalePositive : 0 < conjugateHeatScale
  /-- Log-Sobolev control lies within the conjugate heat control scale. -/
  entropyLogSobolevScale_le_conjugateHeatScale :
    entropyLogSobolevPayload.entropyLogSobolevScale ≤
      conjugateHeatScale
  /-- Time interval for the backward conjugate heat equation. -/
  conjugateHeatTimeInterval : Set ℝ
  /-- Distinguished base time in the conjugate heat interval. -/
  conjugateHeatBaseTime : ℝ
  /-- The distinguished base time belongs to the conjugate heat interval. -/
  conjugateHeatBaseTime_mem :
    conjugateHeatBaseTime ∈ conjugateHeatTimeInterval
  /-- Backward time parameter used by the conjugate heat equation. -/
  backwardTime : ℝ
  /-- The backward time parameter is positive. -/
  backwardTimePositive : 0 < backwardTime
  /-- Space of conjugate heat solutions. -/
  conjugateHeatSolutionSpace : Type u
  /-- Distinguished normalized conjugate heat solution. -/
  baseConjugateHeatSolution : conjugateHeatSolutionSpace
  /-- Density of each conjugate heat solution. -/
  conjugateHeatDensity :
    conjugateHeatSolutionSpace → ℝ → M → ℝ
  /-- Conjugate heat densities are nonnegative on the controlled interval. -/
  conjugateHeatDensityNonnegative :
    ∀ solution t x,
      t ∈ conjugateHeatTimeInterval →
        0 ≤ conjugateHeatDensity solution t x
  /-- Operator measuring the conjugate heat equation residual pointwise. -/
  conjugateHeatOperator :
    conjugateHeatSolutionSpace → ℝ → M → ℝ
  /-- The distinguished solution satisfies the conjugate heat equation. -/
  baseConjugateHeatEquation :
    ∀ t x,
      t ∈ conjugateHeatTimeInterval →
        conjugateHeatOperator baseConjugateHeatSolution t x = 0
  /-- Total mass of each conjugate heat solution. -/
  conjugateHeatMass : conjugateHeatSolutionSpace → ℝ
  /-- The distinguished conjugate heat solution has normalized mass one. -/
  baseConjugateHeatMass_eq_one :
    conjugateHeatMass baseConjugateHeatSolution = 1
  /-- Aggregate residual for each conjugate heat solution. -/
  conjugateHeatResidual : conjugateHeatSolutionSpace → ℝ
  /-- Conjugate heat residuals are nonnegative. -/
  conjugateHeatResidualNonnegative :
    ∀ solution, 0 ≤ conjugateHeatResidual solution
  /-- The distinguished residual is controlled by the log-Sobolev minimizer defect. -/
  baseConjugateHeatResidual_le_logSobolevDefect :
    conjugateHeatResidual baseConjugateHeatSolution ≤
      entropyLogSobolevPayload.entropyLogSobolevDefect
        entropyMinimizerPayload.entropyMinimizer

