/-
Typed interfaces for the Ricci-flow-with-surgery layer.

This module sits between the local Ricci-flow data API and the finite-extinction
interface used by the final Poincare assembly theorem. Most low-level
predicates here remain proof obligations; constructor-backed interfaces store
the concrete data that a later geometric-analysis formalization must supply.
-/

import Poincare.AnalyticFoundation

universe u

open scoped Manifold ContDiff

namespace Poincare

/-- The Euclidean model used for topological 3-manifolds in this project. -/
abbrev ThreeManifoldModel : Type :=
  EuclideanSpace ℝ (Fin 3)

/--
The project 3-manifold model is definitionally the standard 3-dimensional
Euclidean model.
-/
theorem threeManifoldModel_eq :
    ThreeManifoldModel = EuclideanSpace ℝ (Fin 3) :=
  rfl

/-- The standard smooth model-with-corners for 3-manifolds. -/
noncomputable abbrev ThreeManifoldModelWithCorners :
    ModelWithCorners ℝ ThreeManifoldModel ThreeManifoldModel :=
  𝓘(ℝ, ThreeManifoldModel)

/--
The project smooth model-with-corners is definitionally the standard smooth
model on the fixed 3-manifold Euclidean model.
-/
theorem threeManifoldModelWithCorners_eq :
    ThreeManifoldModelWithCorners = 𝓘(ℝ, ThreeManifoldModel) :=
  rfl

/--
Concrete surgery-scale selection data for a fixed flow.

The payload records an actual positive scale-valued function together with a
distinguished initial scale. It is intentionally weaker than continuity or
separation estimates; those remain separate fields of the construction package.
-/
structure SurgeryScaleFunctionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (_flow : RicciFlowData ThreeManifoldModelWithCorners n M) : Type (u + 1) where
  /-- Parameter space indexing the surgery-scale choice. -/
  scaleParameterSpace : Type u
  /-- Distinguished parameter for the initial recorded scale. -/
  baseScaleParameter : scaleParameterSpace
  /-- Selected surgery scale at each parameter. -/
  surgeryScale : scaleParameterSpace → ℝ
  /-- Positivity of the selected surgery scale. -/
  surgeryScalePositive : ∀ parameter, 0 < surgeryScale parameter
  /-- The distinguished surgery scale recorded separately for downstream APIs. -/
  baseSurgeryScale : ℝ
  /-- The distinguished scale agrees with the scale function at the base parameter. -/
  baseSurgeryScale_eq : baseSurgeryScale = surgeryScale baseScaleParameter
  /-- Positivity of the distinguished surgery scale. -/
  baseSurgeryScalePositive : 0 < baseSurgeryScale

/--
Concrete continuity and local variation data for a selected surgery-scale
function.

The payload is tied to a specific scale-function payload. It records the
topology in which the parameterized scale varies continuously, together with
local positive control bounds that downstream scale-separation estimates can
use.
-/
structure SurgeryScaleContinuityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    (scalePayload : SurgeryScaleFunctionPayload flow) : Type (u + 1) where
  /-- Topology on the scale-parameter space. -/
  scaleParameterTopology : TopologicalSpace scalePayload.scaleParameterSpace
  /-- The selected surgery scale is continuous in the recorded topology. -/
  surgeryScaleContinuous :
    @Continuous scalePayload.scaleParameterSpace ℝ
      scaleParameterTopology inferInstance scalePayload.surgeryScale
  /-- Local neighborhoods used to control variation of the scale function. -/
  continuityNeighborhood :
    scalePayload.scaleParameterSpace → Set scalePayload.scaleParameterSpace
  /-- Each parameter belongs to its own continuity-control neighborhood. -/
  continuitySelfMem :
    ∀ parameter, parameter ∈ continuityNeighborhood parameter
  /-- Positive local variation bound for the selected scale. -/
  localScaleVariationBound : scalePayload.scaleParameterSpace → ℝ
  /-- The local variation bounds are strictly positive. -/
  localScaleVariationBoundPositive :
    ∀ parameter, 0 < localScaleVariationBound parameter

/--
Concrete separation data among surgery, cutoff, and canonical-neighborhood
scales for a selected continuous surgery-scale function.

The payload is deliberately tied to the scale-function and continuity payloads:
the cutoff and canonical-neighborhood scale choices are indexed by the same
parameter space, and the recorded inequalities leave the local continuity
variation below the next scale.
-/
structure SurgeryScaleSeparationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    (continuityPayload : SurgeryScaleContinuityPayload scalePayload) :
    Type (u + 1) where
  /-- Cutoff scale chosen at each surgery-scale parameter. -/
  cutoffScale : scalePayload.scaleParameterSpace → ℝ
  /-- Canonical-neighborhood scale chosen at each surgery-scale parameter. -/
  canonicalNeighborhoodScale : scalePayload.scaleParameterSpace → ℝ
  /-- Positivity of the cutoff scale. -/
  cutoffScalePositive : ∀ parameter, 0 < cutoffScale parameter
  /-- Positivity of the canonical-neighborhood scale. -/
  canonicalNeighborhoodScalePositive :
    ∀ parameter, 0 < canonicalNeighborhoodScale parameter
  /-- The surgery scale, including local variation, remains below the cutoff scale. -/
  surgeryScaleVariation_lt_cutoffScale :
    ∀ parameter,
      scalePayload.surgeryScale parameter +
          continuityPayload.localScaleVariationBound parameter <
        cutoffScale parameter
  /-- The cutoff scale, including local variation, remains below the canonical scale. -/
  cutoffScaleVariation_lt_canonicalNeighborhoodScale :
    ∀ parameter,
      cutoffScale parameter +
          continuityPayload.localScaleVariationBound parameter <
        canonicalNeighborhoodScale parameter

/--
Concrete cutoff-parameter control data for a separated surgery-scale package.

The payload is tied to the explicit scale-function, continuity, and separation
payloads. It records an actual cutoff parameter and transition width at each
scale parameter, with both kept inside the cutoff scale supplied by the
separation payload.
-/
structure SurgeryCutoffParameterControlPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    (separationPayload : SurgeryScaleSeparationPayload continuityPayload) :
    Type (u + 1) where
  /-- Cutoff parameter selected at each surgery-scale parameter. -/
  cutoffParameter : scalePayload.scaleParameterSpace → ℝ
  /-- Width of the cutoff transition region. -/
  cutoffTransitionWidth : scalePayload.scaleParameterSpace → ℝ
  /-- Positivity of the selected cutoff parameter. -/
  cutoffParameterPositive : ∀ parameter, 0 < cutoffParameter parameter
  /-- Positivity of the cutoff transition width. -/
  cutoffTransitionWidthPositive :
    ∀ parameter, 0 < cutoffTransitionWidth parameter
  /-- The cutoff parameter stays below the separated cutoff scale. -/
  cutoffParameter_lt_cutoffScale :
    ∀ parameter,
      cutoffParameter parameter < separationPayload.cutoffScale parameter
  /-- The full transition region stays inside the separated cutoff scale. -/
  cutoffTransitionWithinCutoffScale :
    ∀ parameter,
      cutoffParameter parameter + cutoffTransitionWidth parameter <
        separationPayload.cutoffScale parameter

/--
Concrete smooth cutoff bump data for controlled surgery cutoff parameters.

The bump function is indexed by the same surgery-scale parameter space and is
tied to the selected cutoff parameter and transition width. It records the
smooth scalar cutoff together with its plateau, vanishing, and range controls.
-/
structure SurgeryCutoffSmoothBumpPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    (cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload) :
    Type (u + 1) where
  /-- Smooth scalar bump used in the cutoff transition region. -/
  cutoffBump : scalePayload.scaleParameterSpace → ℝ → ℝ
  /-- Smoothness of the scalar cutoff bump. -/
  cutoffBumpSmooth : ∀ parameter, ContDiff ℝ ⊤ (cutoffBump parameter)
  /-- The bump is identically one before the selected cutoff parameter. -/
  cutoffBump_eq_one_of_le_cutoffParameter :
    ∀ parameter x,
      x ≤ cutoffPayload.cutoffParameter parameter →
        cutoffBump parameter x = 1
  /-- The bump vanishes after the selected transition region. -/
  cutoffBump_eq_zero_of_transition_le :
    ∀ parameter x,
      cutoffPayload.cutoffParameter parameter +
          cutoffPayload.cutoffTransitionWidth parameter ≤ x →
        cutoffBump parameter x = 0
  /-- The bump is bounded between zero and one. -/
  cutoffBumpRange :
    ∀ parameter x,
      0 ≤ cutoffBump parameter x ∧ cutoffBump parameter x ≤ 1

/--
Concrete surgery-parameter selection data for a smooth cutoff package.

The payload is tied to the explicit scale-function, continuity, separation,
cutoff-control, and smooth-bump payloads. It records the selected surgery
parameter at each scale parameter and keeps that choice inside the controlled
cutoff plateau.
-/
structure SurgeryParameterSelectionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    (smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload) :
    Type (u + 1) where
  /-- Surgery parameter selected at each surgery-scale parameter. -/
  surgeryParameter : scalePayload.scaleParameterSpace → ℝ
  /-- Positivity of the selected surgery parameter. -/
  surgeryParameterPositive : ∀ parameter, 0 < surgeryParameter parameter
  /-- The surgery parameter lies before the selected cutoff threshold. -/
  surgeryParameter_lt_cutoffParameter :
    ∀ parameter,
      surgeryParameter parameter < cutoffPayload.cutoffParameter parameter
  /-- The selected parameter remains in the plateau of the cutoff bump. -/
  cutoffBump_eq_one_at_surgeryParameter :
    ∀ parameter,
      smoothBumpPayload.cutoffBump parameter (surgeryParameter parameter) = 1

/--
Concrete strong delta-neck detection data downstream of surgery-parameter
selection.

The payload records explicit candidate neck regions and centers at each
surgery-scale parameter, together with a positive strong delta and detection
scale controlled by the selected surgery parameter and the surgery scale.
-/
structure SurgeryStrongDeltaNeckDetectionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    (parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload) :
    Type (u + 1) where
  /-- Candidate strong delta-neck region selected at each scale parameter. -/
  detectedNeckRegion : scalePayload.scaleParameterSpace → Set M
  /-- Distinguished center point for each detected neck region. -/
  neckCenter : scalePayload.scaleParameterSpace → M
  /-- Each distinguished center lies in its detected neck region. -/
  neckCenterMemDetectedNeckRegion :
    ∀ parameter, neckCenter parameter ∈ detectedNeckRegion parameter
  /-- Strong delta value used for the neck-detection threshold. -/
  strongDelta : scalePayload.scaleParameterSpace → ℝ
  /-- The strong delta value is positive. -/
  strongDeltaPositive : ∀ parameter, 0 < strongDelta parameter
  /-- Geometric detection scale associated to each selected neck. -/
  neckDetectionScale : scalePayload.scaleParameterSpace → ℝ
  /-- The neck-detection scale is positive. -/
  neckDetectionScalePositive : ∀ parameter, 0 < neckDetectionScale parameter
  /-- The strong delta threshold is below the detection scale. -/
  strongDelta_lt_neckDetectionScale :
    ∀ parameter, strongDelta parameter < neckDetectionScale parameter
  /-- The selected surgery parameter is controlled by the detection scale. -/
  surgeryParameter_le_neckDetectionScale :
    ∀ parameter,
      parameterSelectionPayload.surgeryParameter parameter ≤
        neckDetectionScale parameter
  /-- The detection scale remains below the selected surgery scale. -/
  neckDetectionScale_le_surgeryScale :
    ∀ parameter,
      neckDetectionScale parameter ≤ scalePayload.surgeryScale parameter

/--
Concrete separation data for the strong delta-necks selected by the surgery
construction.

The payload is tied to the explicit strong delta-neck detection payload. It
records separated neighborhoods around each detected neck center, keeps those
neighborhoods inside the detected neck regions, and records pairwise
disjointness for distinct scale parameters.
-/
structure SurgeryNeckSeparationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    (strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload) :
    Type (u + 1) where
  /-- Neighborhood retained around each detected neck center. -/
  separatedNeckNeighborhood : scalePayload.scaleParameterSpace → Set M
  /-- Each detected neck center lies in its retained separated neighborhood. -/
  neckCenterMemSeparatedNeckNeighborhood :
    ∀ parameter,
      strongDeltaPayload.neckCenter parameter ∈
        separatedNeckNeighborhood parameter
  /-- Retained neighborhoods stay inside the detected strong delta-neck regions. -/
  separatedNeckNeighborhood_subset_detectedNeckRegion :
    ∀ parameter x,
      x ∈ separatedNeckNeighborhood parameter →
        x ∈ strongDeltaPayload.detectedNeckRegion parameter
  /-- Retained neighborhoods for distinct parameters are pairwise disjoint. -/
  separatedNeckNeighborhoods_disjoint :
    ∀ parameter otherParameter x,
      parameter ≠ otherParameter →
        x ∈ separatedNeckNeighborhood parameter →
          x ∈ separatedNeckNeighborhood otherParameter → False
  /-- Scale at which separation between retained neck neighborhoods is controlled. -/
  neckSeparationScale : scalePayload.scaleParameterSpace → ℝ
  /-- The neck-separation scale is positive. -/
  neckSeparationScalePositive :
    ∀ parameter, 0 < neckSeparationScale parameter
  /-- Strong delta lies below the separation scale. -/
  strongDelta_le_neckSeparationScale :
    ∀ parameter,
      strongDeltaPayload.strongDelta parameter ≤
        neckSeparationScale parameter
  /-- The separation scale is controlled by the detection scale. -/
  neckSeparationScale_le_detectionScale :
    ∀ parameter,
      neckSeparationScale parameter ≤
        strongDeltaPayload.neckDetectionScale parameter

/--
Concrete parametrization data for separated surgery necks.

The payload is tied to the explicit neck-separation payload. It records a
parametrization domain inside each separated neck neighborhood, cylindrical
coordinates on that domain, and pairwise separation of the parametrization
domains for distinct surgery-scale parameters.
-/
structure SurgeryNeckParametrizationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    (neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload) :
    Type (u + 1) where
  /-- Domain on which the selected neck is parametrized. -/
  parametrizationDomain : scalePayload.scaleParameterSpace → Set M
  /-- The detected neck center lies in the parametrization domain. -/
  neckCenterMemParametrizationDomain :
    ∀ parameter,
      strongDeltaPayload.neckCenter parameter ∈
        parametrizationDomain parameter
  /-- Parametrization domains stay inside the separated neck neighborhoods. -/
  parametrizationDomain_subset_separatedNeckNeighborhood :
    ∀ parameter x,
      x ∈ parametrizationDomain parameter →
        x ∈ neckSeparationPayload.separatedNeckNeighborhood parameter
  /-- Cylindrical axis coordinate on the selected neck. -/
  cylindricalAxisCoordinate : scalePayload.scaleParameterSpace → M → ℝ
  /-- Cylindrical radial coordinate on the selected neck. -/
  cylindricalRadialCoordinate : scalePayload.scaleParameterSpace → M → ℝ
  /-- Cylindrical angular coordinate on the selected neck. -/
  cylindricalAngularCoordinate : scalePayload.scaleParameterSpace → M → ℝ
  /-- The radial coordinate is positive on the parametrization domain. -/
  radialCoordinatePositive :
    ∀ parameter x,
      x ∈ parametrizationDomain parameter →
        0 < cylindricalRadialCoordinate parameter x
  /-- The selected neck center is normalized to axis coordinate zero. -/
  neckCenter_axisCoordinate_eq_zero :
    ∀ parameter,
      cylindricalAxisCoordinate parameter
        (strongDeltaPayload.neckCenter parameter) = 0
  /-- Parametrization domains for distinct parameters are pairwise disjoint. -/
  parametrizationDomains_disjoint :
    ∀ parameter otherParameter x,
      parameter ≠ otherParameter →
        x ∈ parametrizationDomain parameter →
          x ∈ parametrizationDomain otherParameter → False

/--
Concrete canonical-coordinate data for parametrized surgery necks.

The payload is tied to the explicit neck-parametrization payload. It records
canonical coordinate charts on domains inside the parametrized necks, their
coordinate components, agreement with the cylindrical parametrization on those
domains, and a coordinate-error bound controlled by the detected strong delta.
-/
structure SurgeryNeckCanonicalCoordinatesPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    (neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload) :
    Type (u + 1) where
  /-- Domain on which canonical neck coordinates are controlled. -/
  canonicalCoordinateDomain : scalePayload.scaleParameterSpace → Set M
  /-- The detected neck center lies in the canonical coordinate domain. -/
  neckCenterMemCanonicalCoordinateDomain :
    ∀ parameter,
      strongDeltaPayload.neckCenter parameter ∈
        canonicalCoordinateDomain parameter
  /-- Canonical coordinate domains stay inside the parametrization domains. -/
  canonicalCoordinateDomain_subset_parametrizationDomain :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        x ∈ neckParametrizationPayload.parametrizationDomain parameter
  /-- Canonical coordinate map into the fixed Euclidean 3-model. -/
  canonicalCoordinateMap :
    scalePayload.scaleParameterSpace → M → ThreeManifoldModel
  /-- A recorded inverse map for the canonical coordinate chart. -/
  canonicalInverseCoordinateMap :
    scalePayload.scaleParameterSpace → ThreeManifoldModel → M
  /-- Canonical axis coordinate on each neck. -/
  canonicalAxisCoordinate : scalePayload.scaleParameterSpace → M → ℝ
  /-- Canonical radial coordinate on each neck. -/
  canonicalRadialCoordinate : scalePayload.scaleParameterSpace → M → ℝ
  /-- Canonical angular coordinate on each neck. -/
  canonicalAngularCoordinate : scalePayload.scaleParameterSpace → M → ℝ
  /-- The canonical radial coordinate is positive on the coordinate domain. -/
  canonicalRadialCoordinatePositive :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        0 < canonicalRadialCoordinate parameter x
  /-- Canonical axis coordinates agree with the cylindrical parametrization. -/
  canonicalAxisCoordinate_eq_cylindrical :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        canonicalAxisCoordinate parameter x =
          neckParametrizationPayload.cylindricalAxisCoordinate parameter x
  /-- Canonical radial coordinates agree with the cylindrical parametrization. -/
  canonicalRadialCoordinate_eq_cylindrical :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        canonicalRadialCoordinate parameter x =
          neckParametrizationPayload.cylindricalRadialCoordinate parameter x
  /-- Canonical angular coordinates agree with the cylindrical parametrization. -/
  canonicalAngularCoordinate_eq_cylindrical :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        canonicalAngularCoordinate parameter x =
          neckParametrizationPayload.cylindricalAngularCoordinate parameter x
  /-- Real-valued coordinate error assigned to each point of a canonical neck. -/
  canonicalCoordinateError : scalePayload.scaleParameterSpace → M → ℝ
  /-- The canonical coordinate error is nonnegative on its domain. -/
  canonicalCoordinateErrorNonnegative :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        0 ≤ canonicalCoordinateError parameter x
  /-- The coordinate error is controlled by the detected strong delta. -/
  canonicalCoordinateError_le_strongDelta :
    ∀ parameter x,
      x ∈ canonicalCoordinateDomain parameter →
        canonicalCoordinateError parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Canonical neck coordinate domains are contained in the detected strong delta-neck regions. -/
theorem SurgeryNeckCanonicalCoordinatesPayload.canonicalCoordinateDomain_subset_detectedNeckRegion
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    (neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload) :
    ∀ parameter x,
      x ∈ neckCanonicalCoordinatesPayload.canonicalCoordinateDomain parameter →
        x ∈ strongDeltaPayload.detectedNeckRegion parameter := by
  intro parameter x hx
  exact
    neckSeparationPayload.separatedNeckNeighborhood_subset_detectedNeckRegion
      parameter x
      (neckParametrizationPayload.parametrizationDomain_subset_separatedNeckNeighborhood
        parameter x
        (neckCanonicalCoordinatesPayload.canonicalCoordinateDomain_subset_parametrizationDomain
          parameter x hx))

/--
Concrete decomposition data for surgery necks with canonical coordinates.

The payload is tied to the explicit canonical-coordinate payload. It records
which points belong to each decomposed neck, assigns points to their selected
neck parameter, decomposes each neck into negative-end, central, and positive-end
regions, and records the axial levels that separate those regions.
-/
structure SurgeryNeckDecompositionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    (neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload) :
    Type (u + 1) where
  /-- Region assigned to each decomposed surgery neck. -/
  decomposedNeckRegion : scalePayload.scaleParameterSpace → Set M
  /-- Canonical coordinate domains are covered by the decomposed neck regions. -/
  canonicalCoordinateDomain_subset_decomposedNeckRegion :
    ∀ parameter x,
      x ∈ neckCanonicalCoordinatesPayload.canonicalCoordinateDomain parameter →
        x ∈ decomposedNeckRegion parameter
  /-- Decomposed neck regions stay inside the canonical coordinate domains. -/
  decomposedNeckRegion_subset_canonicalCoordinateDomain :
    ∀ parameter x,
      x ∈ decomposedNeckRegion parameter →
        x ∈ neckCanonicalCoordinatesPayload.canonicalCoordinateDomain parameter
  /-- Assignment of points to their selected surgery-neck parameter, if any. -/
  neckAssignment : M → Option scalePayload.scaleParameterSpace
  /-- Points in a decomposed neck region are assigned to that neck parameter. -/
  decomposedNeckRegion_assignment :
    ∀ parameter x,
      x ∈ decomposedNeckRegion parameter →
        neckAssignment x = some parameter
  /-- Assigned points lie in the corresponding decomposed neck region. -/
  neckAssignment_mem_decomposedNeckRegion :
    ∀ parameter x,
      neckAssignment x = some parameter →
        x ∈ decomposedNeckRegion parameter
  /-- Decomposed neck regions for distinct parameters are pairwise disjoint. -/
  decomposedNeckRegions_disjoint :
    ∀ parameter otherParameter x,
      parameter ≠ otherParameter →
        x ∈ decomposedNeckRegion parameter →
          x ∈ decomposedNeckRegion otherParameter → False
  /-- Negative axial end of each decomposed neck. -/
  negativeEndRegion : scalePayload.scaleParameterSpace → Set M
  /-- Central region of each decomposed neck. -/
  centralNeckRegion : scalePayload.scaleParameterSpace → Set M
  /-- Positive axial end of each decomposed neck. -/
  positiveEndRegion : scalePayload.scaleParameterSpace → Set M
  /-- Negative ends stay inside their decomposed neck regions. -/
  negativeEndRegion_subset_decomposedNeckRegion :
    ∀ parameter x,
      x ∈ negativeEndRegion parameter →
        x ∈ decomposedNeckRegion parameter
  /-- Central regions stay inside their decomposed neck regions. -/
  centralNeckRegion_subset_decomposedNeckRegion :
    ∀ parameter x,
      x ∈ centralNeckRegion parameter →
        x ∈ decomposedNeckRegion parameter
  /-- Positive ends stay inside their decomposed neck regions. -/
  positiveEndRegion_subset_decomposedNeckRegion :
    ∀ parameter x,
      x ∈ positiveEndRegion parameter →
        x ∈ decomposedNeckRegion parameter
  /-- The three neck pieces cover each decomposed neck region. -/
  decomposedNeckRegion_covered_by_pieces :
    ∀ parameter x,
      x ∈ decomposedNeckRegion parameter →
        x ∈ negativeEndRegion parameter ∨
          x ∈ centralNeckRegion parameter ∨
            x ∈ positiveEndRegion parameter
  /-- Negative and central neck pieces are disjoint. -/
  negativeEndRegion_disjoint_centralNeckRegion :
    ∀ parameter x,
      x ∈ negativeEndRegion parameter →
        x ∈ centralNeckRegion parameter → False
  /-- Negative and positive neck pieces are disjoint. -/
  negativeEndRegion_disjoint_positiveEndRegion :
    ∀ parameter x,
      x ∈ negativeEndRegion parameter →
        x ∈ positiveEndRegion parameter → False
  /-- Central and positive neck pieces are disjoint. -/
  centralNeckRegion_disjoint_positiveEndRegion :
    ∀ parameter x,
      x ∈ centralNeckRegion parameter →
        x ∈ positiveEndRegion parameter → False
  /-- Negative axial boundary level separating the central neck. -/
  negativeBoundaryLevel : scalePayload.scaleParameterSpace → ℝ
  /-- Positive axial boundary level separating the central neck. -/
  positiveBoundaryLevel : scalePayload.scaleParameterSpace → ℝ
  /-- The negative boundary lies below the positive boundary. -/
  negativeBoundaryLevel_lt_positiveBoundaryLevel :
    ∀ parameter,
      negativeBoundaryLevel parameter < positiveBoundaryLevel parameter
  /-- Negative-end points lie below the negative boundary level. -/
  negativeEndRegion_axis_le :
    ∀ parameter x,
      x ∈ negativeEndRegion parameter →
        neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x ≤
          negativeBoundaryLevel parameter
  /-- Central neck points lie between the two boundary levels. -/
  centralNeckRegion_axis_between :
    ∀ parameter x,
      x ∈ centralNeckRegion parameter →
        negativeBoundaryLevel parameter ≤
            neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x ∧
          neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x ≤
            positiveBoundaryLevel parameter
  /-- Positive-end points lie above the positive boundary level. -/
  positiveEndRegion_axis_ge :
    ∀ parameter x,
      x ∈ positiveEndRegion parameter →
        positiveBoundaryLevel parameter ≤
          neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x

/--
Concrete standard-cap model data for decomposed surgery necks.

The payload is tied to the explicit neck-decomposition payload. It records the
model cap region and its core, transition, and attachment pieces, identifies the
attachment with the positive end of the decomposed neck, and stores scale and
model-error controls for the cap geometry.
-/
structure StandardCapModelPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    (neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload) :
    Type (u + 1) where
  /-- Region occupied by the standard cap model for each surgery neck. -/
  standardCapRegion : scalePayload.scaleParameterSpace → Set M
  /-- Distinguished tip point of the standard cap model. -/
  capTip : scalePayload.scaleParameterSpace → M
  /-- The cap tip lies in the corresponding standard cap region. -/
  capTipMemStandardCapRegion :
    ∀ parameter, capTip parameter ∈ standardCapRegion parameter
  /-- Compact core part of the standard cap model. -/
  capCoreRegion : scalePayload.scaleParameterSpace → Set M
  /-- The cap core lies inside the standard cap region. -/
  capCoreRegion_subset_standardCapRegion :
    ∀ parameter x,
      x ∈ capCoreRegion parameter →
        x ∈ standardCapRegion parameter
  /-- The cap tip lies in the cap core. -/
  capTipMemCapCoreRegion :
    ∀ parameter, capTip parameter ∈ capCoreRegion parameter
  /-- Cylindrical transition part of the standard cap model. -/
  capTransitionRegion : scalePayload.scaleParameterSpace → Set M
  /-- The transition part lies inside the standard cap region. -/
  capTransitionRegion_subset_standardCapRegion :
    ∀ parameter x,
      x ∈ capTransitionRegion parameter →
        x ∈ standardCapRegion parameter
  /-- Attachment locus where the cap model meets the decomposed neck. -/
  capAttachmentRegion : scalePayload.scaleParameterSpace → Set M
  /-- The attachment locus lies inside the standard cap region. -/
  capAttachmentRegion_subset_standardCapRegion :
    ∀ parameter x,
      x ∈ capAttachmentRegion parameter →
        x ∈ standardCapRegion parameter
  /-- The attachment locus is the positive end selected by neck decomposition. -/
  capAttachmentRegion_subset_positiveEndRegion :
    ∀ parameter x,
      x ∈ capAttachmentRegion parameter →
        x ∈ neckDecompositionPayload.positiveEndRegion parameter
  /-- The positive end selected by neck decomposition is included in the attachment. -/
  positiveEndRegion_subset_capAttachmentRegion :
    ∀ parameter x,
      x ∈ neckDecompositionPayload.positiveEndRegion parameter →
        x ∈ capAttachmentRegion parameter
  /-- The cap tip is not in the cylindrical attachment locus. -/
  capTip_not_mem_capAttachmentRegion :
    ∀ parameter,
      capTip parameter ∈ capAttachmentRegion parameter → False
  /-- Standard cap regions for distinct neck parameters are pairwise disjoint. -/
  standardCapRegions_disjoint :
    ∀ parameter otherParameter x,
      parameter ≠ otherParameter →
        x ∈ standardCapRegion parameter →
          x ∈ standardCapRegion otherParameter → False
  /-- Scale at which the standard cap model is inserted. -/
  standardCapScale : scalePayload.scaleParameterSpace → ℝ
  /-- The standard cap scale is positive. -/
  standardCapScalePositive :
    ∀ parameter, 0 < standardCapScale parameter
  /-- The cap scale is controlled by the selected surgery parameter. -/
  standardCapScale_le_surgeryParameter :
    ∀ parameter,
      standardCapScale parameter ≤
        parameterSelectionPayload.surgeryParameter parameter
  /-- Real-valued model curvature profile on the standard cap. -/
  standardCapCurvatureProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The model curvature profile is nonnegative on the cap region. -/
  standardCapCurvatureProfileNonnegative :
    ∀ parameter x,
      x ∈ standardCapRegion parameter →
        0 ≤ standardCapCurvatureProfile parameter x
  /-- Real-valued model error assigned to points of the cap region. -/
  standardCapModelError : scalePayload.scaleParameterSpace → M → ℝ
  /-- The standard cap model error is nonnegative on the cap region. -/
  standardCapModelErrorNonnegative :
    ∀ parameter x,
      x ∈ standardCapRegion parameter →
        0 ≤ standardCapModelError parameter x
  /-- The standard cap model error is controlled by the detected strong delta. -/
  standardCapModelError_le_strongDelta :
    ∀ parameter x,
      x ∈ standardCapRegion parameter →
        standardCapModelError parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Cap attachment regions lie inside the detected strong delta-neck regions. -/
theorem StandardCapModelPayload.capAttachmentRegion_subset_detectedNeckRegion
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    (standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload) :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capAttachmentRegion parameter →
        x ∈ strongDeltaPayload.detectedNeckRegion parameter := by
  intro parameter x hx
  exact
    neckSeparationPayload.separatedNeckNeighborhood_subset_detectedNeckRegion
      parameter x
      (neckParametrizationPayload.parametrizationDomain_subset_separatedNeckNeighborhood
        parameter x
        (neckCanonicalCoordinatesPayload.canonicalCoordinateDomain_subset_parametrizationDomain
          parameter x
          (neckDecompositionPayload.decomposedNeckRegion_subset_canonicalCoordinateDomain
            parameter x
            (neckDecompositionPayload.positiveEndRegion_subset_decomposedNeckRegion
              parameter x
              (standardCapModelPayload.capAttachmentRegion_subset_positiveEndRegion
                parameter x hx)))))

/--
Concrete smooth gluing data for attaching standard caps to decomposed surgery
necks.

The payload is tied to the explicit standard-cap model payload. It records the
gluing region in the cap attachment and positive neck end, a smooth axial cutoff
used to blend neck and cap models, and an error bound controlled by the detected
strong delta.
-/
structure CapGluingSmoothnessPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    (standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload) :
    Type (u + 1) where
  /-- Region where the cap model is smoothly glued to the neck model. -/
  gluingRegion : scalePayload.scaleParameterSpace → Set M
  /-- The gluing region lies in the cap attachment locus. -/
  gluingRegion_subset_capAttachmentRegion :
    ∀ parameter x,
      x ∈ gluingRegion parameter →
        x ∈ standardCapModelPayload.capAttachmentRegion parameter
  /-- The gluing region lies in the positive end of the decomposed neck. -/
  gluingRegion_subset_positiveEndRegion :
    ∀ parameter x,
      x ∈ gluingRegion parameter →
        x ∈ neckDecompositionPayload.positiveEndRegion parameter
  /-- The cap attachment locus is covered by the gluing region. -/
  capAttachmentRegion_subset_gluingRegion :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capAttachmentRegion parameter →
        x ∈ gluingRegion parameter
  /-- Smooth scalar cutoff used across the axial gluing transition. -/
  gluingCutoff : scalePayload.scaleParameterSpace → ℝ → ℝ
  /-- Smoothness of the scalar gluing cutoff. -/
  gluingCutoffSmooth :
    ∀ parameter, ContDiff ℝ ⊤ (gluingCutoff parameter)
  /-- Axial start of the gluing transition. -/
  gluingTransitionStart : scalePayload.scaleParameterSpace → ℝ
  /-- Axial end of the gluing transition. -/
  gluingTransitionEnd : scalePayload.scaleParameterSpace → ℝ
  /-- The gluing transition has positive axial width. -/
  gluingTransitionStart_lt_end :
    ∀ parameter,
      gluingTransitionStart parameter < gluingTransitionEnd parameter
  /-- The gluing transition begins after the positive neck boundary. -/
  positiveBoundaryLevel_le_gluingTransitionStart :
    ∀ parameter,
      neckDecompositionPayload.positiveBoundaryLevel parameter ≤
        gluingTransitionStart parameter
  /-- Gluing-region points lie within the axial transition band. -/
  gluingRegion_axis_between :
    ∀ parameter x,
      x ∈ gluingRegion parameter →
        gluingTransitionStart parameter ≤
            neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x ∧
          neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x ≤
            gluingTransitionEnd parameter
  /-- The cutoff is the neck value before the transition starts. -/
  gluingCutoff_eq_zero_of_le_start :
    ∀ parameter s,
      s ≤ gluingTransitionStart parameter →
        gluingCutoff parameter s = 0
  /-- The cutoff is the cap value after the transition ends. -/
  gluingCutoff_eq_one_of_end_le :
    ∀ parameter s,
      gluingTransitionEnd parameter ≤ s →
        gluingCutoff parameter s = 1
  /-- The gluing cutoff is bounded between zero and one. -/
  gluingCutoffRange :
    ∀ parameter s,
      0 ≤ gluingCutoff parameter s ∧ gluingCutoff parameter s ≤ 1
  /-- Real-valued error of the smooth cap-neck gluing. -/
  gluingSmoothnessError : scalePayload.scaleParameterSpace → M → ℝ
  /-- The gluing smoothness error is nonnegative on the gluing region. -/
  gluingSmoothnessErrorNonnegative :
    ∀ parameter x,
      x ∈ gluingRegion parameter →
        0 ≤ gluingSmoothnessError parameter x
  /-- The gluing smoothness error is controlled by the detected strong delta. -/
  gluingSmoothnessError_le_strongDelta :
    ∀ parameter x,
      x ∈ gluingRegion parameter →
        gluingSmoothnessError parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- The cap-gluing region is exactly the cap attachment locus. -/
theorem CapGluingSmoothnessPayload.gluingRegion_eq_capAttachmentRegion
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    (capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload) :
    ∀ parameter,
      capGluingSmoothnessPayload.gluingRegion parameter =
        standardCapModelPayload.capAttachmentRegion parameter := by
  intro parameter
  ext x
  constructor
  · exact capGluingSmoothnessPayload.gluingRegion_subset_capAttachmentRegion
      parameter x
  · exact capGluingSmoothnessPayload.capAttachmentRegion_subset_gluingRegion
      parameter x

/-- Cap-gluing regions lie inside the detected strong delta-neck regions. -/
theorem CapGluingSmoothnessPayload.gluingRegion_subset_detectedNeckRegion
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    (capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload) :
    ∀ parameter x,
      x ∈ capGluingSmoothnessPayload.gluingRegion parameter →
        x ∈ strongDeltaPayload.detectedNeckRegion parameter := by
  intro parameter x hx
  exact
    standardCapModelPayload.capAttachmentRegion_subset_detectedNeckRegion
      parameter x
      (capGluingSmoothnessPayload.gluingRegion_subset_capAttachmentRegion
        parameter x hx)

/-- Gluing-region points occur after the positive neck boundary level. -/
theorem CapGluingSmoothnessPayload.positiveBoundaryLevel_le_axis_of_mem_gluingRegion
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    (capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload) :
    ∀ parameter x,
      x ∈ capGluingSmoothnessPayload.gluingRegion parameter →
        neckDecompositionPayload.positiveBoundaryLevel parameter ≤
          neckCanonicalCoordinatesPayload.canonicalAxisCoordinate parameter x := by
  intro parameter x hx
  exact le_trans
    (capGluingSmoothnessPayload.positiveBoundaryLevel_le_gluingTransitionStart
      parameter)
    (capGluingSmoothnessPayload.gluingRegion_axis_between parameter x hx).1

/--
Concrete metric interpolation data across the cap-neck gluing region.

The payload is tied to explicit cap-gluing smoothness data. It records the
region where neck and cap metric profiles are blended, a smooth axial weight
with the same transition endpoints as the cap-gluing cutoff, and real-valued
profile/error controls for the interpolated metric.
-/
structure SurgeryCapMetricInterpolationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    (capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload) :
    Type (u + 1) where
  /-- Region where the neck and cap metric profiles are interpolated. -/
  interpolationRegion : scalePayload.scaleParameterSpace → Set M
  /-- The cap-gluing region is included in the metric interpolation region. -/
  gluingRegion_subset_interpolationRegion :
    ∀ parameter x,
      x ∈ capGluingSmoothnessPayload.gluingRegion parameter →
        x ∈ interpolationRegion parameter
  /-- The interpolation region stays inside the cap model or positive neck end. -/
  interpolationRegion_subset_cap_or_positiveEnd :
    ∀ parameter x,
      x ∈ interpolationRegion parameter →
        x ∈ standardCapModelPayload.standardCapRegion parameter ∨
          x ∈ neckDecompositionPayload.positiveEndRegion parameter
  /-- The cap attachment locus is covered by the interpolation region. -/
  capAttachmentRegion_subset_interpolationRegion :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capAttachmentRegion parameter →
        x ∈ interpolationRegion parameter
  /-- The positive neck end is covered by the interpolation region. -/
  positiveEndRegion_subset_interpolationRegion :
    ∀ parameter x,
      x ∈ neckDecompositionPayload.positiveEndRegion parameter →
        x ∈ interpolationRegion parameter
  /-- Smooth axial weight used to interpolate from neck metric to cap metric. -/
  interpolationWeight : scalePayload.scaleParameterSpace → ℝ → ℝ
  /-- Smoothness of the axial interpolation weight. -/
  interpolationWeightSmooth :
    ∀ parameter, ContDiff ℝ ⊤ (interpolationWeight parameter)
  /-- Before the gluing transition, the interpolation is purely neck metric. -/
  interpolationWeight_eq_zero_of_le_start :
    ∀ parameter s,
      s ≤ capGluingSmoothnessPayload.gluingTransitionStart parameter →
        interpolationWeight parameter s = 0
  /-- After the gluing transition, the interpolation is purely cap metric. -/
  interpolationWeight_eq_one_of_end_le :
    ∀ parameter s,
      capGluingSmoothnessPayload.gluingTransitionEnd parameter ≤ s →
        interpolationWeight parameter s = 1
  /-- The interpolation weight is bounded between zero and one. -/
  interpolationWeightRange :
    ∀ parameter s,
      0 ≤ interpolationWeight parameter s ∧
        interpolationWeight parameter s ≤ 1
  /-- Real-valued profile standing in for the incoming neck metric. -/
  neckMetricProfile : scalePayload.scaleParameterSpace → M → ℝ
  /-- Real-valued profile standing in for the standard cap metric. -/
  capMetricProfile : scalePayload.scaleParameterSpace → M → ℝ
  /-- Real-valued profile of the interpolated cap-neck metric. -/
  interpolatedMetricProfile : scalePayload.scaleParameterSpace → M → ℝ
  /-- The interpolated metric profile is the weighted neck/cap blend. -/
  interpolatedMetricProfile_eq_weighted_blend :
    ∀ parameter x,
      x ∈ interpolationRegion parameter →
        interpolatedMetricProfile parameter x =
          (1 -
              interpolationWeight parameter
                (neckCanonicalCoordinatesPayload.canonicalAxisCoordinate
                  parameter x)) *
            neckMetricProfile parameter x +
          interpolationWeight parameter
              (neckCanonicalCoordinatesPayload.canonicalAxisCoordinate
                parameter x) *
            capMetricProfile parameter x
  /-- Real-valued interpolation error of the cap-neck metric blend. -/
  capMetricInterpolationError :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The interpolation error is nonnegative on the interpolation region. -/
  capMetricInterpolationErrorNonnegative :
    ∀ parameter x,
      x ∈ interpolationRegion parameter →
        0 ≤ capMetricInterpolationError parameter x
  /-- The interpolation error is controlled by the cap-gluing smoothness error. -/
  capMetricInterpolationError_le_gluingSmoothnessError :
    ∀ parameter x,
      x ∈ interpolationRegion parameter →
        capMetricInterpolationError parameter x ≤
          capGluingSmoothnessPayload.gluingSmoothnessError parameter x
  /-- The interpolation error is controlled by the detected strong delta. -/
  capMetricInterpolationError_le_strongDelta :
    ∀ parameter x,
      x ∈ interpolationRegion parameter →
        capMetricInterpolationError parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- On the gluing region, metric interpolation inherits nonnegativity and error controls. -/
theorem SurgeryCapMetricInterpolationPayload.gluingRegion_interpolation_error_controls
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    (capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload) :
    ∀ parameter x,
      x ∈ capGluingSmoothnessPayload.gluingRegion parameter →
        0 ≤ capMetricInterpolationPayload.capMetricInterpolationError parameter x ∧
          capMetricInterpolationPayload.capMetricInterpolationError parameter x ≤
            capGluingSmoothnessPayload.gluingSmoothnessError parameter x ∧
          capMetricInterpolationPayload.capMetricInterpolationError parameter x ≤
            strongDeltaPayload.strongDelta parameter := by
  intro parameter x hx
  have hinterp : x ∈ capMetricInterpolationPayload.interpolationRegion parameter :=
    capMetricInterpolationPayload.gluingRegion_subset_interpolationRegion
      parameter x hx
  exact
    ⟨capMetricInterpolationPayload.capMetricInterpolationErrorNonnegative
        parameter x hinterp,
      capMetricInterpolationPayload.capMetricInterpolationError_le_gluingSmoothnessError
        parameter x hinterp,
      capMetricInterpolationPayload.capMetricInterpolationError_le_strongDelta
        parameter x hinterp⟩

/--
Concrete curvature estimate data for the standard cap and its metric
interpolation region.

The payload is tied to explicit cap metric interpolation data. It records the
region on which cap curvature is controlled, real-valued sectional and scalar
curvature profiles, comparison with the standard cap model profile, and error
control inherited from the metric interpolation and strong delta-neck data.
-/
structure SurgeryCapCurvatureEstimatesPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    (capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload) :
    Type (u + 1) where
  /-- Region where cap curvature estimates are asserted. -/
  curvatureControlRegion : scalePayload.scaleParameterSpace → Set M
  /-- The inserted standard cap lies in the curvature-control region. -/
  standardCapRegion_subset_curvatureControlRegion :
    ∀ parameter x,
      x ∈ standardCapModelPayload.standardCapRegion parameter →
        x ∈ curvatureControlRegion parameter
  /-- The metric interpolation region lies in the curvature-control region. -/
  interpolationRegion_subset_curvatureControlRegion :
    ∀ parameter x,
      x ∈ capMetricInterpolationPayload.interpolationRegion parameter →
        x ∈ curvatureControlRegion parameter
  /-- The curvature-control region stays on the cap or interpolation locus. -/
  curvatureControlRegion_subset_cap_or_interpolation :
    ∀ parameter x,
      x ∈ curvatureControlRegion parameter →
        x ∈ standardCapModelPayload.standardCapRegion parameter ∨
          x ∈ capMetricInterpolationPayload.interpolationRegion parameter
  /-- Sectional-curvature profile assigned to the cap replacement. -/
  capSectionalCurvatureProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- Scalar-curvature profile assigned to the cap replacement. -/
  capScalarCurvatureProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- Scalar curvature is nonnegative on the curvature-control region. -/
  capScalarCurvatureNonnegative :
    ∀ parameter x,
      x ∈ curvatureControlRegion parameter →
        0 ≤ capScalarCurvatureProfile parameter x
  /-- Sectional curvature is nonnegative on the compact cap core. -/
  capSectionalCurvatureNonnegativeOnCore :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capCoreRegion parameter →
        0 ≤ capSectionalCurvatureProfile parameter x
  /-- Real-valued error in the cap curvature estimates. -/
  capCurvatureEstimateError :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The cap curvature estimate error is nonnegative where estimates apply. -/
  capCurvatureEstimateErrorNonnegative :
    ∀ parameter x,
      x ∈ curvatureControlRegion parameter →
        0 ≤ capCurvatureEstimateError parameter x
  /-- The cap sectional profile is bounded by the standard model plus error. -/
  capSectionalCurvature_le_model_plus_error :
    ∀ parameter x,
      x ∈ standardCapModelPayload.standardCapRegion parameter →
        capSectionalCurvatureProfile parameter x ≤
          standardCapModelPayload.standardCapCurvatureProfile parameter x +
            capCurvatureEstimateError parameter x
  /-- The standard model profile is bounded by the cap sectional profile plus error. -/
  model_le_capSectionalCurvature_plus_error :
    ∀ parameter x,
      x ∈ standardCapModelPayload.standardCapRegion parameter →
        standardCapModelPayload.standardCapCurvatureProfile parameter x ≤
          capSectionalCurvatureProfile parameter x +
            capCurvatureEstimateError parameter x
  /-- Interpolation curvature error is controlled by metric interpolation error. -/
  capCurvatureEstimateError_le_interpolationError_plus_modelError :
    ∀ parameter x,
      x ∈ capMetricInterpolationPayload.interpolationRegion parameter →
        capCurvatureEstimateError parameter x ≤
          capMetricInterpolationPayload.capMetricInterpolationError
              parameter x +
            standardCapModelPayload.standardCapModelError parameter x
  /-- The cap curvature estimate error is controlled by the detected strong delta. -/
  capCurvatureEstimateError_le_strongDelta :
    ∀ parameter x,
      x ∈ curvatureControlRegion parameter →
        capCurvatureEstimateError parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Cap-core points lie in the curvature-control region and have nonnegative sectional profile. -/
theorem SurgeryCapCurvatureEstimatesPayload.capCore_curvature_control_and_nonnegative
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload}
    (capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload capMetricInterpolationPayload) :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capCoreRegion parameter →
        x ∈ capCurvatureEstimatesPayload.curvatureControlRegion parameter ∧
          0 ≤ capCurvatureEstimatesPayload.capSectionalCurvatureProfile parameter x := by
  intro parameter x hx
  have hstd : x ∈ standardCapModelPayload.standardCapRegion parameter :=
    standardCapModelPayload.capCoreRegion_subset_standardCapRegion parameter x hx
  exact
    ⟨capCurvatureEstimatesPayload.standardCapRegion_subset_curvatureControlRegion
        parameter x hstd,
      capCurvatureEstimatesPayload.capSectionalCurvatureNonnegativeOnCore
        parameter x hx⟩

/--
Concrete standard-cap construction data after cap curvature estimates.

The payload is tied to explicit cap-curvature-estimate data. It records the
actual constructed cap region, its attachment locus, the metric and scalar
profiles used on the constructed cap, scale agreement with the standard cap
model, and construction-error bounds inherited from the curvature estimates.
-/
structure SurgeryCapConstructionPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    (capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload) :
    Type (u + 1) where
  /-- Region occupied by the constructed cap replacement. -/
  constructedCapRegion : scalePayload.scaleParameterSpace → Set M
  /-- The standard cap model region is included in the constructed cap. -/
  standardCapRegion_subset_constructedCapRegion :
    ∀ parameter x,
      x ∈ standardCapModelPayload.standardCapRegion parameter →
        x ∈ constructedCapRegion parameter
  /-- The metric interpolation region is included in the constructed cap. -/
  interpolationRegion_subset_constructedCapRegion :
    ∀ parameter x,
      x ∈ capMetricInterpolationPayload.interpolationRegion parameter →
        x ∈ constructedCapRegion parameter
  /-- The constructed cap stays within the region where curvature is controlled. -/
  constructedCapRegion_subset_curvatureControlRegion :
    ∀ parameter x,
      x ∈ constructedCapRegion parameter →
        x ∈ capCurvatureEstimatesPayload.curvatureControlRegion parameter
  /-- The standard cap tip lies in the constructed cap. -/
  capTipMemConstructedCapRegion :
    ∀ parameter,
      standardCapModelPayload.capTip parameter ∈
        constructedCapRegion parameter
  /-- Attachment locus of the constructed cap. -/
  constructedAttachmentRegion : scalePayload.scaleParameterSpace → Set M
  /-- The constructed attachment locus lies in the constructed cap. -/
  constructedAttachmentRegion_subset_constructedCapRegion :
    ∀ parameter x,
      x ∈ constructedAttachmentRegion parameter →
        x ∈ constructedCapRegion parameter
  /-- The standard cap attachment is included in the constructed attachment. -/
  capAttachmentRegion_subset_constructedAttachmentRegion :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capAttachmentRegion parameter →
        x ∈ constructedAttachmentRegion parameter
  /-- The constructed attachment lies in the interpolation region. -/
  constructedAttachmentRegion_subset_interpolationRegion :
    ∀ parameter x,
      x ∈ constructedAttachmentRegion parameter →
        x ∈ capMetricInterpolationPayload.interpolationRegion parameter
  /-- Scale used by the constructed cap. -/
  constructedCapScale : scalePayload.scaleParameterSpace → ℝ
  /-- The constructed cap scale agrees with the standard cap model scale. -/
  constructedCapScale_eq_standardCapScale :
    ∀ parameter,
      constructedCapScale parameter =
        standardCapModelPayload.standardCapScale parameter
  /-- The constructed cap scale is positive. -/
  constructedCapScalePositive :
    ∀ parameter, 0 < constructedCapScale parameter
  /-- Real-valued metric profile assigned to the constructed cap. -/
  constructedMetricProfile : scalePayload.scaleParameterSpace → M → ℝ
  /-- The constructed metric agrees with interpolation on the transition region. -/
  constructedMetricProfile_eq_interpolated_on_interpolation :
    ∀ parameter x,
      x ∈ capMetricInterpolationPayload.interpolationRegion parameter →
        constructedMetricProfile parameter x =
          capMetricInterpolationPayload.interpolatedMetricProfile parameter x
  /-- The constructed metric agrees with the cap profile on the cap core. -/
  constructedMetricProfile_eq_cap_on_core :
    ∀ parameter x,
      x ∈ standardCapModelPayload.capCoreRegion parameter →
        constructedMetricProfile parameter x =
          capMetricInterpolationPayload.capMetricProfile parameter x
  /-- Scalar-curvature profile assigned to the constructed cap. -/
  constructedScalarCurvatureProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The constructed scalar profile agrees with the cap curvature estimate. -/
  constructedScalarCurvatureProfile_eq_capEstimate :
    ∀ parameter x,
      x ∈ constructedCapRegion parameter →
        constructedScalarCurvatureProfile parameter x =
          capCurvatureEstimatesPayload.capScalarCurvatureProfile parameter x
  /-- The constructed scalar curvature is nonnegative on the constructed cap. -/
  constructedScalarCurvatureNonnegative :
    ∀ parameter x,
      x ∈ constructedCapRegion parameter →
        0 ≤ constructedScalarCurvatureProfile parameter x
  /-- Real-valued construction error of the cap replacement. -/
  capConstructionError : scalePayload.scaleParameterSpace → M → ℝ
  /-- The cap construction error is nonnegative on the constructed cap. -/
  capConstructionErrorNonnegative :
    ∀ parameter x,
      x ∈ constructedCapRegion parameter →
        0 ≤ capConstructionError parameter x
  /-- The cap construction error is controlled by the curvature-estimate error. -/
  capConstructionError_le_curvatureEstimateError :
    ∀ parameter x,
      x ∈ constructedCapRegion parameter →
        capConstructionError parameter x ≤
          capCurvatureEstimatesPayload.capCurvatureEstimateError parameter x
  /-- The cap construction error is controlled by the detected strong delta. -/
  capConstructionError_le_strongDelta :
    ∀ parameter x,
      x ∈ constructedCapRegion parameter →
        capConstructionError parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Constructed cap points carry curvature-control membership, scalar nonnegativity, and error bounds. -/
theorem SurgeryCapConstructionPayload.constructed_cap_curvature_error_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload capMetricInterpolationPayload}
    (capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload) :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ capCurvatureEstimatesPayload.curvatureControlRegion parameter ∧
          0 ≤ capConstructionPayload.constructedScalarCurvatureProfile parameter x ∧
          0 ≤ capConstructionPayload.capConstructionError parameter x ∧
          capConstructionPayload.capConstructionError parameter x ≤
            capCurvatureEstimatesPayload.capCurvatureEstimateError parameter x ∧
          capConstructionPayload.capConstructionError parameter x ≤
            strongDeltaPayload.strongDelta parameter := by
  intro parameter x hx
  exact
    ⟨capConstructionPayload.constructedCapRegion_subset_curvatureControlRegion
        parameter x hx,
      capConstructionPayload.constructedScalarCurvatureNonnegative parameter x hx,
      capConstructionPayload.capConstructionErrorNonnegative parameter x hx,
      capConstructionPayload.capConstructionError_le_curvatureEstimateError
        parameter x hx,
      capConstructionPayload.capConstructionError_le_strongDelta parameter x hx⟩

/--
Concrete post-surgery curvature pinching data after the cap has been
constructed.

The payload is tied to explicit cap-construction data. It records the region on
which the post-surgery curvature pinching estimate is asserted, scalar and
curvature-operator profiles after surgery, a real-valued pinching lower bound,
and a pinching defect controlled by the cap construction error and strong
delta-neck data.
-/
structure PostSurgeryCurvaturePinchingPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    (capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload) :
    Type (u + 1) where
  /-- Region on which post-surgery curvature pinching is controlled. -/
  pinchingRegion : scalePayload.scaleParameterSpace → Set M
  /-- The constructed cap lies in the pinching-control region. -/
  constructedCapRegion_subset_pinchingRegion :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ pinchingRegion parameter
  /-- The curvature-control region lies in the pinching-control region. -/
  curvatureControlRegion_subset_pinchingRegion :
    ∀ parameter x,
      x ∈ capCurvatureEstimatesPayload.curvatureControlRegion parameter →
        x ∈ pinchingRegion parameter
  /-- The pinching-control region stays on the cap or curvature-control locus. -/
  pinchingRegion_subset_constructedCap_or_curvatureControl :
    ∀ parameter x,
      x ∈ pinchingRegion parameter →
        x ∈ capConstructionPayload.constructedCapRegion parameter ∨
          x ∈ capCurvatureEstimatesPayload.curvatureControlRegion parameter
  /-- Scalar-curvature profile after the surgery modification. -/
  postSurgeryScalarCurvatureProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- Curvature-operator profile after the surgery modification. -/
  postSurgeryCurvatureOperatorProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The post-surgery scalar profile agrees with the constructed cap profile. -/
  postSurgeryScalarProfile_eq_constructed :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        postSurgeryScalarCurvatureProfile parameter x =
          capConstructionPayload.constructedScalarCurvatureProfile
            parameter x
  /-- The post-surgery scalar curvature is nonnegative on the pinching region. -/
  postSurgeryScalarCurvatureNonnegative :
    ∀ parameter x,
      x ∈ pinchingRegion parameter →
        0 ≤ postSurgeryScalarCurvatureProfile parameter x
  /-- Lower bound used in the post-surgery pinching inequality. -/
  postSurgeryPinchingLowerBound :
    scalePayload.scaleParameterSpace → ℝ
  /-- The post-surgery pinching lower bounds are nonnegative. -/
  postSurgeryPinchingLowerBoundNonnegative :
    ∀ parameter, 0 ≤ postSurgeryPinchingLowerBound parameter
  /-- Real-valued defect in the post-surgery pinching inequality. -/
  postSurgeryPinchingDefect :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The post-surgery pinching defect is nonnegative. -/
  postSurgeryPinchingDefectNonnegative :
    ∀ parameter x,
      x ∈ pinchingRegion parameter →
        0 ≤ postSurgeryPinchingDefect parameter x
  /-- The post-surgery curvature operator satisfies the pinching lower bound. -/
  postSurgeryCurvatureOperator_pinched :
    ∀ parameter x,
      x ∈ pinchingRegion parameter →
        postSurgeryPinchingLowerBound parameter ≤
          postSurgeryCurvatureOperatorProfile parameter x +
            postSurgeryPinchingDefect parameter x
  /-- The scalar profile satisfies the same pinching lower bound. -/
  postSurgeryScalarCurvature_pinched :
    ∀ parameter x,
      x ∈ pinchingRegion parameter →
        postSurgeryPinchingLowerBound parameter ≤
          postSurgeryScalarCurvatureProfile parameter x +
            postSurgeryPinchingDefect parameter x
  /-- The pinching defect is controlled by the cap construction error. -/
  postSurgeryPinchingDefect_le_capConstructionError :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        postSurgeryPinchingDefect parameter x ≤
          capConstructionPayload.capConstructionError parameter x
  /-- The pinching defect is controlled by the detected strong delta. -/
  postSurgeryPinchingDefect_le_strongDelta :
    ∀ parameter x,
      x ∈ pinchingRegion parameter →
        postSurgeryPinchingDefect parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Constructed cap points satisfy the post-surgery pinching-region controls. -/
theorem PostSurgeryCurvaturePinchingPayload.constructed_cap_pinching_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    (postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload) :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ postSurgeryCurvaturePinchingPayload.pinchingRegion parameter ∧
          postSurgeryCurvaturePinchingPayload.postSurgeryScalarCurvatureProfile
              parameter x =
            capConstructionPayload.constructedScalarCurvatureProfile parameter x ∧
          0 ≤
            postSurgeryCurvaturePinchingPayload.postSurgeryScalarCurvatureProfile
              parameter x ∧
          postSurgeryCurvaturePinchingPayload.postSurgeryPinchingDefect
              parameter x ≤
            capConstructionPayload.capConstructionError parameter x ∧
          postSurgeryCurvaturePinchingPayload.postSurgeryPinchingDefect
              parameter x ≤
            strongDeltaPayload.strongDelta parameter := by
  intro parameter x hx
  have hpinch :
      x ∈ postSurgeryCurvaturePinchingPayload.pinchingRegion parameter :=
    postSurgeryCurvaturePinchingPayload.constructedCapRegion_subset_pinchingRegion
      parameter x hx
  exact
    ⟨hpinch,
      postSurgeryCurvaturePinchingPayload.postSurgeryScalarProfile_eq_constructed
        parameter x hx,
      postSurgeryCurvaturePinchingPayload.postSurgeryScalarCurvatureNonnegative
        parameter x hpinch,
      postSurgeryCurvaturePinchingPayload.postSurgeryPinchingDefect_le_capConstructionError
        parameter x hx,
      postSurgeryCurvaturePinchingPayload.postSurgeryPinchingDefect_le_strongDelta
        parameter x hpinch⟩

/--
Concrete post-surgery noncollapsing data after curvature pinching has been
established.

The payload is tied to explicit post-surgery curvature pinching data. It records
the region and scale range on which noncollapsing is asserted, a positive kappa
lower bound, volume-ratio control, and a defect bounded by the pinching defect
and the strong delta-neck parameter.
-/
structure PostSurgeryNoncollapsingControlPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    (postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload) :
    Type (u + 1) where
  /-- Region on which post-surgery noncollapsing is controlled. -/
  noncollapsingRegion : scalePayload.scaleParameterSpace → Set M
  /-- The pinching-control region lies in the noncollapsing region. -/
  pinchingRegion_subset_noncollapsingRegion :
    ∀ parameter x,
      x ∈ postSurgeryCurvaturePinchingPayload.pinchingRegion parameter →
        x ∈ noncollapsingRegion parameter
  /-- The constructed cap lies in the noncollapsing region. -/
  constructedCapRegion_subset_noncollapsingRegion :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ noncollapsingRegion parameter
  /-- The noncollapsing region stays on the cap or pinching-control locus. -/
  noncollapsingRegion_subset_constructedCap_or_pinching :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        x ∈ capConstructionPayload.constructedCapRegion parameter ∨
          x ∈ postSurgeryCurvaturePinchingPayload.pinchingRegion parameter
  /-- Scale at which noncollapsing is asserted after surgery. -/
  postSurgeryNoncollapsingScale : scalePayload.scaleParameterSpace → ℝ
  /-- The post-surgery noncollapsing scale is positive. -/
  postSurgeryNoncollapsingScalePositive :
    ∀ parameter, 0 < postSurgeryNoncollapsingScale parameter
  /-- The noncollapsing scale is controlled by the constructed cap scale. -/
  postSurgeryNoncollapsingScale_le_constructedCapScale :
    ∀ parameter,
      postSurgeryNoncollapsingScale parameter ≤
        capConstructionPayload.constructedCapScale parameter
  /-- Kappa lower bound for post-surgery noncollapsing. -/
  postSurgeryKappaLowerBound : scalePayload.scaleParameterSpace → ℝ
  /-- The kappa lower bound is positive. -/
  postSurgeryKappaLowerBoundPositive :
    ∀ parameter, 0 < postSurgeryKappaLowerBound parameter
  /-- Real-valued volume-ratio profile used in the noncollapsing statement. -/
  postSurgeryVolumeRatioProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The post-surgery volume ratio is nonnegative on the noncollapsing region. -/
  postSurgeryVolumeRatioNonnegative :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        0 ≤ postSurgeryVolumeRatioProfile parameter x
  /-- Real-valued defect in the post-surgery noncollapsing inequality. -/
  postSurgeryNoncollapsingDefect :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- The post-surgery noncollapsing defect is nonnegative. -/
  postSurgeryNoncollapsingDefectNonnegative :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        0 ≤ postSurgeryNoncollapsingDefect parameter x
  /-- The volume-ratio profile is bounded below by kappa up to defect. -/
  postSurgeryVolumeRatio_ge_kappa :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        postSurgeryKappaLowerBound parameter ≤
          postSurgeryVolumeRatioProfile parameter x +
            postSurgeryNoncollapsingDefect parameter x
  /-- Curvature-radius profile used to delimit the noncollapsing scale range. -/
  postSurgeryCurvatureRadiusProfile :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- Curvature radius is positive on the noncollapsing region. -/
  postSurgeryCurvatureRadiusPositive :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        0 < postSurgeryCurvatureRadiusProfile parameter x
  /-- The noncollapsing scale stays below the curvature radius on the region. -/
  postSurgeryNoncollapsingScale_le_curvatureRadius :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        postSurgeryNoncollapsingScale parameter ≤
          postSurgeryCurvatureRadiusProfile parameter x
  /-- The noncollapsing defect is controlled by the pinching defect. -/
  postSurgeryNoncollapsingDefect_le_pinchingDefect :
    ∀ parameter x,
      x ∈ postSurgeryCurvaturePinchingPayload.pinchingRegion parameter →
        postSurgeryNoncollapsingDefect parameter x ≤
          postSurgeryCurvaturePinchingPayload.postSurgeryPinchingDefect
            parameter x
  /-- The noncollapsing defect is controlled by the detected strong delta. -/
  postSurgeryNoncollapsingDefect_le_strongDelta :
    ∀ parameter x,
      x ∈ noncollapsingRegion parameter →
        postSurgeryNoncollapsingDefect parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Pinching-region points inherit the post-surgery noncollapsing controls. -/
theorem PostSurgeryNoncollapsingControlPayload.pinching_region_noncollapsing_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    (postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload) :
    ∀ parameter x,
      x ∈ postSurgeryCurvaturePinchingPayload.pinchingRegion parameter →
        x ∈ postSurgeryNoncollapsingPayload.noncollapsingRegion parameter ∧
          0 ≤ postSurgeryNoncollapsingPayload.postSurgeryVolumeRatioProfile
            parameter x ∧
          0 ≤ postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect
            parameter x ∧
          postSurgeryNoncollapsingPayload.postSurgeryKappaLowerBound
              parameter ≤
            postSurgeryNoncollapsingPayload.postSurgeryVolumeRatioProfile
                parameter x +
              postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect
                parameter x ∧
          0 <
            postSurgeryNoncollapsingPayload.postSurgeryCurvatureRadiusProfile
              parameter x ∧
          postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingScale
              parameter ≤
            postSurgeryNoncollapsingPayload.postSurgeryCurvatureRadiusProfile
              parameter x ∧
          postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect
              parameter x ≤
            postSurgeryCurvaturePinchingPayload.postSurgeryPinchingDefect
              parameter x ∧
          postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect
              parameter x ≤
            strongDeltaPayload.strongDelta parameter := by
  intro parameter x hx
  have hnoncollapse :
      x ∈ postSurgeryNoncollapsingPayload.noncollapsingRegion parameter :=
    postSurgeryNoncollapsingPayload.pinchingRegion_subset_noncollapsingRegion
      parameter x hx
  exact
    ⟨hnoncollapse,
      postSurgeryNoncollapsingPayload.postSurgeryVolumeRatioNonnegative
        parameter x hnoncollapse,
      postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefectNonnegative
        parameter x hnoncollapse,
      postSurgeryNoncollapsingPayload.postSurgeryVolumeRatio_ge_kappa
        parameter x hnoncollapse,
      postSurgeryNoncollapsingPayload.postSurgeryCurvatureRadiusPositive
        parameter x hnoncollapse,
      postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingScale_le_curvatureRadius
        parameter x hnoncollapse,
      postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect_le_pinchingDefect
        parameter x hx,
      postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect_le_strongDelta
        parameter x hnoncollapse⟩

/--
Concrete post-surgery derivative-bound data after noncollapsing control.

The payload is tied to explicit post-surgery noncollapsing data. It records the
region and scale on which derivative bounds are asserted, real-valued profiles
for each derivative order, scale-adjusted bounds, and a defect controlled by the
noncollapsing defect and strong delta-neck data.
-/
structure PostSurgeryDerivativeBoundsPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    (postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload) :
    Type (u + 1) where
  /-- Region on which post-surgery derivative bounds are controlled. -/
  derivativeControlRegion : scalePayload.scaleParameterSpace → Set M
  /-- The noncollapsing region lies in the derivative-control region. -/
  noncollapsingRegion_subset_derivativeControlRegion :
    ∀ parameter x,
      x ∈ postSurgeryNoncollapsingPayload.noncollapsingRegion parameter →
        x ∈ derivativeControlRegion parameter
  /-- The constructed cap lies in the derivative-control region. -/
  constructedCapRegion_subset_derivativeControlRegion :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ derivativeControlRegion parameter
  /-- The derivative-control region stays on the cap or noncollapsing locus. -/
  derivativeControlRegion_subset_constructedCap_or_noncollapsing :
    ∀ parameter x,
      x ∈ derivativeControlRegion parameter →
        x ∈ capConstructionPayload.constructedCapRegion parameter ∨
          x ∈ postSurgeryNoncollapsingPayload.noncollapsingRegion parameter
  /-- Scale at which post-surgery derivative bounds are asserted. -/
  postSurgeryDerivativeScale : scalePayload.scaleParameterSpace → ℝ
  /-- The post-surgery derivative scale is positive. -/
  postSurgeryDerivativeScalePositive :
    ∀ parameter, 0 < postSurgeryDerivativeScale parameter
  /-- The derivative scale is controlled by the noncollapsing scale. -/
  postSurgeryDerivativeScale_le_noncollapsingScale :
    ∀ parameter,
      postSurgeryDerivativeScale parameter ≤
        postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingScale
          parameter
  /-- Real-valued profile for the norm of each derivative order. -/
  postSurgeryDerivativeNormProfile :
    ℕ → scalePayload.scaleParameterSpace → M → ℝ
  /-- Derivative norm profiles are nonnegative on the control region. -/
  postSurgeryDerivativeNormNonnegative :
    ∀ order parameter x,
      x ∈ derivativeControlRegion parameter →
        0 ≤ postSurgeryDerivativeNormProfile order parameter x
  /-- Bound assigned to each derivative order and scale parameter. -/
  postSurgeryDerivativeBound :
    ℕ → scalePayload.scaleParameterSpace → ℝ
  /-- Derivative bounds are nonnegative. -/
  postSurgeryDerivativeBoundNonnegative :
    ∀ order parameter,
      0 ≤ postSurgeryDerivativeBound order parameter
  /-- Real-valued defect in the post-surgery derivative bounds. -/
  postSurgeryDerivativeDefect :
    ℕ → scalePayload.scaleParameterSpace → M → ℝ
  /-- Derivative-bound defects are nonnegative on the control region. -/
  postSurgeryDerivativeDefectNonnegative :
    ∀ order parameter x,
      x ∈ derivativeControlRegion parameter →
        0 ≤ postSurgeryDerivativeDefect order parameter x
  /-- Each derivative norm is bounded by its assigned bound up to defect. -/
  postSurgeryDerivativeNorm_le_bound_plus_defect :
    ∀ order parameter x,
      x ∈ derivativeControlRegion parameter →
        postSurgeryDerivativeNormProfile order parameter x ≤
          postSurgeryDerivativeBound order parameter +
            postSurgeryDerivativeDefect order parameter x
  /-- The zeroth derivative profile agrees with the post-surgery scalar profile. -/
  zerothDerivativeProfile_eq_scalarProfile :
    ∀ parameter x,
      x ∈ derivativeControlRegion parameter →
        postSurgeryDerivativeNormProfile 0 parameter x =
          postSurgeryCurvaturePinchingPayload.postSurgeryScalarCurvatureProfile
            parameter x
  /-- Derivative defects are controlled by the noncollapsing defect. -/
  postSurgeryDerivativeDefect_le_noncollapsingDefect :
    ∀ order parameter x,
      x ∈ postSurgeryNoncollapsingPayload.noncollapsingRegion parameter →
        postSurgeryDerivativeDefect order parameter x ≤
          postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect
            parameter x
  /-- Derivative defects are controlled by the detected strong delta. -/
  postSurgeryDerivativeDefect_le_strongDelta :
    ∀ order parameter x,
      x ∈ derivativeControlRegion parameter →
        postSurgeryDerivativeDefect order parameter x ≤
          strongDeltaPayload.strongDelta parameter

/-- Noncollapsing-region points inherit post-surgery derivative norm and defect bounds. -/
theorem PostSurgeryDerivativeBoundsPayload.noncollapsing_region_derivative_bundle
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload : SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload : SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload : SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload : SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload : SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload neckCanonicalCoordinatesPayload}
    {standardCapModelPayload : StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    (postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload postSurgeryNoncollapsingPayload) :
    ∀ order parameter x,
      x ∈ postSurgeryNoncollapsingPayload.noncollapsingRegion parameter →
        x ∈ postSurgeryDerivativeBoundsPayload.derivativeControlRegion
            parameter ∧
          0 ≤
            postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeNormProfile
              order parameter x ∧
          0 ≤
            postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect
              order parameter x ∧
          postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeNormProfile
              order parameter x ≤
            postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeBound
                order parameter +
              postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect
                order parameter x ∧
          postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect
              order parameter x ≤
            postSurgeryNoncollapsingPayload.postSurgeryNoncollapsingDefect
              parameter x ∧
          postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect
              order parameter x ≤
            strongDeltaPayload.strongDelta parameter := by
  intro order parameter x hx
  have hderiv :
      x ∈ postSurgeryDerivativeBoundsPayload.derivativeControlRegion parameter :=
    postSurgeryDerivativeBoundsPayload.noncollapsingRegion_subset_derivativeControlRegion
      parameter x hx
  exact
    ⟨hderiv,
      postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeNormNonnegative
        order parameter x hderiv,
      postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefectNonnegative
        order parameter x hderiv,
      postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeNorm_le_bound_plus_defect
        order parameter x hderiv,
      postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect_le_noncollapsingDefect
        order parameter x hx,
      postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeDefect_le_strongDelta
        order parameter x hderiv⟩

/--
Concrete persistence data for canonical-neighborhood control after surgery.

The payload is tied to post-surgery derivative-bound data. It records the
post-surgery region on which canonical neighborhoods persist, the scale and
time-window data used to compare those neighborhoods with the pre-surgery
canonical scale, model assignments on the persisted region, and a real-valued
defect controlled by the derivative-bound defect and the strong delta-neck
parameter.
-/
structure PostSurgeryCanonicalNeighborhoodPersistencePayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    (postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload postSurgeryNoncollapsingPayload) :
    Type (u + 1) where
  /-- Region where canonical-neighborhood control persists after surgery. -/
  persistedCanonicalNeighborhoodRegion :
    scalePayload.scaleParameterSpace → Set M
  /-- The derivative-control region lies in the persisted canonical-neighborhood region. -/
  derivativeControlRegion_subset_persistedCanonicalNeighborhoodRegion :
    ∀ parameter x,
      x ∈ postSurgeryDerivativeBoundsPayload.derivativeControlRegion
          parameter →
        x ∈ persistedCanonicalNeighborhoodRegion parameter
  /-- The constructed cap lies in the persisted canonical-neighborhood region. -/
  constructedCapRegion_subset_persistedCanonicalNeighborhoodRegion :
    ∀ parameter x,
      x ∈ capConstructionPayload.constructedCapRegion parameter →
        x ∈ persistedCanonicalNeighborhoodRegion parameter
  /-- Persisted canonical neighborhoods stay on the derivative-control or cap locus. -/
  persistedCanonicalNeighborhoodRegion_subset_derivativeControl_or_cap :
    ∀ parameter x,
      x ∈ persistedCanonicalNeighborhoodRegion parameter →
        x ∈ postSurgeryDerivativeBoundsPayload.derivativeControlRegion
            parameter ∨
          x ∈ capConstructionPayload.constructedCapRegion parameter
  /-- Canonical-neighborhood persistence scale after surgery. -/
  postSurgeryCanonicalNeighborhoodScale :
    scalePayload.scaleParameterSpace → ℝ
  /-- The post-surgery canonical-neighborhood persistence scale is positive. -/
  postSurgeryCanonicalNeighborhoodScalePositive :
    ∀ parameter, 0 < postSurgeryCanonicalNeighborhoodScale parameter
  /-- Derivative bounds are asserted below the persisted canonical-neighborhood scale. -/
  postSurgeryDerivativeScale_le_canonicalNeighborhoodScale :
    ∀ parameter,
      postSurgeryDerivativeBoundsPayload.postSurgeryDerivativeScale
          parameter ≤
        postSurgeryCanonicalNeighborhoodScale parameter
  /-- The persisted scale remains under the separated canonical-neighborhood scale. -/
  postSurgeryCanonicalNeighborhoodScale_le_separatedScale :
    ∀ parameter,
      postSurgeryCanonicalNeighborhoodScale parameter ≤
        separationPayload.canonicalNeighborhoodScale parameter
  /-- Real-valued time window on which the canonical-neighborhood model persists. -/
  postSurgeryPersistenceTimeWindow :
    scalePayload.scaleParameterSpace → Set ℝ
  /-- Distinguished post-surgery time for the persisted neighborhood data. -/
  postSurgeryBaseTime : scalePayload.scaleParameterSpace → ℝ
  /-- The distinguished post-surgery time belongs to the persistence window. -/
  postSurgeryBaseTime_mem_persistenceWindow :
    ∀ parameter,
      postSurgeryBaseTime parameter ∈
        postSurgeryPersistenceTimeWindow parameter
  /-- Canonical-neighborhood model assigned to each persisted point. -/
  postSurgeryCanonicalNeighborhoodModel :
    scalePayload.scaleParameterSpace → M → Type u
  /-- Persisted-region points carry a canonical-neighborhood model assignment. -/
  postSurgeryCanonicalNeighborhoodModelNonempty :
    ∀ parameter x,
      x ∈ persistedCanonicalNeighborhoodRegion parameter →
        Nonempty (postSurgeryCanonicalNeighborhoodModel parameter x)
  /-- Real-valued defect in the post-surgery canonical-neighborhood comparison. -/
  postSurgeryCanonicalNeighborhoodDefect :
    scalePayload.scaleParameterSpace → M → ℝ
  /-- Canonical-neighborhood defects are nonnegative on the persisted region. -/
  postSurgeryCanonicalNeighborhoodDefectNonnegative :
    ∀ parameter x,
