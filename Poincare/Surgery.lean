/--
Concrete payload for the first-variation formula used by finite extinction.

The payload ties the abstract width-theory witness to its concrete analytic
inputs, records the parameter space on which the first variation is evaluated,
and names a stationary parameter where the first variation vanishes while its
area remains controlled by the width value.
-/
structure FiniteExtinctionFirstVariationFormulaPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  /-- Concrete payload from which the abstract width-theory witness is built. -/
  widthTheoryPayload :
    FiniteExtinctionWidthTheoryPayload flow surgery control
  /-- The first-variation payload is attached to that concrete width theory. -/
  widthTheoryEq :
    widthTheory =
      HasFiniteExtinctionWidthTheory.of_width_theory_payload
        widthTheoryPayload
  /-- Regularity of the evolving metric needed to differentiate areas. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Metric control across surgery times used in the width variation setup. -/
  postSurgeryMetricControl : HasPostSurgeryMetricControl flow
  /-- Canonical-neighborhood input supporting the regular min-max slice. -/
  canonicalNeighborhood : HasCanonicalNeighborhoodTheorem flow
  /-- Parameter space on which the first-variation functional is evaluated. -/
  variationParameterSpace : Type u
  /-- Parameter representing the stationary width-realizing slice. -/
  stationaryParameter : variationParameterSpace
  /-- First-variation functional on the selected parameter space. -/
  firstVariationFunctional : variationParameterSpace → ℝ
  /-- The first variation vanishes at the selected stationary parameter. -/
  stationaryFirstVariationZero :
    firstVariationFunctional stationaryParameter = 0
  /-- Neighborhood witnessing that the stationary parameter lies in the controlled family. -/
  stationarityNeighborhood : Set variationParameterSpace
  /-- The stationary parameter belongs to its control neighborhood. -/
  stationaryMemNeighborhood :
    stationaryParameter ∈ stationarityNeighborhood
  /-- Area value of the stationary slice. -/
  stationaryAreaValue : ℝ
  /-- Width value controlling the stationary slice. -/
  widthValue : ℝ
  /-- The stationary slice area is bounded by the selected width. -/
  stationaryAreaLeWidth : stationaryAreaValue ≤ widthValue

