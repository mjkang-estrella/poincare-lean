        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    {postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload}
    {surgeryTimeDiscretenessPayload :
      SurgeryTimeDiscretenessPayload postSurgeryMetricControlPayload}
    {surgeryTimeLocalFinitenessPayload :
      SurgeryTimeLocalFinitenessPayload
        surgeryTimeDiscretenessPayload}
    {longTimeExistenceIterationPayload :
      LongTimeExistenceIterationPayload
        surgeryTimeLocalFinitenessPayload}
    (longTimeSurgeryParameterCoherencePayload :
      LongTimeSurgeryParameterCoherencePayload
        longTimeExistenceIterationPayload) :
    Type (u + 1) where
  /-- Iteration step chosen to reach beyond a target time. -/
  nonaccumulationStepBound :
    scalePayload.scaleParameterSpace → ℝ → ℕ
  /-- The chosen step reaches at least the requested target time. -/
  targetTime_le_iterationTime_at_stepBound :
    ∀ parameter targetTime,
      targetTime ≤
        longTimeExistenceIterationPayload.iterationTime parameter
          (nonaccumulationStepBound parameter targetTime)
  /-- Finite event-index bound for all surgery events before a target time. -/
  finitePrefixEventBound :
    scalePayload.scaleParameterSpace → ℝ → ℕ
  /-- Events at or before the target have index bounded by the finite prefix. -/
  eventIndex_le_finitePrefixEventBound_of_time_le :
    ∀ parameter targetTime eventIndex,
      surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          targetTime →
        eventIndex ≤ finitePrefixEventBound parameter targetTime
  /-- Events before the target lie before the chosen cofinal iteration time. -/
  eventTime_le_iterationTime_at_stepBound_of_time_le :
    ∀ parameter targetTime eventIndex,
      surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          targetTime →
        surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          longTimeExistenceIterationPayload.iterationTime parameter
            (nonaccumulationStepBound parameter targetTime)
  /-- Spatial region collecting surgery events before a target time. -/
  finitePrefixEventRegion :
    scalePayload.scaleParameterSpace → ℝ → Set M
  /-- Event regions before a target lie in the finite-prefix region. -/
  surgeryTimeEventRegion_subset_finitePrefixEventRegion_of_time_le :
    ∀ parameter targetTime eventIndex x,
      surgeryTimeDiscretenessPayload.surgeryTime parameter eventIndex ≤
          targetTime →
        x ∈ surgeryTimeDiscretenessPayload.surgeryTimeEventRegion
          parameter eventIndex →
          x ∈ finitePrefixEventRegion parameter targetTime
  /-- Finite-prefix event regions remain in the post-surgery metric-control region. -/
  finitePrefixEventRegion_subset_metricControlRegion :
    ∀ parameter targetTime x,
      x ∈ finitePrefixEventRegion parameter targetTime →
        x ∈ postSurgeryMetricControlPayload.metricControlRegion parameter
  /-- Real-valued defect in the finite-prefix nonaccumulation estimate. -/
  nonaccumulationDefect :
    scalePayload.scaleParameterSpace → ℝ → ℝ
  /-- Nonaccumulation defects are nonnegative. -/
  nonaccumulationDefectNonnegative :
    ∀ parameter targetTime, 0 ≤ nonaccumulationDefect parameter targetTime
  /-- Nonaccumulation defects are controlled by parameter-coherence defects. -/
  nonaccumulationDefect_le_parameterCoherenceDefect :
    ∀ parameter targetTime,
      nonaccumulationDefect parameter targetTime ≤
        longTimeSurgeryParameterCoherencePayload.parameterCoherenceDefect
          parameter (nonaccumulationStepBound parameter targetTime)

/--
Concrete continuation data for the long-time surgery construction.

The payload is tied to long-time nonaccumulation data. It records the restart
time and continuation end time for each long-time iteration step, proves the
next iteration time is covered by the extension, and keeps continuation regions
and defects controlled by the finite-prefix nonaccumulation data.
-/
structure LongTimeSurgeryContinuationPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    {postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload}
    {surgeryTimeDiscretenessPayload :
      SurgeryTimeDiscretenessPayload postSurgeryMetricControlPayload}
    {surgeryTimeLocalFinitenessPayload :
      SurgeryTimeLocalFinitenessPayload
        surgeryTimeDiscretenessPayload}
    {longTimeExistenceIterationPayload :
      LongTimeExistenceIterationPayload
        surgeryTimeLocalFinitenessPayload}
    {longTimeSurgeryParameterCoherencePayload :
      LongTimeSurgeryParameterCoherencePayload
        longTimeExistenceIterationPayload}
    (longTimeNonaccumulationPayload :
      LongTimeNonaccumulationPayload
        longTimeSurgeryParameterCoherencePayload) :
    Type (u + 1) where
  /-- Restart time used at each long-time continuation step. -/
  continuationRestartTime :
    scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- The restart time is the corresponding long-time iteration time. -/
  continuationRestartTime_eq_iterationTime :
    ∀ parameter step,
      continuationRestartTime parameter step =
        longTimeExistenceIterationPayload.iterationTime parameter step
  /-- End time reached by the continuation step. -/
  continuationEndTime :
    scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Continuation starts before it ends. -/
  continuationRestartTime_lt_endTime :
    ∀ parameter step,
      continuationRestartTime parameter step <
        continuationEndTime parameter step
  /-- The continuation step reaches the next iteration time. -/
  nextIterationTime_le_continuationEndTime :
    ∀ parameter step,
      longTimeExistenceIterationPayload.iterationTime parameter (step + 1) ≤
        continuationEndTime parameter step
  /-- The chosen continuation end time is controlled by nonaccumulation data. -/
  continuationEndTime_le_nonaccumulationStepTime :
    ∀ parameter step,
      continuationEndTime parameter step ≤
        longTimeExistenceIterationPayload.iterationTime parameter
          (longTimeNonaccumulationPayload.nonaccumulationStepBound
            parameter (continuationEndTime parameter step))
  /-- Region on which the continuation step is controlled. -/
  continuationRegion : scalePayload.scaleParameterSpace → ℕ → Set M
  /-- Iteration-step control regions are contained in continuation regions. -/
  iterationStepControlRegion_subset_continuationRegion :
    ∀ parameter step x,
      x ∈ longTimeExistenceIterationPayload.iterationStepControlRegion
          parameter step →
        x ∈ continuationRegion parameter step
  /-- Finite-prefix event regions up to the continuation end are controlled. -/
  finitePrefixEventRegion_subset_continuationRegion :
    ∀ parameter step x,
      x ∈ longTimeNonaccumulationPayload.finitePrefixEventRegion
          parameter (continuationEndTime parameter step) →
        x ∈ continuationRegion parameter step
  /-- Continuation regions remain in the post-surgery metric-control region. -/
  continuationRegion_subset_metricControlRegion :
    ∀ parameter step x,
      x ∈ continuationRegion parameter step →
        x ∈ postSurgeryMetricControlPayload.metricControlRegion parameter
  /-- Real-valued defect assigned to each continuation step. -/
  continuationDefect :
    scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Continuation defects are nonnegative. -/
  continuationDefectNonnegative :
    ∀ parameter step, 0 ≤ continuationDefect parameter step
  /-- Continuation defects are controlled by finite-prefix nonaccumulation defects. -/
  continuationDefect_le_nonaccumulationDefect :
    ∀ parameter step,
      continuationDefect parameter step ≤
        longTimeNonaccumulationPayload.nonaccumulationDefect
          parameter (continuationEndTime parameter step)

/--
Concrete aggregate Ricci-flow-with-surgery realization data.

The payload is tied to the completed long-time continuation data. It records a
global time window and spatial region for the assembled surgery flow, proves
that every long-time iteration and continuation end time is covered, and keeps
the aggregate scale and defect controlled by the post-surgery metric-control
payload.
-/
structure RicciFlowWithSurgeryPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [ChartedSpace ThreeManifoldModel M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    {flow : RicciFlowData ThreeManifoldModelWithCorners n M}
    {scalePayload : SurgeryScaleFunctionPayload flow}
    {continuityPayload : SurgeryScaleContinuityPayload scalePayload}
    {separationPayload : SurgeryScaleSeparationPayload continuityPayload}
    {cutoffPayload :
      SurgeryCutoffParameterControlPayload separationPayload}
    {smoothBumpPayload : SurgeryCutoffSmoothBumpPayload cutoffPayload}
    {parameterSelectionPayload :
      SurgeryParameterSelectionPayload smoothBumpPayload}
    {strongDeltaPayload :
      SurgeryStrongDeltaNeckDetectionPayload parameterSelectionPayload}
    {neckSeparationPayload :
      SurgeryNeckSeparationPayload strongDeltaPayload}
    {neckParametrizationPayload :
      SurgeryNeckParametrizationPayload neckSeparationPayload}
    {neckCanonicalCoordinatesPayload :
      SurgeryNeckCanonicalCoordinatesPayload
        neckParametrizationPayload}
    {neckDecompositionPayload :
      SurgeryNeckDecompositionPayload
        neckCanonicalCoordinatesPayload}
    {standardCapModelPayload :
      StandardCapModelPayload neckDecompositionPayload}
    {capGluingSmoothnessPayload :
      CapGluingSmoothnessPayload standardCapModelPayload}
    {capMetricInterpolationPayload :
      SurgeryCapMetricInterpolationPayload
        capGluingSmoothnessPayload}
    {capCurvatureEstimatesPayload :
      SurgeryCapCurvatureEstimatesPayload
        capMetricInterpolationPayload}
    {capConstructionPayload :
      SurgeryCapConstructionPayload capCurvatureEstimatesPayload}
    {postSurgeryCurvaturePinchingPayload :
      PostSurgeryCurvaturePinchingPayload capConstructionPayload}
    {postSurgeryNoncollapsingPayload :
      PostSurgeryNoncollapsingControlPayload
        postSurgeryCurvaturePinchingPayload}
    {postSurgeryDerivativeBoundsPayload :
      PostSurgeryDerivativeBoundsPayload
        postSurgeryNoncollapsingPayload}
    {postSurgeryCanonicalNeighborhoodPersistencePayload :
      PostSurgeryCanonicalNeighborhoodPersistencePayload
        postSurgeryDerivativeBoundsPayload}
    {postSurgeryMetricControlPayload :
      PostSurgeryMetricControlPayload
        postSurgeryCanonicalNeighborhoodPersistencePayload}
    {surgeryTimeDiscretenessPayload :
      SurgeryTimeDiscretenessPayload postSurgeryMetricControlPayload}
    {surgeryTimeLocalFinitenessPayload :
      SurgeryTimeLocalFinitenessPayload
        surgeryTimeDiscretenessPayload}
    {longTimeExistenceIterationPayload :
      LongTimeExistenceIterationPayload
        surgeryTimeLocalFinitenessPayload}
    {longTimeSurgeryParameterCoherencePayload :
      LongTimeSurgeryParameterCoherencePayload
        longTimeExistenceIterationPayload}
    {longTimeNonaccumulationPayload :
      LongTimeNonaccumulationPayload
        longTimeSurgeryParameterCoherencePayload}
    (longTimeSurgeryContinuationPayload :
      LongTimeSurgeryContinuationPayload
        longTimeNonaccumulationPayload) :
    Type (u + 1) where
  /-- Time window on which the assembled surgery flow is realized. -/
  surgeryFlowTimeWindow : scalePayload.scaleParameterSpace → Set ℝ
  /-- Every long-time iteration time lies in the aggregate flow window. -/
  iterationTime_mem_surgeryFlowTimeWindow :
    ∀ parameter step,
      longTimeExistenceIterationPayload.iterationTime parameter step ∈
        surgeryFlowTimeWindow parameter
  /-- Every continuation end time lies in the aggregate flow window. -/
  continuationEndTime_mem_surgeryFlowTimeWindow :
    ∀ parameter step,
      longTimeSurgeryContinuationPayload.continuationEndTime parameter step ∈
        surgeryFlowTimeWindow parameter
  /-- Spatial region carrying the assembled surgery flow. -/
  surgeryFlowRegion : scalePayload.scaleParameterSpace → Set M
  /-- Continuation regions are covered by the aggregate surgery-flow region. -/
  continuationRegion_subset_surgeryFlowRegion :
    ∀ parameter step x,
      x ∈ longTimeSurgeryContinuationPayload.continuationRegion
          parameter step →
        x ∈ surgeryFlowRegion parameter
  /-- The aggregate surgery-flow region remains in post-surgery metric control. -/
  surgeryFlowRegion_subset_metricControlRegion :
    ∀ parameter x,
      x ∈ surgeryFlowRegion parameter →
        x ∈ postSurgeryMetricControlPayload.metricControlRegion parameter
  /-- Scale on which the aggregate surgery flow is controlled. -/
  surgeryFlowScale : scalePayload.scaleParameterSpace → ℝ
  /-- The aggregate surgery-flow scale is positive. -/
  surgeryFlowScalePositive : ∀ parameter, 0 < surgeryFlowScale parameter
  /-- Aggregate surgery-flow scale is bounded by post-surgery metric control. -/
  surgeryFlowScale_le_metricControlScale :
    ∀ parameter,
      surgeryFlowScale parameter ≤
        postSurgeryMetricControlPayload.postSurgeryMetricControlScale
          parameter
  /-- Real-valued aggregate defect assigned to each continuation step. -/
  surgeryFlowDefect : scalePayload.scaleParameterSpace → ℕ → ℝ
  /-- Aggregate surgery-flow defects are nonnegative. -/
  surgeryFlowDefectNonnegative :
    ∀ parameter step, 0 ≤ surgeryFlowDefect parameter step
  /-- Continuation defects are absorbed by the aggregate surgery-flow defect. -/
  continuationDefect_le_surgeryFlowDefect :
    ∀ parameter step,
      longTimeSurgeryContinuationPayload.continuationDefect
          parameter step ≤
        surgeryFlowDefect parameter step
  /-- Aggregate surgery-flow defects are controlled by metric distortion. -/
  surgeryFlowDefect_le_metricDistortionBound :
    ∀ parameter step,
      surgeryFlowDefect parameter step ≤
        postSurgeryMetricControlPayload.postSurgeryMetricDistortionBound
          parameter

