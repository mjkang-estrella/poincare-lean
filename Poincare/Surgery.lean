/--
Concrete payload for stationarity of the min-max limit.

The payload records the stationary parameter selected after pull-tight, its
agreement with the pull-tight limit, the corresponding width control, and a
first-variation functional that vanishes at the selected parameter.
-/
structure FiniteExtinctionMinMaxStationarityPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (fundamentalGroup : HasFiniteExtinctionFundamentalGroupInput M)
    (sweepoutPayload :
      FiniteExtinctionSweepoutPayload M fundamentalGroup)
    (areaPayload :
      FiniteExtinctionAreaFunctionalPayload
        flow surgery control fundamentalGroup sweepoutPayload)
    (widthPayload :
      FiniteExtinctionMinMaxWidthPayload
        flow surgery control fundamentalGroup sweepoutPayload areaPayload)
    (compactnessPayload :
      FiniteExtinctionWidthCompactnessPayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload)
    (lowerSemicontinuityPayload :
      FiniteExtinctionWidthLowerSemicontinuityPayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload compactnessPayload)
    (minimizingSequencePayload :
      FiniteExtinctionMinimizingSequencePayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload compactnessPayload
        lowerSemicontinuityPayload)
    (pullTightPayload :
      FiniteExtinctionPullTightPayload
        flow surgery control fundamentalGroup sweepoutPayload
        areaPayload widthPayload compactnessPayload
        lowerSemicontinuityPayload minimizingSequencePayload) :
    Type (u + 1) where
  /-- Parameter representing the stationary min-max limit. -/
  stationaryParameter : sweepoutPayload.parameterSpace
  /-- The stationary parameter is the pull-tight limit. -/
  stationaryMatchesPullTightLimit :
    stationaryParameter = pullTightPayload.tightenedLimit
  /-- The stationary parameter remains in the compactness neighborhood. -/
  stationaryMemCompactnessNeighborhood :
    stationaryParameter ∈ compactnessPayload.compactnessNeighborhood
  /-- Area at the stationary parameter is controlled by the chosen width. -/
  stationaryAreaLeWidth :
    areaPayload.areaFunctional stationaryParameter ≤ widthPayload.widthValue
  /-- Abstract first-variation functional for sweepout parameters. -/
  firstVariationFunctional : sweepoutPayload.parameterSpace → ℝ
  /-- The first variation vanishes at the stationary parameter. -/
  stationaryFirstVariationZero :
    firstVariationFunctional stationaryParameter = 0
  /-- Pull-tight comparison keeps the stationary parameter within width. -/
  pullTightLimitAreaLeWidth :
    areaPayload.areaFunctional pullTightPayload.tightenedLimit ≤
      widthPayload.widthValue

