  curvatureNormalizationDomain : Type u
  /-- Distinguished normalized-curvature index. -/
  baseCurvatureNormalizationIndex : curvatureNormalizationDomain
  /-- Map from normalized-curvature indices to pointed-rescaling indices. -/
  curvatureNormalizationToPointedRescalingIndex :
    curvatureNormalizationDomain →
      pointedRescalingPayload.pointedRescalingDomain
  /-- Curvature scale after the normalization step. -/
