    ∀ index,
      normalizedCurvatureScale index =
        pointedRescalingPayload.pointedRescalingCurvatureScale
          (curvatureNormalizationToPointedRescalingIndex index)
  /-- Kappa scale retained by the normalized kappa solution. -/
