  /-- Scale on which no-local-collapsing is asserted. -/
  noLocalCollapsingScale : ℝ
  /-- The no-local-collapsing scale is positive. -/
  noLocalCollapsingScalePositive :
    0 < noLocalCollapsingScale
  /-- The contradiction setup radii are covered by the no-local-collapsing scale. -/
  collapsedBallRadius_le_noLocalCollapsingScale :
    ∀ setup,
      contradictionSetupPayload.collapsedBallRadius setup ≤
        noLocalCollapsingScale
  /-- Kappa constant used in the final no-local-collapsing statement. -/
  noLocalCollapsingKappa : ℝ
  /-- The final kappa constant is the reduced-volume kappa constant. -/
  noLocalCollapsingKappa_eq_kappaFromReducedVolumeConstant :
    noLocalCollapsingKappa =
      kappaNoncollapsingFromReducedVolumePayload.kappaFromReducedVolumeConstant
  /-- Domain of balls covered by the no-local-collapsing statement. -/
  noLocalCollapsingBallDomain : Type u
  /-- Comparison kappa ball associated to a no-local-collapsing ball. -/
  noLocalCollapsingBallToKappaBall :
    noLocalCollapsingBallDomain →
      kappaNoncollapsingFromReducedVolumePayload.kappaNoncollapsedBallDomain
  /-- Volume ratio assigned to a no-local-collapsing ball. -/
  noLocalCollapsingBallVolumeRatio :
    noLocalCollapsingBallDomain → ℝ
  /-- No-local-collapsing volume ratios agree with kappa comparison ratios. -/
  noLocalCollapsingBallVolumeRatio_eq_ballVolumeRatio :
    ∀ ball,
      noLocalCollapsingBallVolumeRatio ball =
        kappaNoncollapsingFromReducedVolumePayload.ballVolumeRatio
          (noLocalCollapsingBallToKappaBall ball)
  /-- Envelope controlling the no-local-collapsing data. -/
  noLocalCollapsingEnvelope : ℝ
  /-- The no-local-collapsing envelope is nonnegative. -/
  noLocalCollapsingEnvelopeNonnegative :
    0 ≤ noLocalCollapsingEnvelope
  /-- Contradiction-setup control is absorbed by the final envelope. -/
  contradictionSetupEnvelope_le_noLocalCollapsingEnvelope :
    contradictionSetupPayload.contradictionSetupEnvelope ≤
      noLocalCollapsingEnvelope
  /-- The final kappa constant is controlled by the envelope. -/
  noLocalCollapsingKappa_le_envelope :
    noLocalCollapsingKappa ≤ noLocalCollapsingEnvelope
  /-- Covered ball volume ratios are controlled by the envelope. -/
  noLocalCollapsingBallVolumeRatio_le_envelope :
    ∀ ball,
      noLocalCollapsingBallVolumeRatio ball ≤ noLocalCollapsingEnvelope

