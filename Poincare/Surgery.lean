/--
Concrete payload for the scalar-curvature contribution to the finite-extinction
width bound.

The payload keeps the Gauss-Bonnet estimate for the selected min-max slice,
adds the analytic scalar-curvature theory and evolution inputs, and records an
explicit scalar-curvature contribution bounded by the same width value that
controls the selected surface.
-/
structure FiniteExtinctionScalarCurvatureWidthBoundPayload
    {n : ℕ∞ω}
    {M : Type u} [TopologicalSpace M] [T2Space M]
    [ChartedSpace ThreeManifoldModel M] [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M]
    (flow : RicciFlowData ThreeManifoldModelWithCorners n M)
    (surgery : HasRicciFlowWithSurgery n M)
    (control : HasPerelmanSingularityControl (n := n) (M := M) flow)
    (widthTheory : HasFiniteExtinctionWidthTheory flow surgery control) :
    Type (u + 1) where
  /-- Gauss-Bonnet estimate for the same width-realizing slice. -/
  gaussBonnetPayload :
    FiniteExtinctionGaussBonnetEstimatePayload
      flow surgery control widthTheory
  /-- Scalar-curvature contraction formula from ambient curvature data. -/
  scalarCurvatureContraction :
    HasScalarCurvatureContractionFormula
      (curvature_data_of_ricci_flow_data flow)
  /-- Scalar-curvature theory attached to the analytic curvature data. -/
  scalarCurvature :
    HasScalarCurvatureTheory (curvature_data_of_ricci_flow_data flow)
  /-- Scalar-curvature evolution equation along the flow. -/
  scalarCurvatureEvolution :
    HasScalarCurvatureEvolutionEquation flow
  /-- Metric regularity needed to compare scalar curvature and area. -/
  metricRegularity :
    HasTimeDependentMetricRegularity (metric_of_ricci_flow_data flow)
  /-- Parameter space for the selected min-max slices. -/
  surfaceParameterSpace : Type u
  /-- Parameter selecting the slice used in the width bound. -/
  surfaceParameter : surfaceParameterSpace
  /-- Scalar-curvature contribution appearing in the width derivative estimate. -/
  scalarCurvatureContribution : ℝ
  /-- Area value of the selected slice. -/
  surfaceAreaValue : ℝ
  /-- The scalar-curvature contribution is the selected surface-area contribution. -/
  scalarCurvatureContributionEqAreaValue :
    scalarCurvatureContribution = surfaceAreaValue
  /-- Width value controlling the selected slice. -/
  widthValue : ℝ
  /-- The selected surface area is bounded by the width. -/
  surfaceAreaLeWidth : surfaceAreaValue ≤ widthValue
  /-- Therefore the scalar-curvature contribution is bounded by the width. -/
  scalarCurvatureContributionLeWidth :
    scalarCurvatureContribution ≤ widthValue
  /-- The Gauss-Bonnet contribution remains bounded by its stored bound. -/
  gaussBonnetContributionLeBound :
    gaussBonnetPayload.gaussBonnetIntegral ≤
      gaussBonnetPayload.gaussBonnetUpperBound
  /-- Nonnegativity of the Gauss-Bonnet upper bound used in the width estimate. -/
  gaussBonnetUpperBoundNonnegative :
    0 ≤ gaussBonnetPayload.gaussBonnetUpperBound

