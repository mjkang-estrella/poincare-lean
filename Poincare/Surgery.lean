      KappaSolutionCurvatureNormalizationPayload pointedRescalingPayload}
    {structurePayload :
      KappaSolutionStructureTheoryPayload curvatureNormalizationPayload}
    (nonnegativeCurvatureOperatorPayload :
      KappaSolutionNonnegativeCurvatureOperatorPayload structurePayload) :
    Type (u + 1) where
  /-- Model family appearing in the asymptotic soliton analysis. -/
  asymptoticSolitonModelFamily : Type u
  /-- Distinguished asymptotic soliton model. -/
  baseAsymptoticSolitonModel : asymptoticSolitonModelFamily
  /-- Map from soliton models back to curvature-operator tests. -/
  asymptoticSolitonToCurvatureOperatorTest :
    asymptoticSolitonModelFamily →
      nonnegativeCurvatureOperatorPayload.curvatureOperatorTestDomain
  /-- Curvature lower bound retained along the asymptotic soliton extraction. -/
  asymptoticSolitonCurvatureLowerBound :
    asymptoticSolitonModelFamily → ℝ
  /-- The soliton lower bound agrees with the curvature-operator lower bound. -/
  asymptoticSolitonCurvatureLowerBound_eq_curvatureOperatorLowerBound :
    ∀ model,
      asymptoticSolitonCurvatureLowerBound model =
        nonnegativeCurvatureOperatorPayload.curvatureOperatorLowerBound
          (asymptoticSolitonToCurvatureOperatorTest model)
  /-- Kappa scale retained by asymptotic soliton analysis. -/
  asymptoticSolitonKappaScale : ℝ
  /-- The soliton kappa scale agrees with the structure-theory kappa scale. -/
  asymptoticSolitonKappaScale_eq_structureKappaScale :
    asymptoticSolitonKappaScale =
      structurePayload.structureKappaScale
  /-- The retained kappa scale is positive. -/
  asymptoticSolitonKappaScalePositive :
    0 < asymptoticSolitonKappaScale
  /-- Aggregate envelope for asymptotic soliton data. -/
  asymptoticSolitonEnvelope : ℝ
  /-- The asymptotic soliton envelope is nonnegative. -/
  asymptoticSolitonEnvelopeNonnegative :
    0 ≤ asymptoticSolitonEnvelope
  /-- Curvature-operator data are absorbed by the soliton envelope. -/
  curvatureOperatorEnvelope_le_asymptoticSolitonEnvelope :
    nonnegativeCurvatureOperatorPayload.curvatureOperatorEnvelope ≤
      asymptoticSolitonEnvelope
  /-- Defect term for the asymptotic soliton extraction. -/
  asymptoticSolitonDefect : asymptoticSolitonModelFamily → ℝ
  /-- Asymptotic soliton defects are nonnegative. -/
  asymptoticSolitonDefectNonnegative :
    ∀ model, 0 ≤ asymptoticSolitonDefect model
  /-- Asymptotic soliton defects are controlled by the stored envelope. -/
  asymptoticSolitonDefect_le_envelope :
    ∀ model, asymptoticSolitonDefect model ≤ asymptoticSolitonEnvelope

