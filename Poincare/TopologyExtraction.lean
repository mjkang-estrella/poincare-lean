/--
Identity restrictions on an already `C^n` manifold target are local
structomorphisms. This is the reusable compatibility input for smooth atlas
transport along local inverse charts.
-/
theorem idRestr_liftPropOn_localStructomorph_of_isManifold
    {𝕜 : Type w} [NontriviallyNormedField 𝕜]
    {E : Type w'} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    {H : Type v} [TopologicalSpace H]
    {I : ModelWithCorners 𝕜 E H} {n : ℕ∞ω}
    {N : Type u} [TopologicalSpace N]
    [ChartedSpace H N] [IsManifold I n N]
    (f : OpenPartialHomeomorph N N)
    (hf : f ∈ @idRestrGroupoid N _) :
    ChartedSpace.LiftPropOn
      (StructureGroupoid.IsLocalStructomorphWithinAt
        (contDiffGroupoid n I))
      (f : N → N) f.source := by
  let G := contDiffGroupoid n I
  let hG := StructureGroupoid.isLocalStructomorphWithinAt_localInvariantProp G
  have hId :
      ∀ y : H, StructureGroupoid.IsLocalStructomorphWithinAt G id Set.univ y := by
    intro y hy
    refine ⟨OpenPartialHomeomorph.refl H, G.id_mem, ?_, by simp⟩
    intro z hz
    rfl
  have hmono :
      ∀ ⦃s : Set H⦄ ⦃x : H⦄ ⦃t : Set H⦄ ⦃g : H → H⦄,
        t ⊆ s →
          StructureGroupoid.IsLocalStructomorphWithinAt G g s x →
            StructureGroupoid.IsLocalStructomorphWithinAt G g t x := by
    intro s x t g hts hg hx
    rcases hg (hts hx) with ⟨e, he, heg, hxe⟩
    exact ⟨e, he, heg.mono (Set.inter_subset_inter_left _ hts), hxe⟩
  have hid :
      ChartedSpace.LiftPropOn
        (StructureGroupoid.IsLocalStructomorphWithinAt G)
        (id : N → N) f.source :=
    StructureGroupoid.LocalInvariantProp.liftPropOn_of_liftProp hmono
      (hG.liftProp_id hId)
  have hfid : ∀ y ∈ f.source, f y = id y := by
    rcases hf with ⟨s, _hs, hfs⟩
    intro y hy
    exact hfs.eqOn hy
  exact hG.liftPropOn_congr hid hfid

/--
The target-valued local inverse charts induced by a homeomorphism have identity
restrictions as transition maps on the target. This is the groupoid statement
behind smooth transport for `IsLocalHomeomorph.chartedSpace`.
-/
theorem homeomorph_localInverse_hasGroupoid
    {M : Type u} {N : Type v} [TopologicalSpace M] [TopologicalSpace N]
    (e : M ≃ₜ N) :
    letI : ChartedSpace N M := by
      letI : ChartedSpace N N := chartedSpaceSelf N
      exact e.symm.isLocalHomeomorph.chartedSpace e.symm.surjective
    HasGroupoid M (@idRestrGroupoid N _) := by
  letI : ChartedSpace N N := chartedSpaceSelf N
  letI : ChartedSpace N M := e.symm.isLocalHomeomorph.chartedSpace e.symm.surjective
  refine ⟨?_⟩
  intro f g hf hg
  change f ∈
      {x | ∃ p : M,
        (e.symm.isLocalHomeomorph.localInverseAt
          (e.symm.surjective.hasRightInverse.choose p)).trans
          (OpenPartialHomeomorph.refl N) = x} at hf
  change g ∈
      {x | ∃ p : M,
        (e.symm.isLocalHomeomorph.localInverseAt
          (e.symm.surjective.hasRightInverse.choose p)).trans
          (OpenPartialHomeomorph.refl N) = x} at hg
  rcases hf with ⟨p, rfl⟩
  rcases hg with ⟨r, rfl⟩
  simp only [OpenPartialHomeomorph.trans_refl]
  let lp := e.symm.isLocalHomeomorph.localInverseAt
    (e.symm.surjective.hasRightInverse.choose p)
  let lr := e.symm.isLocalHomeomorph.localInverseAt
    (e.symm.surjective.hasRightInverse.choose r)
  change lp.symm.trans lr ∈ @idRestrGroupoid N _
  refine ⟨(lp.symm.trans lr).source, (lp.symm.trans lr).open_source, ?_⟩
  constructor
  · rfl
  · intro x hx
    simp only [OpenPartialHomeomorph.ofSet_apply]
    change (lr ∘ lp.symm) x = x
    simp only [OpenPartialHomeomorph.trans_source, Set.mem_inter_iff,
      Set.mem_preimage] at hx
    rcases hx with ⟨_hxlptarget, hxlrsrc⟩
    apply e.symm.injective
    calc
      e.symm ((lr ∘ lp.symm) x) = lp.symm x := by
        simp [Function.comp_apply, lr,
          e.symm.isLocalHomeomorph.apply_localInverseAt_of_mem
            (x := e.symm.surjective.hasRightInverse.choose r) hxlrsrc]
      _ = e.symm x := by
        dsimp [lp]
        exact congrFun (e.symm.isLocalHomeomorph.localInverseAt_symm
          (e.symm.surjective.hasRightInverse.choose p)) x

/--
A homeomorphism to a manifold transports the `C^n` manifold structure to the
source for the actual local-inverse charted space generated by
`IsLocalHomeomorph.chartedSpace`.
-/
theorem isManifold_of_homeomorph_transportedChartedSpace
    {𝕜 : Type w} [NontriviallyNormedField 𝕜]
    {E : Type w'} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    {H : Type v} [TopologicalSpace H]
    {I : ModelWithCorners 𝕜 E H} {n : ℕ∞ω}
    {M : Type u} {N : Type z} [TopologicalSpace M] [TopologicalSpace N]
    [ChartedSpace H N] [IsManifold I n N]
    (e : M ≃ₜ N) :
    letI : ChartedSpace H M :=
      e.symm.isLocalHomeomorph.chartedSpace e.symm.surjective
    IsManifold I n M := by
  letI : ChartedSpace H M :=
    e.symm.isLocalHomeomorph.chartedSpace e.symm.surjective
  let targetCharted : ChartedSpace N M := by
    letI : ChartedSpace N N := chartedSpaceSelf N
    exact e.symm.isLocalHomeomorph.chartedSpace e.symm.surjective
  have htarget : @HasGroupoid N _ M _ targetCharted (@idRestrGroupoid N _) := by
    exact homeomorph_localInverse_hasGroupoid e
  have hcomp :
      @HasGroupoid H _ M _
        (by
          letI : ChartedSpace N M := targetCharted
          exact ChartedSpace.comp H N M)
        (contDiffGroupoid n I) := by
    letI : ChartedSpace N M := targetCharted
    haveI : @HasGroupoid N _ M _ targetCharted (@idRestrGroupoid N _) := htarget
    apply StructureGroupoid.HasGroupoid.comp
      (G₂ := (@idRestrGroupoid N _))
    intro f hf
    exact idRestr_liftPropOn_localStructomorph_of_isManifold f hf
  haveI : HasGroupoid M (contDiffGroupoid n I) := by
    refine ⟨?_⟩
    intro f g hf hg
    have hfcomp : f ∈ @atlas H _ M _
        (by
          letI : ChartedSpace N M := targetCharted
          exact ChartedSpace.comp H N M) := by
      change f ∈
          {x | ∃ p : M,
            (e.symm.isLocalHomeomorph.localInverseAt
              (e.symm.surjective.hasRightInverse.choose p)).trans
              (chartAt H (e.symm.surjective.hasRightInverse.choose p)) = x} at hf
      rcases hf with ⟨p, rfl⟩
      refine ⟨(e.symm.isLocalHomeomorph.localInverseAt
            (e.symm.surjective.hasRightInverse.choose p)).trans
          (OpenPartialHomeomorph.refl N), ?_,
        chartAt H (e.symm.surjective.hasRightInverse.choose p),
        chart_mem_atlas _ _, ?_⟩
      · change (e.symm.isLocalHomeomorph.localInverseAt
              (e.symm.surjective.hasRightInverse.choose p)).trans
            (OpenPartialHomeomorph.refl N) ∈
          {x | ∃ p : M,
            (e.symm.isLocalHomeomorph.localInverseAt
              (e.symm.surjective.hasRightInverse.choose p)).trans
              (OpenPartialHomeomorph.refl N) = x}
        exact ⟨p, rfl⟩
      · simp only [OpenPartialHomeomorph.trans_refl]
    have hgcomp : g ∈ @atlas H _ M _
        (by
          letI : ChartedSpace N M := targetCharted
          exact ChartedSpace.comp H N M) := by
      change g ∈
          {x | ∃ p : M,
            (e.symm.isLocalHomeomorph.localInverseAt
              (e.symm.surjective.hasRightInverse.choose p)).trans
              (chartAt H (e.symm.surjective.hasRightInverse.choose p)) = x} at hg
      rcases hg with ⟨p, rfl⟩
      refine ⟨(e.symm.isLocalHomeomorph.localInverseAt
            (e.symm.surjective.hasRightInverse.choose p)).trans
          (OpenPartialHomeomorph.refl N), ?_,
        chartAt H (e.symm.surjective.hasRightInverse.choose p),
        chart_mem_atlas _ _, ?_⟩
      · change (e.symm.isLocalHomeomorph.localInverseAt
              (e.symm.surjective.hasRightInverse.choose p)).trans
            (OpenPartialHomeomorph.refl N) ∈
          {x | ∃ p : M,
            (e.symm.isLocalHomeomorph.localInverseAt
              (e.symm.surjective.hasRightInverse.choose p)).trans
              (OpenPartialHomeomorph.refl N) = x}
        exact ⟨p, rfl⟩
      · simp only [OpenPartialHomeomorph.trans_refl]
    exact @HasGroupoid.compatible H _ M _
      (by
        letI : ChartedSpace N M := targetCharted
        exact ChartedSpace.comp H N M)
      (contDiffGroupoid n I) hcomp f g hfcomp hgcomp
  exact IsManifold.mk' I n M

