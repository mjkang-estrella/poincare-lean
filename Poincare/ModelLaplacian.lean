    2 * ((coordScalar G x) ^ 2 / (Module.finrank ℝ E : ℝ)) ≤ 2 * coordRicciNormSq G x hdiff := by
  have h := ricciNormSq_ge_scalar_sq_div hGC2 hGsymm hinv hdiff hGpos hn
  linarith

