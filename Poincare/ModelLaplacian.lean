(roadmap item 3). -/
theorem coordRicciEndo_ricci_flat_eigenvalue_zero
    {G : E → E →L[ℝ] E →L[ℝ] ℝ} {x : E}
    (hflat : ∀ p q : E, coordRicci G x p q = 0) :
    coordScalar G x / (Module.finrank ℝ E : ℝ) = 0 := by
  rw [coordScalar_eq_zero_of_ricci_flat hflat, zero_div]

