open CovariantDerivative

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]

/-- **Strict refined Bochner for non-Obata Hessians**: if `∇²f♯ ≠ (Δf/n)·id` at `x`, then
`(Δf)² < n·|∇²f|²` strictly. The gap is the strictly positive trace-free Hessian norm `tr(∇²f̊²) > 0`
(`trace_comp_self_pos`, since `∇²f̊♯ = ∇²f♯ − (Δf/n)id ≠ 0`), giving the strict inequality. So
`(Δf)² ≤ n|∇²f|²` is an equality exactly at Obata Hessians `∇²f = (Δf/n)·g` — the strict form of the refined
Bochner Cauchy–Schwarz, mirroring `coordScalar_sq_lt_finrank_mul_ricciNormSq_of_not_einstein` (roadmap item 3). -/
theorem curvedLaplacian_sq_lt_finrank_mul_coordCovariantHessNormSq_of_not_obata
    (G : E → E →L[ℝ] E →L[ℝ] ℝ) {x : E} (hGd : Differentiable ℝ G)
    (hGsymm : ∀ (y : E) (p q : E), G y p q = G y q p) (hinv : ∀ y : E, (G y).IsInvertible)
    {f : E → ℝ} (hf : ContDiff ℝ 2 f) (hGpos : ∀ v : E, v ≠ 0 → 0 < G x v v)
    (hn : 0 < (Module.finrank ℝ E : ℝ))
    (hne : covariantGradientEndo G f x
      ≠ (curvedLaplacian G (fun y ↦ metricBilin (G y))
          (fun y ↦ metricBilin_nondeg (hGsymm y) (hinv y)) f x
        / (Module.finrank ℝ E : ℝ)) • LinearMap.id) :
    (curvedLaplacian G (fun y ↦ metricBilin (G y))
          (fun y ↦ metricBilin_nondeg (hGsymm y) (hinv y)) f x) ^ 2
      < (Module.finrank ℝ E : ℝ) * coordCovariantHessNormSq G f x := by
  have hgap := coordCovariantHessNormSq_sub_curvedLaplacian_sq_div_eq_traceless_trace (x := x) G hGd
    hGsymm hinv hf (ne_of_gt hn)
  set X : E →ₗ[ℝ] E :=
    covariantGradientEndo G f x
      - (curvedLaplacian G (fun y ↦ metricBilin (G y))
          (fun y ↦ metricBilin_nondeg (hGsymm y) (hinv y)) f x
        / (Module.finrank ℝ E : ℝ)) • LinearMap.id with hX
  have hXne : X ≠ 0 := sub_ne_zero.mpr hne
  set bx : LinearMap.BilinForm ℝ E :=
    LinearMap.mk₂ ℝ (fun v w ↦ G x v w)
      (fun a b c ↦ by simp) (fun c a b ↦ by simp)
      (fun a b c ↦ by simp) (fun c a b ↦ by simp) with hbx
  have hbs : LinearMap.IsSymm bx := by
    rw [LinearMap.isSymm_def]; intro p q
    simp only [hbx, LinearMap.mk₂_apply, RingHom.id_apply]; exact hGsymm x p q
  have hbpos : ∀ v : E, v ≠ 0 → 0 < bx v v := by
    intro v hv; simp only [hbx, LinearMap.mk₂_apply]; exact hGpos v hv
  have hsa : ∀ p q : E, bx (X p) q = bx p (X q) := by
    intro p q
    simp only [hbx, LinearMap.mk₂_apply, hX, LinearMap.sub_apply, LinearMap.smul_apply,
      LinearMap.id_apply, map_sub, map_smul, smul_eq_mul]
    rw [covariantGradientEndo_selfAdjoint (x := x) G hGd hGsymm hinv hf p q]
  have hpos : 0 < LinearMap.trace ℝ E (X ∘ₗ X) := trace_comp_self_pos bx hbs hbpos X hsa hn hXne
  have h1 : (curvedLaplacian G (fun y ↦ metricBilin (G y))
        (fun y ↦ metricBilin_nondeg (hGsymm y) (hinv y)) f x) ^ 2 / (Module.finrank ℝ E : ℝ)
      < coordCovariantHessNormSq G f x := by
    have h2 := hpos; rw [← hgap] at h2; linarith
  rw [mul_comm]
  exact (div_lt_iff₀ hn).mp h1

end RicciFlow

