    (hn : 0 < (Module.finrank ℝ E : ℝ)) :
    0 < coordRicciNormSq G x hdiff ↔ coordScalar G x ≠ 0 := by
  rw [coordRicciNormSq_einstein_eq_scalar_sq_div hGsymm hinv hdiff hEin hn.ne']
