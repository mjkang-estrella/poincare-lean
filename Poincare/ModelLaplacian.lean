                ((Module.finBasis ℝ E).coord j)))
              ((G x).inverse (LinearMap.toContinuousLinearMap
                ((Module.finBasis ℝ E).coord i)))
          + covTensor2Deriv G H x ((Module.finBasis ℝ E) j)
              (christoffelClosedOp G x ((Module.finBasis ℝ E) i)
                ((G x).inverse (LinearMap.toContinuousLinearMap
                  ((Module.finBasis ℝ E).coord j))))
              ((G x).inverse (LinearMap.toContinuousLinearMap
                ((Module.finBasis ℝ E).coord i)))
          + covTensor2Deriv G H x ((Module.finBasis ℝ E) j)
              ((G x).inverse (LinearMap.toContinuousLinearMap
                ((Module.finBasis ℝ E).coord j)))
