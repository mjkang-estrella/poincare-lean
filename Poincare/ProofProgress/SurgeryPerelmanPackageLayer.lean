    ⟨_n, _package, _combinedPayload, _flow, _flow_eq,
      _constructionPackage, _perelmanPackage, _scalePayload,
      _blowupClassification, _finiteExtinctionStatement,
      finiteExtinction⟩
  exact finiteExtinction

