    [SimplyConnectedSpace M] [CompactSpace M]
    [IsManifold ThreeManifoldModelWithCorners 1 M] :
    FiniteExtinctionByRicciFlowWithSurgery M := by
  rcases
    surgeryPerelman_fixedTarget_combinedPayload_of_completeConsumerPayload
