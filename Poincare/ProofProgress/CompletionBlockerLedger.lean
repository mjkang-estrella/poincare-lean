theorem completion_frontier_topology_homeomorphism_derivation_after_homeomorphism_assembly_current_interface
    (recognitionPrefix :
      ExtinctionTopologySimplyConnectedExtinctionRecognitionPrefixPackage.{uT})
    (M : Type uT) [TopologicalSpace M] [T2Space M]
