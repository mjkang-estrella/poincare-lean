import Poincare.TopologyExtraction

open scoped Manifold ContDiff

namespace Poincare

universe u

/--
After a fixed finite-extinction witness has been assigned a production
topology decomposition, the next field needed by
`ExtinctionTopologyExtractionPackage` is reconstruction of the topological
surgery trace encoded by that decomposition.
-/
def ExtinctionSurgeryTraceReconstructionAfterDecompositionStatement : Prop :=
  ∀ (M : Type u) [TopologicalSpace M] [T2Space M]
    [ChartedSpace (EuclideanSpace ℝ (Fin 3)) M]
    [SimplyConnectedSpace M] [CompactSpace M]
    (extinction : FiniteExtinctionByRicciFlowWithSurgery M)
    (decomposition : HasExtinctionTopologyDecomposition M extinction),
      HasExtinctionSurgeryTraceReconstruction M extinction decomposition

/--
Named production input for reconstructing the surgery trace after a fixed
decomposition: each such decomposition carries explicit certified finite
surgery-trace data.
-/
def ExtinctionSurgeryTraceReconstructionDataAfterDecompositionStatement :
    Prop :=
  ∀ (M : Type u) [TopologicalSpace M] [T2Space M]
    [ChartedSpace (EuclideanSpace ℝ (Fin 3)) M]
    [SimplyConnectedSpace M] [CompactSpace M]
    (extinction : FiniteExtinctionByRicciFlowWithSurgery M)
    (decomposition : HasExtinctionTopologyDecomposition M extinction),
      Nonempty (ExtinctionSurgeryTraceReconstructionData
        M extinction decomposition)

/--
Certified finite surgery-trace data now constructs the second topology-package
field for the fixed extinction decomposition.
-/
theorem extinction_surgery_trace_reconstruction_of_data_current_interface
    (M : Type u) [TopologicalSpace M] [T2Space M]
    [ChartedSpace (EuclideanSpace ℝ (Fin 3)) M]
    [SimplyConnectedSpace M] [CompactSpace M]
    (extinction : FiniteExtinctionByRicciFlowWithSurgery M)
    (decomposition : HasExtinctionTopologyDecomposition M extinction)
    (traceData :
      ExtinctionSurgeryTraceReconstructionData
        M extinction decomposition) :
    HasExtinctionSurgeryTraceReconstruction M extinction decomposition :=
  HasExtinctionSurgeryTraceReconstruction.ofData traceData

/--
The trace-data statement supplies exactly the package-level surgery-trace
reconstruction witness family after decomposition.
-/
theorem extinctionSurgeryTraceReconstructionAfterDecompositionStatement_of_data_current_interface
    (traceData :
      ExtinctionSurgeryTraceReconstructionDataAfterDecompositionStatement.{u}) :
    ExtinctionSurgeryTraceReconstructionAfterDecompositionStatement.{u} := by
  intro M _top _t2 _charted _simple _compact extinction decomposition
  rcases traceData M extinction decomposition with ⟨data⟩
  exact extinction_surgery_trace_reconstruction_of_data_current_interface
    M extinction decomposition data

/--
The first two production topology fields needed by
`ExtinctionTopologyExtractionPackage`: a decomposition for each finite
extinction witness and reconstruction of the topological surgery trace encoded
by that same decomposition.
-/
structure ExtinctionTopologySurgeryTracePrefixPackage where
  /-- Topological decomposition obtained from each finite-extinction proof. -/
  decomposition :
    ∀ (M : Type u) [TopologicalSpace M] [T2Space M]
      [ChartedSpace (EuclideanSpace ℝ (Fin 3)) M]
      [SimplyConnectedSpace M] [CompactSpace M]
      (extinction : FiniteExtinctionByRicciFlowWithSurgery M),
        HasExtinctionTopologyDecomposition M extinction
  /-- Reconstruction of the surgery trace represented by the decomposition. -/
  surgeryTraceReconstruction :
    ∀ (M : Type u) [TopologicalSpace M] [T2Space M]
      [ChartedSpace (EuclideanSpace ℝ (Fin 3)) M]
      [SimplyConnectedSpace M] [CompactSpace M]
      (extinction : FiniteExtinctionByRicciFlowWithSurgery M),
        HasExtinctionSurgeryTraceReconstruction M extinction
          (decomposition M extinction)

/--
A decomposition witness plus explicit after-decomposition trace data forms the
first two fields of the production topology package.
-/
noncomputable def extinctionTopologySurgeryTracePrefixPackage_of_decomposition_and_trace_data
    (decompositionWitness :
      ∀ (M : Type u) [TopologicalSpace M] [T2Space M]
        [ChartedSpace (EuclideanSpace ℝ (Fin 3)) M]
        [SimplyConnectedSpace M] [CompactSpace M]
        (extinction : FiniteExtinctionByRicciFlowWithSurgery M),
          HasExtinctionTopologyDecomposition M extinction)
    (traceData :
      ExtinctionSurgeryTraceReconstructionDataAfterDecompositionStatement.{u}) :
    ExtinctionTopologySurgeryTracePrefixPackage.{u} where
  decomposition := decompositionWitness
  surgeryTraceReconstruction := by
    intro M _top _t2 _charted _simple _compact extinction
    rcases traceData M extinction (decompositionWitness M extinction) with
      ⟨data⟩
    exact extinction_surgery_trace_reconstruction_of_data_current_interface
      M extinction (decompositionWitness M extinction)
      data

