      dsimp [A, B]
      have hk := k.isLt
      omega⟩
    have hjle : start.val ≤ j.val := by
      dsimp [j, A]
      omega
    have hjlt : j.val < stop.val := by
      dsimp [j, A, B]
      have hk := k.isLt
