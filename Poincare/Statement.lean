/--
An arbitrary north path followed by south, north, south, and north blocks is
null-homotopic.  This packages one induction step plus the three-block collapse,
and is the reusable odd-length shortening move for longer north-starting words.
-/
theorem threeSphere_stereographic_northSouthBlockNorthSouthBlockNorth_trans_cast_nullhomotopic
    {M K T : ℕ} {x₀ x₃ : ThreeSphere}
    (m : Fin (M + 1) → ThreeSphere)
    (p : Path x₀ (m 0))
    (F : (k : Fin M) → Path (m k.castSucc) (m k.succ))
    (r : Path (m (Fin.last M)) x₃)
    (s : Fin (K + 1) → ThreeSphere)
    (J : (k : Fin K) → Path (s k.castSucc) (s k.succ))
    (u : Fin (T + 1) → ThreeSphere)
    (W : (k : Fin T) → Path (u k.castSucc) (u k.succ))
    (hjoinRS : s 0 = x₃)
    (hjoinSU : u 0 = s (Fin.last K))
    (hclose : u (Fin.last T) = x₀)
    (hp : Set.range p ⊆ (stereographic' 3 threeSphere_northPole).source)
    (hmBase : m 0 ∈ (stereographic' 3 (-threeSphere_northPole)).source)
    (hF : ∀ k : Fin M,
      Set.range (F k) ⊆ (stereographic' 3 (-threeSphere_northPole)).source)
    (hr : Set.range r ⊆ (stereographic' 3 threeSphere_northPole).source)
    (hsBase : s 0 ∈ (stereographic' 3 (-threeSphere_northPole)).source)
    (hJ : ∀ k : Fin K,
      Set.range (J k) ⊆ (stereographic' 3 (-threeSphere_northPole)).source)
    (huBase : u 0 ∈ (stereographic' 3 threeSphere_northPole).source)
    (hW : ∀ k : Fin T,
      Set.range (W k) ⊆ (stereographic' 3 threeSphere_northPole).source) :
    Path.Homotopic
      ((((p.trans (Path.concat m F)).trans r).trans
        ((Path.concat s J).cast hjoinRS.symm rfl)).trans
        ((Path.concat u W).cast hjoinSU.symm rfl))
      ((Path.refl x₀).cast rfl hclose) := by
  let D : Path x₃ (s (Fin.last K)) := (Path.concat s J).cast hjoinRS.symm rfl
  let E : Path (s (Fin.last K)) (u (Fin.last T)) :=
    (Path.concat u W).cast hjoinSU.symm rfl
  have hDRange :
      Set.range D ⊆ (stereographic' 3 (-threeSphere_northPole)).source := by
    have hconcat :
        Set.range (Path.concat s J) ⊆
          (stereographic' 3 (-threeSphere_northPole)).source :=
      threeSphere_stereographic_source_concat_range_subset (-threeSphere_northPole)
        s J hsBase hJ
    intro y hy
    rcases hy with ⟨a, rfl⟩
    exact hconcat ⟨a, by simp [D, Path.cast_coe]⟩
  have hERange :
      Set.range E ⊆ (stereographic' 3 threeSphere_northPole).source := by
    have hconcat :
        Set.range (Path.concat u W) ⊆
          (stereographic' 3 threeSphere_northPole).source :=
      threeSphere_stereographic_source_concat_range_subset threeSphere_northPole
        u W huBase hW
    intro y hy
    rcases hy with ⟨a, rfl⟩
    exact hconcat ⟨a, by simp [E, Path.cast_coe]⟩
  let L : Path x₀ x₃ := (p.trans (Path.concat m F)).trans r
  change Path.Homotopic ((L.trans D).trans E) ((Path.refl x₀).cast rfl hclose)
  refine (Path.Homotopic.trans_assoc L D E).trans ?_
  dsimp [L]
  refine threeSphere_stereographic_northSouthBlockNorth_induction_step
    m p F r (D.trans E) hclose hp hmBase hF hr ?_
  intro q hq
  have hqCastRange :
      Set.range (q.cast rfl hjoinRS) ⊆
        (stereographic' 3 threeSphere_northPole).source := by
    intro y hy
    rcases hy with ⟨a, rfl⟩
    exact hq ⟨a, by simp [Path.cast_coe]⟩
  have hthree :
      Path.Homotopic
        (((q.cast rfl hjoinRS).trans (Path.concat s J)).trans E)
        ((Path.refl x₀).cast rfl hclose) :=
    threeSphere_stereographic_northSouthBlockNorth_concat_cast_nullhomotopic
      s (q.cast rfl hjoinRS) J E hclose hqCastRange hsBase hJ hERange
  have hshift :
      q.trans D = (q.cast rfl hjoinRS).trans (Path.concat s J) := by
    dsimp [D]
    exact path_trans_source_cast_eq_target_cast_trans q (Path.concat s J) hjoinRS
  refine (Path.Homotopic.trans_assoc q D E).symm.trans ?_
  rw [hshift]
  exact hthree

/--
An arbitrary north-source path followed by finite south, north, south, and north
tail blocks is null-homotopic.  This is the flat-tail form of the first
three-switch after-stop branch.
-/
theorem threeSphere_stereographic_northSouthBlockNorthBlockSouthBlockNorthBlockTail_concat_cast_nullhomotopic
    {L R A B : ℕ} {x₀ : ThreeSphere}
    (tailPts : Fin (L + R + A + B + 1) → ThreeSphere)
    (tailSegs : (k : Fin (L + R + A + B)) →
      Path (tailPts k.castSucc) (tailPts k.succ))
    (p : Path x₀ (tailPts 0))
    (hclose : tailPts (Fin.last (L + R + A + B)) = x₀)
    (hp : Set.range p ⊆ (stereographic' 3 threeSphere_northPole).source)
    (hSouthBase : tailPts 0 ∈ (stereographic' 3 (-threeSphere_northPole)).source)
    (hSouth : ∀ k : Fin L,
      Set.range (tailSegs ⟨k.val, by omega⟩) ⊆
        (stereographic' 3 (-threeSphere_northPole)).source)
    (hNorthBase : tailPts ⟨L, by omega⟩ ∈
        (stereographic' 3 threeSphere_northPole).source)
    (hNorth : ∀ k : Fin R,
      Set.range (tailSegs ⟨L + k.val, by omega⟩) ⊆
        (stereographic' 3 threeSphere_northPole).source)
    (hSouthLastBase : tailPts ⟨L + R, by omega⟩ ∈
        (stereographic' 3 (-threeSphere_northPole)).source)
    (hSouthLast : ∀ k : Fin A,
      Set.range (tailSegs ⟨L + R + k.val, by omega⟩) ⊆
        (stereographic' 3 (-threeSphere_northPole)).source)
    (hNorthLastBase : tailPts ⟨L + R + A, by omega⟩ ∈
        (stereographic' 3 threeSphere_northPole).source)
    (hNorthLast : ∀ k : Fin B,
      Set.range (tailSegs ⟨L + R + A + k.val, by omega⟩) ⊆
        (stereographic' 3 threeSphere_northPole).source) :
    Path.Homotopic (p.trans (Path.concat tailPts tailSegs))
      ((Path.refl x₀).cast rfl hclose) := by
  let prefix₁Pts : Fin (L + R + A + 1) → ThreeSphere := fun i =>
    tailPts ⟨i.val, by omega⟩
  let prefix₁Segs : (k : Fin (L + R + A)) →
      Path (prefix₁Pts k.castSucc) (prefix₁Pts k.succ) :=
    fun k => tailSegs ⟨k.val, by omega⟩
  let prefix₂Pts : Fin (L + R + 1) → ThreeSphere := fun i =>
    prefix₁Pts ⟨i.val, by omega⟩
  let prefix₂Segs : (k : Fin (L + R)) →
      Path (prefix₂Pts k.castSucc) (prefix₂Pts k.succ) :=
    fun k => prefix₁Segs ⟨k.val, by omega⟩
  let southPts : Fin (L + 1) → ThreeSphere := fun i =>
    prefix₂Pts ⟨i.val, by omega⟩
  let southSegs : (k : Fin L) → Path (southPts k.castSucc) (southPts k.succ) :=
    fun k => prefix₂Segs ⟨k.val, by omega⟩
  let northPts : Fin (R + 1) → ThreeSphere := fun i =>
    prefix₂Pts ⟨L + i.val, by omega⟩
  let northSegs : (k : Fin R) → Path (northPts k.castSucc) (northPts k.succ) :=
    fun k => prefix₂Segs ⟨L + k.val, by omega⟩
  let southLastPts : Fin (A + 1) → ThreeSphere := fun i =>
    prefix₁Pts ⟨L + R + i.val, by omega⟩
  let southLastSegs : (k : Fin A) →
      Path (southLastPts k.castSucc) (southLastPts k.succ) :=
    fun k => prefix₁Segs ⟨L + R + k.val, by omega⟩
  let northLastPts : Fin (B + 1) → ThreeSphere := fun i =>
    tailPts ⟨L + R + A + i.val, by omega⟩
  let northLastSegs : (k : Fin B) →
      Path (northLastPts k.castSucc) (northLastPts k.succ) :=
    fun k => tailSegs ⟨L + R + A + k.val, by omega⟩
  have hsplitTail :
      Path.Homotopic (Path.concat tailPts tailSegs)
        ((Path.concat prefix₁Pts prefix₁Segs).trans
          (Path.concat northLastPts northLastSegs)) := by
    change Path.Homotopic (Path.concat tailPts tailSegs)
      ((Path.concat (fun i : Fin (L + R + A + 1) => tailPts ⟨i.val, by omega⟩)
        (fun k : Fin (L + R + A) => tailSegs ⟨k.val, by omega⟩)).trans
        (Path.concat
          (fun i : Fin (B + 1) => tailPts ⟨L + R + A + i.val, by omega⟩)
          (fun k : Fin B => tailSegs ⟨L + R + A + k.val, by omega⟩)))
    exact path_homotopic_concat_split tailPts tailSegs
  have hsplitPrefix₁ :
      Path.Homotopic (Path.concat prefix₁Pts prefix₁Segs)
        ((Path.concat prefix₂Pts prefix₂Segs).trans
          (Path.concat southLastPts southLastSegs)) := by
    change Path.Homotopic (Path.concat prefix₁Pts prefix₁Segs)
      ((Path.concat (fun i : Fin (L + R + 1) => prefix₁Pts ⟨i.val, by omega⟩)
        (fun k : Fin (L + R) => prefix₁Segs ⟨k.val, by omega⟩)).trans
        (Path.concat (fun i : Fin (A + 1) => prefix₁Pts ⟨L + R + i.val, by omega⟩)
          (fun k : Fin A => prefix₁Segs ⟨L + R + k.val, by omega⟩)))
    exact path_homotopic_concat_split prefix₁Pts prefix₁Segs
  have hsplitPrefix₂ :
      Path.Homotopic (Path.concat prefix₂Pts prefix₂Segs)
        ((Path.concat southPts southSegs).trans
          (Path.concat northPts northSegs)) := by
    change Path.Homotopic (Path.concat prefix₂Pts prefix₂Segs)
      ((Path.concat (fun i : Fin (L + 1) => prefix₂Pts ⟨i.val, by omega⟩)
        (fun k : Fin L => prefix₂Segs ⟨k.val, by omega⟩)).trans
        (Path.concat (fun i : Fin (R + 1) => prefix₂Pts ⟨L + i.val, by omega⟩)
          (fun k : Fin R => prefix₂Segs ⟨L + k.val, by omega⟩)))
    exact path_homotopic_concat_split prefix₂Pts prefix₂Segs
  have hsplit :
      Path.Homotopic (Path.concat tailPts tailSegs)
        ((((Path.concat southPts southSegs).trans
          (Path.concat northPts northSegs)).trans
          (Path.concat southLastPts southLastSegs)).trans
          (Path.concat northLastPts northLastSegs)) :=
    (hsplitTail.trans
      (Path.Homotopic.hcomp hsplitPrefix₁ (Path.Homotopic.refl _))).trans
      (Path.Homotopic.hcomp
        (Path.Homotopic.hcomp hsplitPrefix₂ (Path.Homotopic.refl _))
        (Path.Homotopic.refl _))
  have hnorthRange :
      Set.range (Path.concat northPts northSegs) ⊆
        (stereographic' 3 threeSphere_northPole).source := by
    exact threeSphere_stereographic_source_concat_range_subset threeSphere_northPole
      northPts northSegs
      (by simpa [northPts, prefix₂Pts, prefix₁Pts] using hNorthBase)
      (by
        intro k
        simpa [northSegs, prefix₂Segs, prefix₁Segs] using hNorth k)
  have hsouthLastRange :
      Set.range (Path.concat southLastPts southLastSegs) ⊆
        (stereographic' 3 (-threeSphere_northPole)).source := by
    exact threeSphere_stereographic_source_concat_range_subset (-threeSphere_northPole)
      southLastPts southLastSegs
      (by simpa [southLastPts, prefix₁Pts] using hSouthLastBase)
      (by
        intro k
        simpa [southLastSegs, prefix₁Segs] using hSouthLast k)
  have hnorthLastRange :
      Set.range (Path.concat northLastPts northLastSegs) ⊆
        (stereographic' 3 threeSphere_northPole).source := by
    exact threeSphere_stereographic_source_concat_range_subset threeSphere_northPole
      northLastPts northLastSegs
      (by simpa [northLastPts] using hNorthLastBase)
      (by
        intro k
        simpa [northLastSegs] using hNorthLast k)
  have hcloseNorthLast : northLastPts (Fin.last B) = x₀ := by
    simpa [northLastPts] using hclose
  have hcontract :
      Path.Homotopic
        ((((p.trans (Path.concat southPts southSegs)).trans
          (Path.concat northPts northSegs)).trans
          (Path.concat southLastPts southLastSegs)).trans
          (Path.concat northLastPts northLastSegs))
        ((Path.refl x₀).cast rfl hcloseNorthLast) := by
    exact threeSphere_stereographic_northSouthBlockNorthSouthBlockNorth_trans_cast_nullhomotopic
      southPts p southSegs (Path.concat northPts northSegs)
      southLastPts southLastSegs northLastPts northLastSegs rfl rfl hcloseNorthLast
      (by simpa [southPts, prefix₂Pts, prefix₁Pts] using hp)
      (by simpa [southPts, prefix₂Pts, prefix₁Pts] using hSouthBase)
      (by
        intro k
        simpa [southSegs, prefix₂Segs, prefix₁Segs] using hSouth k)
      hnorthRange
      (by simpa [southLastPts, prefix₁Pts] using hSouthLastBase)
      (by
        intro k
        simpa [southLastSegs, prefix₁Segs] using hSouthLast k)
      (by simpa [northLastPts] using hNorthLastBase)
      (by
        intro k
        simpa [northLastSegs] using hNorthLast k)
  have htargetEq :
      ((Path.refl x₀).cast rfl hcloseNorthLast) =
        ((Path.refl x₀).cast rfl hclose) := by
    apply Path.ext
    funext _s
    change x₀ = x₀
    rfl
  let S : Path (tailPts 0) (tailPts ⟨L, by omega⟩) := Path.concat southPts southSegs
  let N : Path (tailPts ⟨L, by omega⟩) (tailPts ⟨L + R, by omega⟩) :=
    Path.concat northPts northSegs
  let S₂ : Path (tailPts ⟨L + R, by omega⟩) (tailPts ⟨L + R + A, by omega⟩) :=
    Path.concat southLastPts southLastSegs
  let N₂ : Path (tailPts ⟨L + R + A, by omega⟩) (tailPts (Fin.last (L + R + A + B))) :=
    Path.concat northLastPts northLastSegs
  have hassoc :
      Path.Homotopic (p.trans (((S.trans N).trans S₂).trans N₂))
        ((((p.trans S).trans N).trans S₂).trans N₂) := by
    exact (Path.Homotopic.trans_assoc p ((S.trans N).trans S₂) N₂).symm.trans
      (Path.Homotopic.hcomp
        ((Path.Homotopic.trans_assoc p (S.trans N) S₂).symm.trans
          (Path.Homotopic.hcomp
            (Path.Homotopic.trans_assoc p S N).symm
            (Path.Homotopic.refl S₂)))
        (Path.Homotopic.refl N₂))
  refine (Path.Homotopic.hcomp (Path.Homotopic.refl p) hsplit).trans ?_
  change Path.Homotopic (p.trans (((S.trans N).trans S₂).trans N₂))
    ((Path.refl x₀).cast rfl hclose)
  exact hassoc.trans (hcontract.trans (htargetEq ▸ Path.Homotopic.refl _))

