        (Path.concat (γ ∘ t) (fun k => γ.subpath (t k.castSucc) (t k.succ))) =
        Path.Homotopic.Quotient.mk
          ((Path.refl threeSphere_equatorPoint).cast
            (by simp [h0]) (by simp [h1]))

