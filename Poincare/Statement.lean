    hp ⟨1, p.target⟩
  have hPref : ∀ k : Fin A,
      Set.range (tailSegs ⟨k.val, by omega⟩) ⊆ U := by
    intro k
    simpa [A] using hBefore ⟨k.val, by omega⟩ k.isLt
  have hOppBase : tailPts ⟨A, by omega⟩ ∈ V := by
    have hStart := hrun start (by omega) hstartstop
