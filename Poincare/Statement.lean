        rw [threeSphere_stereographic_source_eq_compl_singleton]
        intro h
        have hcoord := congrArg
          (fun w : EuclideanSpace ℝ (Fin 4) => w 0)
          (congrArg Subtype.val h)
        norm_num [threeSphere_northPole] at hcoord) := by
  apply Subsingleton.elim

