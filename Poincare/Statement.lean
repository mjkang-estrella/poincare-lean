      Path.Homotopic (p.trans ((((((S.trans N).trans S₂).trans N₂).trans S₃).trans N₃).trans S₄))
        (((((((p.trans S).trans N).trans S₂).trans N₂).trans S₃).trans N₃).trans S₄) := by
    exact (Path.Homotopic.trans_assoc p (((((S.trans N).trans S₂).trans N₂).trans S₃).trans N₃) S₄).symm.trans
      (Path.Homotopic.hcomp
        ((Path.Homotopic.trans_assoc p ((((S.trans N).trans S₂).trans N₂).trans S₃) N₃).symm.trans
