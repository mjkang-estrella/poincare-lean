theorem threeSphere_stereographic_southNorthBlockSouthBlockNorthBlockSouthBlockNorthBlockSouthBlockNorthBlockTail_concat_cast_nullhomotopic
    {L R A B C D E₀ : ℕ} {x₀ : ThreeSphere}
    (tailPts : Fin (L + R + A + B + C + D + E₀ + 1) → ThreeSphere)
    (tailSegs : (k : Fin (L + R + A + B + C + D + E₀)) →
