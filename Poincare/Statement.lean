    change γ (v 0) = γ (u (Fin.last (N + 1)))
    rw [hjoin]
  have hclose : q (Fin.last (M + 1)) = p 0 := by
    change γ (v (Fin.last (M + 1))) = γ (u 0)
    rw [h1, h0]
    exact γ.target.trans γ.source.symm
