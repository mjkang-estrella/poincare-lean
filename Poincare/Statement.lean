theorem twoSetOpenCover_sameHead_prefixOppositeRunSameReturn_flat_tail_induction_step_homotopy_refl_forall_mem_of_mapsTo
    {Y : Type u} [TopologicalSpace Y] {U V : Set Y} {A B C : ℕ} {x₀ : Y}
