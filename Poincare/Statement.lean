  have hbase :
      (γ ∘ t) 0 ∈ (stereographic' 3 threeSphere_northPole).source := by
    simpa [Function.comp_def, h0, γ.source] using
      threeSphere_equatorPoint_mem_northPole_stereographic_source
  have hconcat :
      Set.range
