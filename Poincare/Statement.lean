  have hcloseNorthLast : northLastPts (Fin.last B) = x₀ := by
    simpa [northLastPts] using hclose
  have hcontract :
      Path.Homotopic
        ((((p.trans (Path.concat southPts southSegs)).trans
          (Path.concat northPts northSegs)).trans
          (Path.concat southLastPts southLastSegs)).trans
          (Path.concat northLastPts northLastSegs))
        ((Path.refl x₀).cast rfl hcloseNorthLast) := by
    exact threeSphere_stereographic_northSouthBlockNorthSouthBlockNorth_trans_cast_nullhomotopic
      southPts p southSegs (Path.concat northPts northSegs)
      southLastPts southLastSegs northLastPts northLastSegs rfl rfl hcloseNorthLast
      (by simpa [southPts, prefix₂Pts, prefix₁Pts] using hp)
      (by simpa [southPts, prefix₂Pts, prefix₁Pts] using hSouthBase)
      (by
        intro k
