          (fun i : Fin (C + 1) => tailPts ⟨L + R + A + B + i.val, by omega⟩)
          (fun k : Fin C => tailSegs ⟨L + R + A + B + k.val, by omega⟩)))
    exact path_homotopic_concat_split tailPts tailSegs
  have hsplitPrefix₁ :
      Path.Homotopic (Path.concat prefix₁Pts prefix₁Segs)
