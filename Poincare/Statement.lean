        have hmem :
            ((p : ThreeSphere) ∈ (stereographic' 3 (-threeSphere_northPole)).source) ↔
              (p : ThreeSphere) ≠ -threeSphere_northPole := by
          rw [threeSphere_stereographic_source_eq_compl_singleton]
