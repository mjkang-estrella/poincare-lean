    (p : Path x₀ (tailPts 0))
    (hclose : tailPts (Fin.last (L + R)) = x₀)
    (hp : Set.range p ⊆ U)
    (hVBase : tailPts 0 ∈ V)
    (hV : ∀ k : Fin L, Set.range (tailSegs ⟨k.val, by omega⟩) ⊆ V)
    (hUBase : tailPts ⟨L, by omega⟩ ∈ U)
