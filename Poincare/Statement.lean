  have hprefPath :
      Set.range prefPath ⊆ (stereographic' 3 (-threeSphere_northPole)).source := by
    intro z hz
    have hz' :
        z ∈ Set.range p ∪ Set.range (Path.concat southPts southSegs) := by
      simpa [prefPath, Path.trans_range] using hz
    rcases hz' with hzP | hzS
    · exact hp hzP
