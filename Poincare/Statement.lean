    threeSphere_euclidean_rank_gt_one =
      (by
        rw [(EuclideanSpace.equiv (Fin 4) ℝ).toLinearEquiv.rank_eq]
        rw [rank_fin_fun]
        norm_num) := by
  apply Subsingleton.elim

