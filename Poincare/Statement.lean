-/
theorem threeSphere_stereographic_northSouthBlockNorthBlockSouthBlockNorthBlockSouthBlockNorthBlockSouthBlockTail_concat_cast_nullhomotopic
    {L R A B C D E₀ : ℕ} {x₀ : ThreeSphere}
    (tailPts : Fin (L + R + A + B + C + D + E₀ + 1) → ThreeSphere)
    (tailSegs : (k : Fin (L + R + A + B + C + D + E₀)) →
      Path (tailPts k.castSucc) (tailPts k.succ))
    (p : Path x₀ (tailPts 0))
    (hclose : tailPts (Fin.last (L + R + A + B + C + D + E₀)) = x₀)
